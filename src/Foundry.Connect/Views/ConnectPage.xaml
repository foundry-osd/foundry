<UserControl x:Class="Foundry.Connect.Views.ConnectPage" x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Foundry.Wpf.Controls;assembly=Foundry.Wpf">
    <!--
        One XAML tree in three arrangements, switched by setters only:
        - two columns: PageRoot at least 1100 x 700 and a two-column session (UsesTwoColumns); no page scroll, the left
        column scrolls on its own and the Wi-Fi list fills the right column;
        - one column wide: same size, one-column session; 980 px, the page scrolls when needed;
        - narrow: below 1100 x 700; one column, 980 px, page scroll, the banner buttons under the text.
        Document order is the Tab order (banner, Ethernet, provisioned Wi-Fi, Wi-Fi card), so no TabIndex is set.
    -->
    <ScrollViewer x:Name="PageScrollViewer"
        HorizontalContentAlignment="Stretch"
        Focusable="False"
        HorizontalScrollBarVisibility="Disabled">
        <ScrollViewer.Style>
            <Style
                BasedOn="{StaticResource ScrollViewerContentGutterStyle}"
                TargetType="ScrollViewer">
                <Setter
                    Property="VerticalScrollBarVisibility"
                    Value="Auto" />
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition
                                Binding="{Binding ActualWidth, ElementName=PageRoot, Converter={StaticResource WidthAtLeastConverter}, ConverterParameter=1100}"
                                Value="True" />
                            <Condition
                                Binding="{Binding ActualHeight, ElementName=PageRoot, Converter={StaticResource WidthAtLeastConverter}, ConverterParameter=700}"
                                Value="True" />
                            <Condition
                                Binding="{Binding DataContext.UsesTwoColumns, ElementName=PageRoot}"
                                Value="True" />
                        </MultiDataTrigger.Conditions>
                        <!--  Disabled gives the content the viewport height, so the star rows below can fill it.  -->
                        <Setter
                            Property="VerticalScrollBarVisibility"
                            Value="Disabled" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </ScrollViewer.Style>

        <!--  Page area: a copy of Deploy's MainContentHost.  -->
        <Grid x:Name="PageHost"
            Margin="16">
            <Grid x:Name="PageArea"
                Width="{Binding ActualWidth, ElementName=PageHost}"
                HorizontalAlignment="Center">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter
                            Property="MaxWidth"
                            Value="980" />
                        <Setter
                            Property="VerticalAlignment"
                            Value="Top" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition
                                        Binding="{Binding ActualWidth, ElementName=PageRoot, Converter={StaticResource WidthAtLeastConverter}, ConverterParameter=1100}"
                                        Value="True" />
                                    <Condition
                                        Binding="{Binding ActualHeight, ElementName=PageRoot, Converter={StaticResource WidthAtLeastConverter}, ConverterParameter=700}"
                                        Value="True" />
                                    <Condition
                                        Binding="{Binding DataContext.UsesTwoColumns, ElementName=PageRoot}"
                                        Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter
                                    Property="MaxWidth"
                                    Value="1440" />
                                <Setter
                                    Property="Height"
                                    Value="{Binding ActualHeight, ElementName=PageHost}" />
                                <Setter
                                    Property="MaxHeight"
                                    Value="900" />
                                <Setter
                                    Property="VerticalAlignment"
                                    Value="Center" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  1. Status banner  -->
                <Border
                    Margin="0"
                    Style="{StaticResource ConnectBannerBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  The shared ring and glyph are drawn at 180 px; the banner shows them at 40 px.  -->
                        <Viewbox
                            Grid.RowSpan="2"
                            Width="40"
                            Height="40"
                            VerticalAlignment="Top">
                            <Grid
                                Width="180"
                                Height="180">
                                <controls:CustomProgressRing
                                    AutomationProperties.Name="{Binding HeroTitle}"
                                    IsIndeterminate="{Binding IsHeroBusy}"
                                    ProgressBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                    Thickness="14"
                                    TrackBrush="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                    Visibility="{Binding IsHeroBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <controls:TerminalStatusGlyph
                                    AutomationName="{Binding HeroTitle}"
                                    IsSuccess="{Binding IsHeroSuccess}"
                                    Visibility="{Binding IsHeroTerminal, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </Viewbox>

                        <WrapPanel
                            Grid.Column="2"
                            VerticalAlignment="Center">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{Binding HeroTitle}"
                                TextWrapping="Wrap" />
                            <Border
                                Margin="12,0,0,0"
                                Style="{StaticResource ConnectPillBorderStyle}"
                                Visibility="{Binding HasConnectionChip, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock
                                    Style="{StaticResource ConnectPillTextBlockStyle}"
                                    Text="{Binding ConnectionChipText}" />
                            </Border>
                        </WrapPanel>

                        <!--  The description and the countdown caption never show together (no description while online).  -->
                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="2"
                            Margin="0,4,0,0">
                            <TextBlock
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{Binding HeroDescription}"
                                TextWrapping="Wrap"
                                Visibility="{Binding HasHeroDescription, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock
                                DataContext="{Binding AutoContinue}"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{Binding CaptionText}"
                                TextWrapping="Wrap"
                                Visibility="{Binding HasCaption, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>

                        <WrapPanel x:Name="BannerActions">
                            <WrapPanel.Style>
                                <Style TargetType="WrapPanel">
                                    <Setter
                                        Property="Grid.Row"
                                        Value="2" />
                                    <Setter
                                        Property="Grid.RowSpan"
                                        Value="1" />
                                    <Setter
                                        Property="Grid.Column"
                                        Value="2" />
                                    <Setter
                                        Property="Margin"
                                        Value="0,12,0,0" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition
                                                    Binding="{Binding ActualWidth, ElementName=PageRoot, Converter={StaticResource WidthAtLeastConverter}, ConverterParameter=1100}"
                                                    Value="True" />
                                                <Condition
                                                    Binding="{Binding ActualHeight, ElementName=PageRoot, Converter={StaticResource WidthAtLeastConverter}, ConverterParameter=700}"
                                                    Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter
                                                Property="Grid.Row"
                                                Value="0" />
                                            <Setter
                                                Property="Grid.RowSpan"
                                                Value="2" />
                                            <Setter
                                                Property="Grid.Column"
                                                Value="3" />
                                            <Setter
                                                Property="VerticalAlignment"
                                                Value="Center" />
                                            <Setter
                                                Property="Margin"
                                                Value="16,0,0,0" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </WrapPanel.Style>
                            <Button x:Name="ContinueButton"
                                AutomationProperties.Name="{Binding Strings[Action.Continue]}"
                                Command="{Binding AutoContinue.ContinueCommand}"
                                Content="{Binding Strings[Action.Continue]}"
                                IsDefault="{Binding AutoContinue.IsContinueDefault}"
                                Style="{StaticResource ConnectAccentActionButtonStyle}"
                                Visibility="{Binding AutoContinue.CanContinue, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button
                                AutomationProperties.Name="{Binding Strings[Action.StayHere]}"
                                Command="{Binding AutoContinue.StayHereCommand}"
                                Content="{Binding Strings[Action.StayHere]}"
                                Style="{StaticResource ConnectActionButtonStyle}"
                                Visibility="{Binding AutoContinue.IsCounting, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button x:Name="RetryButton"
                                AutomationProperties.Name="{Binding Strings[Action.Retry]}"
                                Command="{Binding RefreshCommand}"
                                Content="{Binding Strings[Action.Retry]}"
                                Style="{StaticResource ConnectAccentActionButtonStyle}"
                                Visibility="{Binding ShowRetryActions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button
                                AutomationProperties.Name="{Binding Strings[Diagnostics.ExportMenu]}"
                                Command="{Binding Diagnostics.ExportDiagnosticsCommand}"
                                Content="{Binding Strings[Diagnostics.ExportMenu]}"
                                Style="{StaticResource ConnectActionButtonStyle}"
                                Visibility="{Binding ShowRetryActions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <!--  2. Sections: the columns copy TargetStepView (* / 24 / *).  -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Left column: Ethernet line, Ethernet card, provisioned Wi-Fi card.  -->
                    <ScrollViewer x:Name="LeftColumnScroller"
                        Focusable="False"
                        HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style
                                BasedOn="{StaticResource ScrollViewerContentGutterStyle}"
                                TargetType="ScrollViewer">
                                <Setter
                                    Property="VerticalScrollBarVisibility"
                                    Value="Disabled" />
                                <Setter
                                    Property="Grid.ColumnSpan"
                                    Value="3" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition
                                                Binding="{Binding ActualWidth, ElementName=PageRoot, Converter={StaticResource WidthAtLeastConverter}, ConverterParameter=1100}"
                                                Value="True" />
                                            <Condition
                                                Binding="{Binding ActualHeight, ElementName=PageRoot, Converter={StaticResource WidthAtLeastConverter}, ConverterParameter=700}"
                                                Value="True" />
                                            <Condition
                                                Binding="{Binding DataContext.UsesTwoColumns, ElementName=PageRoot}"
                                                Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter
                                            Property="VerticalScrollBarVisibility"
                                            Value="Auto" />
                                        <Setter
                                            Property="Grid.ColumnSpan"
                                            Value="1" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel x:Name="LeftColumn"
                            VerticalAlignment="Top">

                            <!--  2a. Ethernet: the neutral line without adapter, else the card  -->
                            <Grid
                                Margin="0,0,0,16"
                                DataContext="{Binding Ethernet}"
                                Visibility="{Binding ShowNoAdapterNotice, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Style="{StaticResource ConnectSeverityGlyphTextBlockStyle}"
                                    Tag="{x:Static controls:InfoBarSeverity.Informational}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource ConnectNoticeTextBlockStyle}"
                                    Text="{Binding NoAdapterText}" />
                            </Grid>
                            <Border x:Name="EthernetCard"
                                DataContext="{Binding Ethernet}"
                                Style="{StaticResource SectionCardBorderStyle}"
                                Visibility="{Binding ShowCard, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Expander x:Name="EthernetExpander"
                                    HorizontalContentAlignment="Stretch"
                                    AutomationProperties.Name="{Binding Strings[Ethernet.Title]}"
                                    IsExpanded="{Binding IsDetailsExpanded, Mode=TwoWay}">
                                    <Expander.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Margin="0,0,12,0"
                                                VerticalAlignment="Top"
                                                Style="{StaticResource ConnectGlyphTextBlockStyle}"
                                                Text="{Binding Glyph}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock
                                                    Style="{StaticResource ConnectSectionTitleTextBlockStyle}"
                                                    Text="{Binding Strings[Ethernet.Title]}" />
                                                <TextBlock
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding SecondaryStatusText}"
                                                    TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style
                                                            BasedOn="{StaticResource CaptionTextBlockStyle}"
                                                            TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger
                                                                    Binding="{Binding SecondaryStatusText}"
                                                                    Value="">
                                                                    <Setter
                                                                        Property="Visibility"
                                                                        Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!--  802.1X row: label, a small ring while authenticating or the severity glyph, then the status  -->
                                                <Grid
                                                    Margin="0,8,0,0"
                                                    Visibility="{Binding HasDot1x, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Margin="0,0,8,0"
                                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                                        Text="{Binding Strings[Ethernet.Dot1xLabel]}" />
                                                    <Viewbox
                                                        Grid.Column="1"
                                                        Width="16"
                                                        Height="16"
                                                        Margin="0,2,8,0"
                                                        VerticalAlignment="Top"
                                                        Visibility="{Binding IsDot1xAuthenticating, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <controls:CustomProgressRing
                                                            Width="120"
                                                            Height="120"
                                                            AutomationProperties.Name="{Binding Dot1xStatusText}"
                                                            IsIndeterminate="True"
                                                            ProgressBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                                            Thickness="16"
                                                            TrackBrush="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                                                    </Viewbox>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Tag="{Binding Dot1xSeverity}">
                                                        <TextBlock.Style>
                                                            <Style
                                                                BasedOn="{StaticResource ConnectSeverityGlyphTextBlockStyle}"
                                                                TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger
                                                                        Binding="{Binding IsDot1xAuthenticating}"
                                                                        Value="True">
                                                                        <Setter
                                                                            Property="Visibility"
                                                                            Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Style="{StaticResource BodyTextBlockStyle}"
                                                        Text="{Binding Dot1xStatusText}"
                                                        TextWrapping="Wrap" />
                                                </Grid>
                                                <TextBlock
                                                    Margin="0,4,0,0"
                                                    Style="{StaticResource ConnectNoticeTextBlockStyle}"
                                                    Text="{Binding Dot1xReasonText}"
                                                    Visibility="{Binding HasDot1xReason, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>
                                            <Border
                                                Grid.Column="2"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Top"
                                                Style="{StaticResource ConnectPillBorderStyle}">
                                                <TextBlock
                                                    Style="{StaticResource ConnectPillTextBlockStyle}"
                                                    Text="{Binding StatusText}" />
                                            </Border>
                                        </Grid>
                                    </Expander.Header>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Style="{StaticResource ConnectFieldLabelTextBlockStyle}"
                                            Text="{Binding Strings[Ethernet.AdapterLabel]}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{Binding AdapterName}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Style="{StaticResource ConnectFieldLabelTextBlockStyle}"
                                            Text="{Binding Strings[Ethernet.Ipv4Label]}" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{Binding IpAddress}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Grid.Row="2"
                                            Style="{StaticResource ConnectFieldLabelTextBlockStyle}"
                                            Text="{Binding Strings[Ethernet.GatewayLabel]}" />
                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{Binding Gateway}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            Margin="0,4,0,0"
                                            Text="{Binding ConfigurationText}">
                                            <TextBlock.Style>
                                                <Style
                                                    BasedOn="{StaticResource ConnectNoticeTextBlockStyle}"
                                                    TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding ConfigurationText}"
                                                            Value="">
                                                            <Setter
                                                                Property="Visibility"
                                                                Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Expander>
                            </Border>

                            <!--  2b. Provisioned Wi-Fi card: one message and one action button  -->
                            <Border x:Name="ProvisionedCard"
                                DataContext="{Binding ProvisionedWifi}"
                                Style="{StaticResource SectionCardBorderStyle}"
                                Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Margin="0,0,12,0"
                                            Style="{StaticResource ConnectGlyphTextBlockStyle}"
                                            Text="&#xF081;" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource ConnectSectionTitleTextBlockStyle}"
                                            Text="{Binding Strings[Wifi.ProvisionedTitle]}" />
                                        <Border
                                            Grid.Column="2"
                                            Margin="12,0,0,0"
                                            Style="{StaticResource ConnectPillBorderStyle}">
                                            <TextBlock
                                                Style="{StaticResource ConnectPillTextBlockStyle}"
                                                Text="{Binding StatusText}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        TextWrapping="Wrap">
                                        <Run Text="{Binding DisplayName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SecurityText, Mode=OneWay}" />
                                    </TextBlock>
                                    <Grid
                                        Margin="0,12,0,0"
                                        Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Style="{StaticResource ConnectSeverityGlyphTextBlockStyle}"
                                            Tag="{Binding MessageSeverity}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource ConnectNoticeTextBlockStyle}"
                                            Text="{Binding MessageText}" />
                                    </Grid>
                                    <Button x:Name="ProvisionedActionButton"
                                        Margin="0,12,0,0"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.Name="{Binding PrimaryActionAutomationName}"
                                        Command="{Binding PrimaryActionCommand}"
                                        Content="{Binding PrimaryActionText}"
                                        Style="{StaticResource ConnectAccentActionButtonStyle}"
                                        Visibility="{Binding ShowPrimaryAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!--  Right column (or under the left one): the Wi-Fi card. The left column's cards carry the 16 px gap.  -->
                    <Border x:Name="WifiCard"
                        DataContext="{Binding WifiNetworks}"
                        Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border.Style>
                            <Style
                                BasedOn="{StaticResource SectionCardBorderStyle}"
                                TargetType="Border">
                                <Setter
                                    Property="VerticalAlignment"
                                    Value="Top" />
                                <Setter
                                    Property="Margin"
                                    Value="0" />
                                <Setter
                                    Property="Grid.Row"
                                    Value="1" />
                                <Setter
                                    Property="Grid.Column"
                                    Value="0" />
                                <Setter
                                    Property="Grid.ColumnSpan"
                                    Value="3" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition
                                                Binding="{Binding ActualWidth, ElementName=PageRoot, Converter={StaticResource WidthAtLeastConverter}, ConverterParameter=1100}"
                                                Value="True" />
                                            <Condition
                                                Binding="{Binding ActualHeight, ElementName=PageRoot, Converter={StaticResource WidthAtLeastConverter}, ConverterParameter=700}"
                                                Value="True" />
                                            <Condition
                                                Binding="{Binding DataContext.UsesTwoColumns, ElementName=PageRoot}"
                                                Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter
                                            Property="Grid.Row"
                                            Value="0" />
                                        <Setter
                                            Property="Grid.Column"
                                            Value="2" />
                                        <Setter
                                            Property="Grid.ColumnSpan"
                                            Value="1" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Margin="0,0,12,0"
                                    Style="{StaticResource ConnectGlyphTextBlockStyle}"
                                    Text="&#xE701;" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ConnectSectionTitleTextBlockStyle}"
                                    Text="{Binding Strings[Wifi.Title]}" />
                                <Button x:Name="WifiRefreshButton"
                                    Grid.Column="2"
                                    MinWidth="40"
                                    Padding="10,0"
                                    VerticalAlignment="Stretch"
                                    AutomationProperties.Name="{Binding Strings[Wifi.RefreshNetworks]}"
                                    Command="{Binding RefreshCommand}"
                                    ToolTip="{Binding Strings[Wifi.RefreshNetworks]}">
                                    <TextBlock
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        FontSize="14"
                                        Text="&#xE72C;" />
                                </Button>
                            </Grid>

                            <!--  One of three: the neutral "not available" text, the empty text or the list.  -->
                            <Grid
                                Grid.Row="1"
                                Visibility="{Binding HasUnavailableMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Style="{StaticResource ConnectSeverityGlyphTextBlockStyle}"
                                    Tag="{x:Static controls:InfoBarSeverity.Informational}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource ConnectNoticeTextBlockStyle}"
                                    Text="{Binding UnavailableMessageText}" />
                            </Grid>
                            <TextBlock
                                Grid.Row="1"
                                Style="{StaticResource ConnectNoticeTextBlockStyle}"
                                Text="{Binding EmptyText}"
                                Visibility="{Binding ShowEmptyText, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <!--  Tab enters and leaves the list as one stop; the arrows move the selection only.  -->
                            <ListBox x:Name="WifiNetworksList"
                                Grid.Row="1"
                                VerticalAlignment="Top"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="{Binding Strings[Wifi.NetworksListAutomationName]}"
                                ItemContainerStyle="{StaticResource ConnectDenseListBoxItemStyle}"
                                ItemsSource="{Binding Networks}"
                                KeyboardNavigation.TabNavigation="Once"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                SelectedItem="{Binding SelectedNetwork, Mode=TwoWay}"
                                SelectionMode="Single"
                                Visibility="{Binding ShowNetworkList, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ListBox.Style>
                                    <Style
                                        BasedOn="{StaticResource {x:Type ListBox}}"
                                        TargetType="ListBox">
                                        <Setter
                                            Property="MaxHeight"
                                            Value="280" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition
                                                        Binding="{Binding ActualWidth, ElementName=PageRoot, Converter={StaticResource WidthAtLeastConverter}, ConverterParameter=1100}"
                                                        Value="True" />
                                                    <Condition
                                                        Binding="{Binding ActualHeight, ElementName=PageRoot, Converter={StaticResource WidthAtLeastConverter}, ConverterParameter=700}"
                                                        Value="True" />
                                                    <Condition
                                                        Binding="{Binding DataContext.UsesTwoColumns, ElementName=PageRoot}"
                                                        Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter
                                                    Property="MaxHeight"
                                                    Value="Infinity" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid x:Name="NetworkRow">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Margin="0,0,12,0"
                                                Style="{StaticResource ConnectGlyphTextBlockStyle}"
                                                Text="{Binding SignalGlyph}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="{Binding DisplayName}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap"
                                                ToolTip="{Binding DisplayName}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{Binding SecurityText}" />
                                            <TextBlock
                                                Grid.Column="3"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{Binding DataContext.Strings[Common.Connected], ElementName=WifiNetworksList}"
                                                Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsInRange}"
                                                Value="False">
                                                <Setter
                                                    TargetName="NetworkRow"
                                                    Property="Opacity"
                                                    Value="0.6" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!--  The panel under the list: name, password, one action button, one message.  -->
                            <StackPanel x:Name="WifiDetailsPanel"
                                Grid.Row="2"
                                Margin="0,12,0,0"
                                Visibility="{Binding ShowDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Separator Margin="0,0,0,12" />
                                <TextBlock
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    TextWrapping="Wrap">
                                    <Run
                                        FontWeight="SemiBold"
                                        Text="{Binding SelectedNetwork.DisplayName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SelectedNetwork.SecurityText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,12,0,4"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{Binding Strings[Wifi.PassphraseLabel]}"
                                    Visibility="{Binding ShowPassphrase, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <controls:PassphraseEditor x:Name="PassphraseInput"
                                    Margin="0,4,0,8"
                                    AccessibleName="{Binding Strings[Wifi.PassphraseLabel]}"
                                    MaxLength="64"
                                    RevealButtonText="{Binding Strings[Wifi.TogglePassphraseVisibility]}"
                                    SubmitCommand="{Binding ConnectCommand}"
                                    Visibility="{Binding ShowPassphrase, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <StackPanel
                                    Margin="0,8,0,0"
                                    Orientation="Horizontal">
                                    <Button x:Name="WifiActionButton"
                                        AutomationProperties.Name="{Binding PrimaryActionAutomationName}"
                                        Command="{Binding PrimaryActionCommand}"
                                        Content="{Binding PrimaryActionText}"
                                        Style="{StaticResource ConnectAccentActionButtonStyle}"
                                        Visibility="{Binding ShowPrimaryAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Viewbox
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsConnecting, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <controls:CustomProgressRing
                                            Width="120"
                                            Height="120"
                                            AutomationProperties.Name="{Binding Strings[Status.ConnectingTitle]}"
                                            IsIndeterminate="True"
                                            ProgressBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                            Thickness="16"
                                            TrackBrush="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                                    </Viewbox>
                                </StackPanel>
                                <Grid
                                    Margin="0,4,0,0"
                                    Visibility="{Binding HasDetailMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Style="{StaticResource ConnectSeverityGlyphTextBlockStyle}"
                                        Tag="{Binding DetailMessageSeverity}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource ConnectNoticeTextBlockStyle}"
                                        Text="{Binding DetailMessageText}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
