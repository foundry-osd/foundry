<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Foundry.Connect.Views"
             xmlns:vm="using:Foundry.Connect.ViewModels"
             x:Class="Foundry.Connect.Views.DiscoveredWifiList"
             x:DataType="vm:MainWindowViewModel"
             x:Name="Root">
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="16">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <TextBlock Name="WifiListHeading"
                 AttachedToVisualTree="OnHeadingAttached"
                 Focusable="True"
                 FontSize="18"
                 FontWeight="SemiBold"
                 Text="{Binding Strings[Wifi.Title]}" />
      <Button Grid.Column="1"
              MinWidth="44"
              AutomationProperties.Name="{Binding Strings[Wifi.RefreshNetworks]}"
              Command="{Binding RefreshStatusCommand}"
              Content="↻"
              ToolTip.Tip="{Binding Strings[Wifi.RefreshNetworks]}" />
    </Grid>

    <Border Grid.Row="1"
            Height="1"
            Background="{DynamicResource FoundryBrush.Divider}" />

    <Grid Grid.Row="2">
      <TextBlock Name="WifiEmptyState"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource FoundryBrush.TextSecondary}"
                 IsVisible="{Binding !HasWifiNetworks}"
                 Text="{Binding WifiDiscoveryEmptyStateText}"
                 TextAlignment="Center"
                 TextWrapping="Wrap" />

      <ListBox Name="WifiNetworksList"
               MinHeight="220"
               IsVisible="{Binding HasWifiNetworks}"
               ItemsSource="{Binding WifiNetworks}"
               SelectedItem="{Binding SelectedWifiNetwork, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:MainWindowViewModel+WifiNetworkItemViewModel">
            <views:DiscoveredWifiRow Network="{Binding}"
                                      ViewModel="{Binding $parent[views:DiscoveredWifiList].ViewModel}"
                                      IsSelected="{Binding $parent[ListBoxItem].IsSelected}"
                                      MotionMode="{Binding $parent[views:DiscoveredWifiList].ViewModel.MotionMode}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Grid>
</UserControl>
