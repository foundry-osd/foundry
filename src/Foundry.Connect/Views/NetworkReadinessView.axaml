<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Foundry.Connect.Views"
             xmlns:vm="using:Foundry.Connect.ViewModels"
             x:Class="Foundry.Connect.Views.NetworkReadinessView"
             x:DataType="vm:MainWindowViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <Grid MaxWidth="1200"
          HorizontalAlignment="Center"
          RowDefinitions="Auto,Auto"
          RowSpacing="40">
      <views:ReadinessStatusView />
      <Grid Grid.Row="1">
        <views:EthernetStatusPanel IsVisible="{Binding !ShowWifiContent}" />
        <Grid ColumnDefinitions="*,*"
              ColumnSpacing="48"
              IsVisible="{Binding ShowWifiContent}">
          <StackPanel Spacing="40">
            <views:EthernetStatusPanel />
            <views:ProvisionedWifiPanel />
          </StackPanel>
          <views:DiscoveredWifiList Grid.Column="1" />
        </Grid>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
