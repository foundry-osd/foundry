  <data name="About.DescriptionLine1" xml:space="preserve">
    <value>Foundry Connect ellenőrzi a hálózati készenlétet WinPE mezőben, mielőtt az Foundry telepítés folytatódna.</value>
  </data>
  <data name="About.DescriptionLine2" xml:space="preserve">
    <value>Ezt a szoftvert úgy szállítjuk, ahogy van. A telepítés folytatása előtt erősítse meg a hálózati hozzáférést.</value>
  </data>
