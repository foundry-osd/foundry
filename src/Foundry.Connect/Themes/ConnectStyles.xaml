<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Foundry.Wpf.Controls;assembly=Foundry.Wpf">
    <Style x:Key="ConnectBannerBorderStyle"
        BasedOn="{StaticResource SectionCardBorderStyle}"
        TargetType="Border">
        <Setter
            Property="Padding"
            Value="16" />
        <Setter
            Property="MinHeight"
            Value="80" />
    </Style>

    <Style x:Key="ConnectPillBorderStyle"
        TargetType="Border">
        <Setter
            Property="CornerRadius"
            Value="10" />
        <Setter
            Property="Padding"
            Value="8,2" />
        <Setter
            Property="BorderThickness"
            Value="1" />
        <Setter
            Property="BorderBrush"
            Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter
            Property="VerticalAlignment"
            Value="Center" />
    </Style>

    <Style x:Key="ConnectPillTextBlockStyle"
        BasedOn="{StaticResource CaptionTextBlockStyle}"
        TargetType="TextBlock">
        <Setter
            Property="TextWrapping"
            Value="NoWrap" />
    </Style>

    <!--
        Severity glyph drawn like Foundry.Wpf InfoBar: a filled circle in the severity brush with the mark on top in the
        on-accent text brush. Use it on a ContentControl and bind the InfoBarSeverity to Tag.
    -->
    <Style x:Key="ConnectSeverityGlyphStyle"
        TargetType="ContentControl">
        <Setter
            Property="Focusable"
            Value="False" />
        <Setter
            Property="IsTabStop"
            Value="False" />
        <Setter
            Property="Margin"
            Value="0,2,8,0" />
        <Setter
            Property="VerticalAlignment"
            Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <TextBlock x:Name="Disc"
                            FontFamily="{DynamicResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Foreground="{DynamicResource SystemFillColorAttentionBrush}"
                            Text="&#xF136;" />
                        <TextBlock x:Name="Mark"
                            FontFamily="{DynamicResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                            Text="&#xF13F;" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger
                            Property="Tag"
                            Value="{x:Static controls:InfoBarSeverity.Success}">
                            <Setter
                                TargetName="Disc"
                                Property="Foreground"
                                Value="{DynamicResource SystemFillColorSuccessBrush}" />
                            <Setter
                                TargetName="Mark"
                                Property="Text"
                                Value="&#xF13E;" />
                        </Trigger>
                        <Trigger
                            Property="Tag"
                            Value="{x:Static controls:InfoBarSeverity.Warning}">
                            <Setter
                                TargetName="Disc"
                                Property="Foreground"
                                Value="{DynamicResource SystemFillColorCautionBrush}" />
                            <Setter
                                TargetName="Mark"
                                Property="Text"
                                Value="&#xF13C;" />
                        </Trigger>
                        <Trigger
                            Property="Tag"
                            Value="{x:Static controls:InfoBarSeverity.Error}">
                            <Setter
                                TargetName="Disc"
                                Property="Foreground"
                                Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            <Setter
                                TargetName="Mark"
                                Property="Text"
                                Value="&#xF13D;" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ConnectDenseListBoxItemStyle"
        BasedOn="{StaticResource {x:Type ListBoxItem}}"
        TargetType="ListBoxItem">
        <Setter
            Property="Padding"
            Value="12,4" />
        <Setter
            Property="MinHeight"
            Value="40" />
        <Setter
            Property="AutomationProperties.Name"
            Value="{Binding AutomationName}" />
    </Style>

    <Style x:Key="ConnectSectionTitleTextBlockStyle"
        BasedOn="{StaticResource SubtitleTextBlockStyle}"
        TargetType="TextBlock">
        <Setter
            Property="TextWrapping"
            Value="Wrap" />
    </Style>

    <Style x:Key="ConnectFieldLabelTextBlockStyle"
        BasedOn="{StaticResource BodyStrongTextBlockStyle}"
        TargetType="TextBlock">
        <Setter
            Property="Margin"
            Value="0,0,12,4" />
    </Style>

    <Style x:Key="ConnectNoticeTextBlockStyle"
        BasedOn="{StaticResource BodyTextBlockStyle}"
        TargetType="TextBlock">
        <Setter
            Property="TextWrapping"
            Value="Wrap" />
        <Setter
            Property="Foreground"
            Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="ConnectActionButtonStyle"
        BasedOn="{StaticResource {x:Type Button}}"
        TargetType="Button">
        <Setter
            Property="MinWidth"
            Value="120" />
        <Setter
            Property="Margin"
            Value="0,0,8,8" />
    </Style>

    <Style x:Key="ConnectAccentActionButtonStyle"
        BasedOn="{StaticResource AccentButtonStyle}"
        TargetType="Button">
        <Setter
            Property="MinWidth"
            Value="120" />
        <Setter
            Property="Margin"
            Value="0,0,8,8" />
    </Style>

    <Style x:Key="ConnectGlyphTextBlockStyle"
        TargetType="TextBlock">
        <Setter
            Property="FontFamily"
            Value="{StaticResource SymbolThemeFontFamily}" />
        <Setter
            Property="FontSize"
            Value="20" />
        <Setter
            Property="VerticalAlignment"
            Value="Center" />
    </Style>
</ResourceDictionary>
