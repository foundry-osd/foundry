<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Foundry.Connect.Controls.WifiPassphraseEditor"
             x:Name="Root">
  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
    <TextBox Name="PasswordEditor"
             MinWidth="180"
             AttachedToVisualTree="OnEditorAttached"
             KeyDown="OnEditorKeyDown"
             PasswordChar="●"
             Text="{Binding #Root.Password, Mode=TwoWay}" />
    <Button Name="RevealButton"
            Grid.Column="1"
            MinWidth="44"
            AutomationProperties.Name="{Binding #Root.AccessibleRevealLabel}"
            Click="OnRevealClicked"
            Content="◉" />
  </Grid>
</UserControl>
