<UserControl x:Class="Foundry.Wpf.Controls.InfoBar" x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Foundry.Wpf.Controls">
    <!--
        Brushes and glyphs follow the WinUI 3 InfoBar: severity background, card stroke, and a filled status circle. Informational
        uses the solid attention background, because the card may sit over content and the regular one is see-through in dark.
    -->
    <Border
        Padding="12"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="6">
        <Border.Style>
            <Style TargetType="Border">
                <Setter
                    Property="Background"
                    Value="{DynamicResource SystemFillColorSolidAttentionBackgroundBrush}" />
                <Style.Triggers>
                    <DataTrigger
                        Binding="{Binding Severity, ElementName=Root}"
                        Value="{x:Static controls:InfoBarSeverity.Success}">
                        <Setter
                            Property="Background"
                            Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                    </DataTrigger>
                    <DataTrigger
                        Binding="{Binding Severity, ElementName=Root}"
                        Value="{x:Static controls:InfoBarSeverity.Warning}">
                        <Setter
                            Property="Background"
                            Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                    </DataTrigger>
                    <DataTrigger
                        Binding="{Binding Severity, ElementName=Root}"
                        Value="{x:Static controls:InfoBarSeverity.Error}">
                        <Setter
                            Property="Background"
                            Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid
                Margin="0,0,12,0"
                VerticalAlignment="Center">
                <TextBlock
                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                    FontSize="16"
                    Text="&#xF136;">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter
                                Property="Foreground"
                                Value="{DynamicResource SystemFillColorAttentionBrush}" />
                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding Severity, ElementName=Root}"
                                    Value="{x:Static controls:InfoBarSeverity.Success}">
                                    <Setter
                                        Property="Foreground"
                                        Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger
                                    Binding="{Binding Severity, ElementName=Root}"
                                    Value="{x:Static controls:InfoBarSeverity.Warning}">
                                    <Setter
                                        Property="Foreground"
                                        Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                                <DataTrigger
                                    Binding="{Binding Severity, ElementName=Root}"
                                    Value="{x:Static controls:InfoBarSeverity.Error}">
                                    <Setter
                                        Property="Foreground"
                                        Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock
                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                    FontSize="16"
                    Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter
                                Property="Text"
                                Value="&#xF13F;" />
                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding Severity, ElementName=Root}"
                                    Value="{x:Static controls:InfoBarSeverity.Success}">
                                    <Setter
                                        Property="Text"
                                        Value="&#xF13E;" />
                                </DataTrigger>
                                <DataTrigger
                                    Binding="{Binding Severity, ElementName=Root}"
                                    Value="{x:Static controls:InfoBarSeverity.Warning}">
                                    <Setter
                                        Property="Text"
                                        Value="&#xF13C;" />
                                </DataTrigger>
                                <DataTrigger
                                    Binding="{Binding Severity, ElementName=Root}"
                                    Value="{x:Static controls:InfoBarSeverity.Error}">
                                    <Setter
                                        Property="Text"
                                        Value="&#xF13D;" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <StackPanel Grid.Column="1">
                <TextBlock
                    Margin="0,0,0,4"
                    FontWeight="SemiBold"
                    Text="{Binding Title, ElementName=Root}"
                    TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding Title, ElementName=Root}"
                                    Value="">
                                    <Setter
                                        Property="Visibility"
                                        Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger
                                    Binding="{Binding Title, ElementName=Root}"
                                    Value="{x:Null}">
                                    <Setter
                                        Property="Visibility"
                                        Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock
                    Text="{Binding Message, ElementName=Root}"
                    TextWrapping="Wrap" />
                <ContentPresenter
                    Margin="0,8,0,0"
                    Content="{Binding Body, ElementName=Root}">
                    <ContentPresenter.Style>
                        <Style TargetType="ContentPresenter">
                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding Body, ElementName=Root}"
                                    Value="{x:Null}">
                                    <Setter
                                        Property="Visibility"
                                        Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentPresenter.Style>
                </ContentPresenter>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
