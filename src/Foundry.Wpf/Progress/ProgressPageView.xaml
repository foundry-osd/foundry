<UserControl x:Class="Foundry.Wpf.Progress.ProgressPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Foundry.Wpf.Controls"
    xmlns:progress="clr-namespace:Foundry.Wpf.Progress">
    <Grid>
        <TextBlock
            Margin="260,44,260,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Style="{StaticResource TitleLargeTextBlockStyle}"
            Text="{Binding ComputerNameText}"
            TextAlignment="Center"
            TextTrimming="CharacterEllipsis" />

        <Grid Margin="24,98,24,72">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="230" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center">
                <TextBlock
                    Margin="0,0,0,14"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{Binding Strings[Progress.Session]}" />
                <Separator Margin="0,0,0,14" />
                <TextBlock
                    Margin="0,0,0,5"
                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{Binding Strings[Progress.Networking]}" />
                <TextBlock
                    Text="{Binding IpAddress}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,3,0,0"
                    Text="{Binding MacAddress}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,3,0,0"
                    Text="{Binding SubnetMask}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,3,0,18"
                    Text="{Binding GatewayAddress}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,0,0,5"
                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{Binding Strings[Progress.StartTime]}" />
                <TextBlock
                    Margin="0,0,0,18"
                    Text="{Binding StartTimeText}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,0,0,5"
                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{Binding Strings[Progress.ElapsedTime]}" />
                <TextBlock
                    Text="{Binding ElapsedTimeText}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Grid
                Grid.Column="2"
                VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Margin="0,0,0,14"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{Binding Strings[Progress.Timeline]}" />
                <Separator
                    Grid.Row="1"
                    Margin="0,0,0,10" />
                <ScrollViewer
                    Grid.Row="2"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="TimelineItems"
                        AutomationProperties.Name="{Binding Strings[Progress.TimelineAutomationName]}"
                        ItemsSource="{Binding TimelineEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                        FontSize="15"
                                        Text="{Binding Glyph}">
                                        <!--  Align the symbol's visible shape with the label, compensating for symbol-font line metrics.  -->
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform Y="1" />
                                        </TextBlock.RenderTransform>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter
                                                    Property="Foreground"
                                                    Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding State}"
                                                        Value="{x:Static progress:ProgressStepState.Succeeded}">
                                                        <Setter
                                                            Property="Foreground"
                                                            Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger
                                                        Binding="{Binding State}"
                                                        Value="{x:Static progress:ProgressStepState.Skipped}">
                                                        <Setter
                                                            Property="Foreground"
                                                            Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger
                                                        Binding="{Binding State}"
                                                        Value="{x:Static progress:ProgressStepState.Running}">
                                                        <Setter
                                                            Property="Foreground"
                                                            Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger
                                                        Binding="{Binding State}"
                                                        Value="{x:Static progress:ProgressStepState.Failed}">
                                                        <Setter
                                                            Property="Foreground"
                                                            Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        AutomationProperties.HelpText="{Binding DetailText}"
                                        AutomationProperties.ItemStatus="{Binding StateAutomationText}"
                                        Text="{Binding DisplayName}"
                                        TextWrapping="Wrap"
                                        ToolTip="{Binding DetailText}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid x:Name="CentralStateHost"
            AutomationProperties.LiveSetting="Polite"
            RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="CentralStateScale" />
            </Grid.RenderTransform>
            <Grid
                Width="180"
                Height="180"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Grid Visibility="{Binding IsProgressPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <controls:CustomProgressRing x:Name="OverallProgressRing"
                        AutomationProperties.Name="{Binding Strings[Progress.RingAutomationName]}"
                        IsIndeterminate="{Binding IsGlobalProgressIndeterminate}"
                        ProgressBrush="{DynamicResource AccentFillColorDefaultBrush}"
                        Thickness="14"
                        TrackBrush="{DynamicResource ControlStrongFillColorDefaultBrush}"
                        Value="{Binding OverallProgress}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource TitleLargeTextBlockStyle}"
                        Text="{Binding DisplayedValue, ElementName=OverallProgressRing, StringFormat={}{0:0}%}" />
                </Grid>
                <controls:TerminalStatusGlyph
                    AutomationName="{Binding Strings[Success.Completed]}"
                    IsSuccess="True"
                    Visibility="{Binding IsSuccessPage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <controls:TerminalStatusGlyph
                    AutomationName="{Binding TerminalErrorTitle}"
                    IsSuccess="False"
                    Visibility="{Binding HasFailure, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{Binding TerminalErrorTitle}"
                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                    FontSize="88"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="&#xE711;"
                    Visibility="{Binding IsCancelled, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>

            <Grid
                Width="430"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding IsProgressPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RenderTransform>
                    <TranslateTransform Y="155" />
                </Grid.RenderTransform>
                <StackPanel>
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{Binding CurrentStepName}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <ProgressBar
                        Height="4"
                        Margin="20,16,20,8"
                        IsIndeterminate="{Binding IsCurrentStepProgressIndeterminate}"
                        Maximum="100"
                        Style="{StaticResource FoundryProgressBarStyle}"
                        Value="{Binding CurrentStepProgress}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{Binding CurrentStepProgressText}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        AutomationProperties.LiveSetting="Polite"
                        Text="{Binding Strings[Status.CancellationPending]}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="{Binding IsCancellationPending, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Grid>

            <Grid
                Width="430"
                Height="72"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding IsSuccessPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RenderTransform>
                    <TranslateTransform Y="-150" />
                </Grid.RenderTransform>
                <TextBlock
                    VerticalAlignment="Bottom"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{Binding Strings[Success.Completed]}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </Grid>

            <Grid
                Width="430"
                Height="120"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding IsSuccessPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RenderTransform>
                    <TranslateTransform Y="174" />
                </Grid.RenderTransform>
                <StackPanel VerticalAlignment="Top">
                    <TextBlock
                        Margin="0,0,0,16"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{Binding CompletionInstructionText}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <!--  The host hides the completion action by leaving its command null.  -->
                    <Grid HorizontalAlignment="Center">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding CompletionCommand}"
                                        Value="{x:Null}">
                                        <Setter
                                            Property="Visibility"
                                            Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Button
                            MinWidth="140"
                            HorizontalAlignment="Center"
                            Command="{Binding CompletionCommand}"
                            Content="{Binding CompletionActionText}"
                            Style="{DynamicResource AccentButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Grid>

            <Grid
                Width="430"
                Height="72"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding IsErrorPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RenderTransform>
                    <TranslateTransform Y="-150" />
                </Grid.RenderTransform>
                <TextBlock
                    VerticalAlignment="Bottom"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{Binding TerminalErrorTitle}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </Grid>

            <Grid
                Width="430"
                Height="120"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding IsErrorPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RenderTransform>
                    <TranslateTransform Y="174" />
                </Grid.RenderTransform>
                <StackPanel VerticalAlignment="Top">
                    <TextBlock
                        Margin="0,0,0,16"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{Binding TerminalErrorInstruction}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Button
                        MinWidth="180"
                        HorizontalAlignment="Center"
                        Click="ViewTechnicalDetails_Click"
                        Content="{Binding Strings[Error.ViewTechnicalDetails]}"
                        Visibility="{Binding HasFailure, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid
            MinHeight="32"
            Margin="24,0,24,24"
            VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="230" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{Binding StepCounterText}"
                TextAlignment="Center" />
            <Grid
                Grid.Column="2"
                Visibility="{Binding IsProgressPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button
                    MinWidth="140"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding CancelCommand}"
                    Content="{Binding Strings[Common.Cancel]}"
                    Visibility="{Binding CanCancel, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
