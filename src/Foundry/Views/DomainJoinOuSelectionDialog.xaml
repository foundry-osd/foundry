<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="Foundry.Views.DomainJoinOuSelectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Foundry.ViewModels"
    CloseButtonStyle="{ThemeResource DefaultButtonStyle}"
    CornerRadius="{ThemeResource OverlayCornerRadius}"
    DefaultButton="Primary"
    PrimaryButtonStyle="{ThemeResource AccentButtonStyle}"
    Style="{ThemeResource DefaultContentDialogStyle}"
    mc:Ignorable="d">
    <Grid x:Name="DialogContentRoot"
        RowSpacing="{ThemeResource FoundryContentGroupSpacing}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="{ThemeResource FoundrySpace4}">
            <TextBlock
                Text="{x:Bind ViewModel.Description}"
                TextWrapping="Wrap" />
            <TextBlock
                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                Text="{x:Bind ViewModel.IncompleteText}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.IncompleteVisibility}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                VerticalAlignment="Center"
                Style="{ThemeResource FoundryCaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.SelectedCountDisplay, Mode=OneWay}" />

            <Button
                Grid.Column="1"
                MinWidth="{ThemeResource FoundryCompactActionMinWidth}"
                Margin="{ThemeResource FoundryInlineLeadingButtonMargin}"
                Command="{x:Bind ViewModel.SelectAllCommand}"
                Content="{x:Bind ViewModel.SelectAllText}" />
            <Button
                Grid.Column="2"
                MinWidth="{ThemeResource FoundryCompactActionMinWidth}"
                Command="{x:Bind ViewModel.ClearCommand}"
                Content="{x:Bind ViewModel.ClearText}" />
        </Grid>

        <ListView x:Name="OrganizationalUnitsList"
            Grid.Row="2"
            ItemsSource="{x:Bind ViewModel.OrganizationalUnits}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:SelectableDomainJoinOuEntryViewModel">
                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}">
                        <StackPanel Spacing="{ThemeResource FoundrySpace2}">
                            <TextBlock
                                Text="{x:Bind DisplayName}"
                                TextWrapping="WrapWholeWords" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource FoundryCaptionTextBlockStyle}"
                                Text="{x:Bind DistinguishedName}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentDialog>
