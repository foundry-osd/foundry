<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="Foundry.Views.PxeOutputDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{x:Bind ViewModel.Title}"
    CloseButtonStyle="{ThemeResource DefaultButtonStyle}"
    CloseButtonText="{x:Bind ViewModel.CancelLabel}"
    CornerRadius="{ThemeResource OverlayCornerRadius}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanCreate, Mode=OneWay}"
    PrimaryButtonStyle="{ThemeResource AccentButtonStyle}"
    PrimaryButtonText="{x:Bind ViewModel.CreateLabel}"
    Style="{ThemeResource DefaultContentDialogStyle}">
    <StackPanel x:Name="ContentPanel"
        Padding="0,4,0,8"
        Spacing="{ThemeResource FoundryContentGroupSpacing}">
        <TextBlock
            Text="{x:Bind ViewModel.Description}"
            TextWrapping="WrapWholeWords" />
        <Grid ColumnSpacing="{ThemeResource FoundryInlineControlSpacing}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                Header="{x:Bind ViewModel.FolderLabel}"
                Text="{x:Bind ViewModel.FolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Command="{x:Bind ViewModel.BrowseCommand}"
                Content="{x:Bind ViewModel.BrowseLabel}"
                Style="{ThemeResource DefaultButtonStyle}" />
        </Grid>
        <InfoBar
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasExistingImage, Mode=OneWay}"
            Message="{x:Bind ViewModel.ExistingImageWarning}"
            Severity="Warning"
            Visibility="{x:Bind ViewModel.HasExistingImage, Mode=OneWay}" />
        <InfoBar
            Title="{x:Bind ViewModel.MissingContentTitle}"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasMissingContent}"
            Message="{x:Bind ViewModel.MissingContentMessage}"
            Severity="Warning"
            Visibility="{x:Bind ViewModel.HasMissingContent}" />
    </StackPanel>
</ContentDialog>
