<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="Foundry.Views.CustomDriverSetImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{x:Bind ViewModel.Title, Mode=OneWay}"
    CloseButtonClick="OnCloseButtonClick"
    CloseButtonStyle="{ThemeResource DefaultButtonStyle}"
    CloseButtonText="{x:Bind ViewModel.CancelLabel, Mode=OneWay}"
    Closed="OnClosed"
    Closing="OnClosing"
    CornerRadius="{ThemeResource OverlayCornerRadius}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanImport, Mode=OneWay}"
    PrimaryButtonClick="OnPrimaryButtonClick"
    PrimaryButtonStyle="{ThemeResource AccentButtonStyle}"
    PrimaryButtonText="{x:Bind ViewModel.ImportLabel, Mode=OneWay}"
    Style="{ThemeResource DefaultContentDialogStyle}">
    <StackPanel
        Width="480"
        Padding="0,4,0,8"
        Spacing="{ThemeResource FoundryContentGroupSpacing}">
        <Grid ColumnSpacing="{ThemeResource FoundryInlineControlSpacing}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                Header="{x:Bind ViewModel.FolderLabel, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                IsReadOnly="True"
                Text="{x:Bind ViewModel.SourcePath, Mode=OneWay}" />
            <Button
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Command="{x:Bind ViewModel.BrowseCommand}"
                Content="{x:Bind ViewModel.BrowseLabel, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                Style="{ThemeResource DefaultButtonStyle}" />
        </Grid>
        <StackPanel Spacing="{ThemeResource FoundryTextGroupSpacing}">
            <TextBox
                Header="{x:Bind ViewModel.NameLabel, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                MaxLength="{x:Bind ViewModel.MaximumNameLength}"
                Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{ThemeResource FoundryCaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.NameValidationMessage, Mode=OneWay}"
                TextWrapping="WrapWholeWords"
                Visibility="{x:Bind ViewModel.HasNameValidation, Mode=OneWay}" />
        </StackPanel>
        <StackPanel
            Spacing="{ThemeResource FoundryContentGroupSpacing}"
            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
            <TextBlock
                AutomationProperties.LiveSetting="Polite"
                Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                TextWrapping="Wrap" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                    Maximum="100"
                    Minimum="0"
                    Value="{x:Bind ViewModel.Progress, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="1"
                    MinWidth="40"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    Text="{x:Bind ViewModel.ProgressPercentText, Mode=OneWay}"
                    TextAlignment="Right" />
            </Grid>
        </StackPanel>
        <InfoBar
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
            Message="{x:Bind ViewModel.Message, Mode=OneWay}"
            Severity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.HasMessage, Mode=OneWay}" />
    </StackPanel>
</ContentDialog>
