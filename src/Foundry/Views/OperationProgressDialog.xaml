<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="Foundry.Views.OperationProgressDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonClick="OnCloseButtonClick"
    Closed="OnClosed"
    Closing="OnClosing"
    CornerRadius="{ThemeResource OverlayCornerRadius}"
    DefaultButton="None"
    PrimaryButtonClick="OnPrimaryButtonClick"
    Style="{ThemeResource DefaultContentDialogStyle}">
    <StackPanel
        Width="{StaticResource FoundryDialogContentWidth}"
        Padding="0,4,0,0"
        Spacing="{ThemeResource FoundryContentGroupSpacing}">
        <FontIcon x:Name="OutcomeIcon"
            HorizontalAlignment="Center"
            AutomationProperties.AccessibilityView="Raw"
            FontSize="40"
            Visibility="Collapsed" />
        <TextBlock x:Name="StatusText"
            AutomationProperties.LiveSetting="Polite"
            TextWrapping="Wrap" />
        <Grid x:Name="PrimaryProgressRow"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="PrimaryProgressBar"
                VerticalAlignment="Center"
                Maximum="100"
                Minimum="0" />
            <TextBlock x:Name="PrimaryPercentText"
                Grid.Column="1"
                MinWidth="40"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                TextAlignment="Right" />
        </Grid>
        <StackPanel x:Name="DetailPanel"
            Spacing="6"
            Visibility="Collapsed">
            <TextBlock x:Name="DetailText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                MaxLines="2"
                Style="{ThemeResource FoundryCaptionTextBlockStyle}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />
            <Grid x:Name="DetailProgressRow"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="DetailProgressBar"
                    VerticalAlignment="Center"
                    Maximum="100"
                    Minimum="0" />
                <TextBlock x:Name="DetailPercentText"
                    Grid.Column="1"
                    MinWidth="40"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource FoundryCaptionTextBlockStyle}"
                    TextAlignment="Right" />
            </Grid>
        </StackPanel>
        <TextBlock x:Name="CancelConfirmationText"
            Foreground="{ThemeResource SystemFillColorCautionBrush}"
            Style="{ThemeResource FoundryCaptionTextBlockStyle}"
            Text="{x:Bind ConfirmStopHint}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
        <TextBlock x:Name="ElapsedText"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            Style="{ThemeResource FoundryCaptionTextBlockStyle}" />
    </StackPanel>
</ContentDialog>
