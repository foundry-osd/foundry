<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Foundry.Views.DeploymentProfilesControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Foundry.Behaviors"
    xmlns:wct="using:CommunityToolkit.WinUI.Controls">
    <UserControl.Resources>
        <x:Double x:Key="SettingsCardWrapThreshold">1000</x:Double>
    </UserControl.Resources>
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="CompactProfileActions">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter
                            Target="ProfileSelector.Width"
                            Value="{ThemeResource FoundrySettingsActionMinWidth}" />
                        <Setter
                            Target="ProfileHeaderActions.Orientation"
                            Value="Vertical" />
                        <Setter
                            Target="SynchronizationActions.Orientation"
                            Value="Vertical" />
                        <Setter
                            Target="RememberPasswordActions.Orientation"
                            Value="Vertical" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideProfileActions">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1500" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="SynchronizationStates">
                <VisualState x:Name="SynchronizationNeutral">
                    <VisualState.Setters>
                        <Setter
                            Target="SynchronizationStatusIcon.Foreground"
                            Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SynchronizationInformational">
                    <VisualState.Setters>
                        <Setter
                            Target="SynchronizationStatusIcon.Foreground"
                            Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SynchronizationSuccess">
                    <VisualState.Setters>
                        <Setter
                            Target="SynchronizationStatusIcon.Foreground"
                            Value="{ThemeResource SystemFillColorSuccessBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SynchronizationWarning">
                    <VisualState.Setters>
                        <Setter
                            Target="SynchronizationStatusIcon.Foreground"
                            Value="{ThemeResource SystemFillColorCautionBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SynchronizationError">
                    <VisualState.Setters>
                        <Setter
                            Target="SynchronizationStatusIcon.Foreground"
                            Value="{ThemeResource SystemFillColorCriticalBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel Spacing="{ThemeResource FoundryCompactStackSpacing}">
            <wct:SettingsExpander
                Description="{x:Bind ViewModel.Text('SettingsPage_ProfilesCard.Description')}"
                Header="{x:Bind ViewModel.Text('SettingsPage_ProfilesCard.Header')}">
                <wct:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8F7;" />
                </wct:SettingsExpander.HeaderIcon>
                <StackPanel x:Name="ProfileHeaderActions"
                    Margin="{ThemeResource FoundrySettingsExpanderTrailingAffordanceMargin}"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="{ThemeResource FoundryInlineControlSpacing}">
                    <ComboBox x:Name="ProfileSelector"
                        Width="{ThemeResource FoundryWideInputMinWidth}"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind ViewModel.Text('Profiles.Active')}"
                        IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
                        ItemsSource="{x:Bind ViewModel.Profiles}"
                        PlaceholderText="{x:Bind ViewModel.Text('Profiles.Select')}"
                        SelectedItem="{x:Bind ViewModel.SelectedProfile, Mode=OneWay}"
                        SelectionChanged="ProfileSelector_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Text="{Binding DisplayName}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <DropDownButton
                        MinWidth="{ThemeResource FoundryCompactActionMinWidth}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="{x:Bind ViewModel.Text('Profiles.Manage')}"
                        IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}">
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    Command="{x:Bind ViewModel.RenameCommand}"
                                    IsEnabled="{x:Bind ViewModel.HasActive, Mode=OneWay}"
                                    Text="{x:Bind ViewModel.Text('Profiles.Rename')}" />
                                <MenuFlyoutItem
                                    Command="{x:Bind ViewModel.SaveCopyCommand}"
                                    Text="{x:Bind ViewModel.Text('Profiles.SaveCopy')}" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem
                                    Command="{x:Bind ViewModel.DeleteCommand}"
                                    IsEnabled="{x:Bind ViewModel.HasActive, Mode=OneWay}"
                                    Text="{x:Bind ViewModel.Text('Profiles.Delete')}" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>
                <wct:SettingsExpander.Items>
                    <wct:SettingsCard
                        Description="{x:Bind ViewModel.Text('Profiles.ImportDescription')}"
                        Header="{x:Bind ViewModel.Text('Profiles.Import')}"
                        IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}">
                        <wct:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8B5;" />
                        </wct:SettingsCard.HeaderIcon>
                        <Button
                            MinWidth="{ThemeResource FoundryCompactActionMinWidth}"
                            Command="{x:Bind ViewModel.ImportCommand}"
                            Content="{x:Bind ViewModel.Text('Profiles.Import')}" />
                    </wct:SettingsCard>
                    <wct:SettingsCard
                        Description="{x:Bind ViewModel.Text('Profiles.ExportDescription')}"
                        Header="{x:Bind ViewModel.Text('Profiles.Export')}"
                        IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}">
                        <wct:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE74E;" />
                        </wct:SettingsCard.HeaderIcon>
                        <Button
                            MinWidth="{ThemeResource FoundryCompactActionMinWidth}"
                            Command="{x:Bind ViewModel.ExportCommand}"
                            Content="{x:Bind ViewModel.Text('Profiles.Export')}"
                            IsEnabled="{x:Bind ViewModel.HasActive, Mode=OneWay}" />
                    </wct:SettingsCard>
                    <wct:SettingsCard
                        Description="{x:Bind ViewModel.Text('Profiles.SynchronizeDescription')}"
                        Header="{x:Bind ViewModel.Text('Profiles.Synchronize')}">
                        <wct:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE895;" />
                        </wct:SettingsCard.HeaderIcon>
                        <StackPanel x:Name="SynchronizationActions"
                            Orientation="Horizontal"
                            Spacing="{ThemeResource FoundryInlineControlSpacing}">
                            <Grid
                                MaxWidth="{ThemeResource FoundryStatusTextMaxWidth}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                ColumnSpacing="{ThemeResource FoundryInlineControlSpacing}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="SynchronizationStatusIcon"
                                    AutomationProperties.AccessibilityView="Raw"
                                    FontSize="16"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="{x:Bind ViewModel.SynchronizationStatusGlyph, Mode=OneWay}" />
                                <TextBlock x:Name="SynchronizationStatusText"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    AutomationProperties.LiveSetting="Polite"
                                    Text="{x:Bind ViewModel.SynchronizationStatusText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </Grid>
                            <Button
                                MinWidth="{ThemeResource FoundryCompactActionMinWidth}"
                                HorizontalAlignment="Right"
                                Command="{x:Bind ViewModel.SynchronizeCommand}"
                                Content="{x:Bind ViewModel.SynchronizeActionText, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.CanSynchronize, Mode=OneWay}" />
                            <Button
                                MinWidth="{ThemeResource FoundryCompactActionMinWidth}"
                                HorizontalAlignment="Right"
                                Command="{x:Bind ViewModel.SetupSynchronizationCommand}"
                                Content="{x:Bind ViewModel.Text('Profiles.ConnectionSettings')}"
                                IsEnabled="{x:Bind ViewModel.CanSynchronize, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.SharedVisibility, Mode=OneWay}" />
                        </StackPanel>
                    </wct:SettingsCard>
                    <wct:SettingsCard
                        Header="{x:Bind ViewModel.Text('Profiles.AutoSync')}"
                        IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.SharedVisibility, Mode=OneWay}">
                        <ToggleSwitch
                            behaviors:LocalizedToggleSwitch.UseLocalizedStateContent="True"
                            AutomationProperties.Name="{x:Bind ViewModel.Text('Profiles.AutoSync')}"
                            IsOn="{x:Bind ViewModel.SyncEnabled, Mode=OneWay}"
                            Toggled="AutomaticSyncToggle_Toggled" />
                    </wct:SettingsCard>
                    <wct:SettingsCard
                        Description="{x:Bind ViewModel.Text('Profiles.ConnectionFileDescription')}"
                        Header="{x:Bind ViewModel.Text('Profiles.ExportRecovery')}"
                        IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.SharedVisibility, Mode=OneWay}">
                        <Button
                            MinWidth="{ThemeResource FoundryCompactActionMinWidth}"
                            Command="{x:Bind ViewModel.ExportRecoveryCommand}"
                            Content="{x:Bind ViewModel.Text('Profiles.ExportRecovery')}" />
                    </wct:SettingsCard>
                    <wct:SettingsCard
                        Description="{x:Bind ViewModel.Text('Profiles.LocalPrivacy')}"
                        Header="{x:Bind ViewModel.Text('Profiles.Remember')}"
                        IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}">
                        <wct:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE72E;" />
                        </wct:SettingsCard.HeaderIcon>
                        <StackPanel x:Name="RememberPasswordActions"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="{ThemeResource FoundryInlineControlSpacing}">
                            <Button
                                MinWidth="{ThemeResource FoundryCompactActionMinWidth}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.ForgetCommand}"
                                Content="{x:Bind ViewModel.Text('Profiles.Forget')}"
                                IsEnabled="{x:Bind ViewModel.HasActive, Mode=OneWay}" />
                            <ToggleSwitch
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                behaviors:LocalizedToggleSwitch.UseLocalizedStateContent="True"
                                AutomationProperties.Name="{x:Bind ViewModel.Text('Profiles.Remember')}"
                                IsEnabled="{x:Bind ViewModel.HasActive, Mode=OneWay}"
                                IsOn="{x:Bind ViewModel.RememberSecrets, Mode=OneWay}"
                                Toggled="RememberPasswordsToggle_Toggled" />
                        </StackPanel>
                    </wct:SettingsCard>
                </wct:SettingsExpander.Items>
            </wct:SettingsExpander>
            <InfoBar
                Title="{x:Bind ViewModel.Text('Profiles.Conflict')}"
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind ViewModel.Text('Profiles.ConflictWarning')}"
                Severity="Warning"
                Visibility="{x:Bind ViewModel.ConflictVisibility, Mode=OneWay}">
                <ContentControl IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}">
                    <StackPanel Spacing="{ThemeResource FoundryInlineControlSpacing}">
                        <Button
                            MinWidth="{ThemeResource FoundryCompactActionMinWidth}"
                            Command="{x:Bind ViewModel.UseRemoteCommand}"
                            Content="{x:Bind ViewModel.Text('Profiles.UseRemote')}" />
                        <Button
                            MinWidth="{ThemeResource FoundryCompactActionMinWidth}"
                            Command="{x:Bind ViewModel.KeepLocalCommand}"
                            Content="{x:Bind ViewModel.Text('Profiles.KeepLocal')}" />
                        <Button
                            MinWidth="{ThemeResource FoundryCompactActionMinWidth}"
                            Command="{x:Bind ViewModel.SaveCopyCommand}"
                            Content="{x:Bind ViewModel.Text('Profiles.SaveCopy')}" />
                    </StackPanel>
                </ContentControl>
            </InfoBar>
            <TextBlock
                Margin="{ThemeResource FoundryDefaultContentPadding}"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.StatusVisibility, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</UserControl>
