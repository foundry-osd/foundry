<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Foundry.Views.AiComponentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Foundry.Behaviors"
    xmlns:controls="using:Foundry.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Foundry.ViewModels"
    xmlns:wct="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">
    <ScrollView
        Margin="{ThemeResource ContentPageMargin}"
        Padding="{ThemeResource ContentPagePadding}"
        HorizontalContentAlignment="Stretch"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            HorizontalAlignment="Stretch"
            Spacing="{ThemeResource FoundrySettingsSectionSpacing}">
            <controls:PageHeader
                x:Uid="AiComponentsPageHeader"
                DocumentationUrl="{x:Bind ViewModel.DocumentationUrl, Mode=OneWay}"
                IconGlyph="&#xE99A;">
                <controls:PageHeader.ActionContent>
                    <ToggleSwitch
                        x:Uid="AiComponentsPageEnableToggle"
                        behaviors:LocalizedToggleSwitch.UseLocalizedStateContent="True"
                        IsOn="{x:Bind ViewModel.IsAiComponentRemovalEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </controls:PageHeader.ActionContent>
            </controls:PageHeader>

            <ContentControl
                HorizontalContentAlignment="Stretch"
                IsEnabled="{x:Bind ViewModel.IsAiComponentRemovalEnabled, Mode=OneWay}">
                <StackPanel Spacing="{ThemeResource FoundrySettingsSectionSpacing}">
                    <wct:SettingsCard
                        Description="{x:Bind ViewModel.AiComponentRemoveCopilotDescription, Mode=OneWay}"
                        Header="{x:Bind ViewModel.AiComponentRemoveCopilotLabel, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsAiComponentRemovalOptionsEnabled, Mode=OneWay}">
                        <wct:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8D4;" />
                        </wct:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                            behaviors:LocalizedToggleSwitch.UseLocalizedStateContent="True"
                            IsOn="{x:Bind ViewModel.RemoveCopilot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </wct:SettingsCard>
                    <wct:SettingsCard
                        Description="{x:Bind ViewModel.AiComponentRemoveAiHubDescription, Mode=OneWay}"
                        Header="{x:Bind ViewModel.AiComponentRemoveAiHubLabel, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsAiComponentRemovalOptionsEnabled, Mode=OneWay}">
                        <wct:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE74C;" />
                        </wct:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                            behaviors:LocalizedToggleSwitch.UseLocalizedStateContent="True"
                            IsOn="{x:Bind ViewModel.RemoveAiHub, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </wct:SettingsCard>
                    <wct:SettingsCard
                        Description="{x:Bind ViewModel.AiComponentDisableRecallDescription, Mode=OneWay}"
                        Header="{x:Bind ViewModel.AiComponentDisableRecallLabel, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsAiComponentRemovalOptionsEnabled, Mode=OneWay}">
                        <wct:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE823;" />
                        </wct:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                            behaviors:LocalizedToggleSwitch.UseLocalizedStateContent="True"
                            IsOn="{x:Bind ViewModel.DisableRecall, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </wct:SettingsCard>
                    <wct:SettingsCard
                        Description="{x:Bind ViewModel.AiComponentDisableClickToDoDescription, Mode=OneWay}"
                        Header="{x:Bind ViewModel.AiComponentDisableClickToDoLabel, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsAiComponentRemovalOptionsEnabled, Mode=OneWay}">
                        <wct:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8B0;" />
                        </wct:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                            behaviors:LocalizedToggleSwitch.UseLocalizedStateContent="True"
                            IsOn="{x:Bind ViewModel.DisableClickToDo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </wct:SettingsCard>
                    <wct:SettingsCard
                        Description="{x:Bind ViewModel.AiComponentDisableAiServiceAutoStartDescription, Mode=OneWay}"
                        Header="{x:Bind ViewModel.AiComponentDisableAiServiceAutoStartLabel, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsAiComponentRemovalOptionsEnabled, Mode=OneWay}">
                        <wct:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE945;" />
                        </wct:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                            behaviors:LocalizedToggleSwitch.UseLocalizedStateContent="True"
                            IsOn="{x:Bind ViewModel.DisableAiServiceAutoStart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </wct:SettingsCard>
                    <wct:SettingsCard
                        Description="{x:Bind ViewModel.AiComponentDisableEdgeAiDescription, Mode=OneWay}"
                        Header="{x:Bind ViewModel.AiComponentDisableEdgeAiLabel, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsAiComponentRemovalOptionsEnabled, Mode=OneWay}">
                        <wct:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE774;" />
                        </wct:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                            behaviors:LocalizedToggleSwitch.UseLocalizedStateContent="True"
                            IsOn="{x:Bind ViewModel.DisableEdgeAi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </wct:SettingsCard>
                    <wct:SettingsCard
                        Description="{x:Bind ViewModel.AiComponentDisablePaintAiDescription, Mode=OneWay}"
                        Header="{x:Bind ViewModel.AiComponentDisablePaintAiLabel, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsAiComponentRemovalOptionsEnabled, Mode=OneWay}">
                        <wct:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xEC87;" />
                        </wct:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                            behaviors:LocalizedToggleSwitch.UseLocalizedStateContent="True"
                            IsOn="{x:Bind ViewModel.DisablePaintAi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </wct:SettingsCard>
                    <wct:SettingsCard
                        Description="{x:Bind ViewModel.AiComponentDisableNotepadAiDescription, Mode=OneWay}"
                        Header="{x:Bind ViewModel.AiComponentDisableNotepadAiLabel, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsAiComponentRemovalOptionsEnabled, Mode=OneWay}">
                        <wct:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE70B;" />
                        </wct:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                            behaviors:LocalizedToggleSwitch.UseLocalizedStateContent="True"
                            IsOn="{x:Bind ViewModel.DisableNotepadAi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </wct:SettingsCard>
                </StackPanel>
            </ContentControl>
        </StackPanel>
    </ScrollView>
</Page>
