<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Foundry.Views.CustomImagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Foundry.Behaviors"
    xmlns:controls="using:Foundry.Controls"
    xmlns:tv="using:WinUI.TableView"
    xmlns:wct="using:CommunityToolkit.WinUI.Controls">
    <ScrollView
        Margin="{ThemeResource ContentPageMargin}"
        Padding="{ThemeResource ContentPagePadding}"
        HorizontalContentAlignment="Stretch"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="{ThemeResource FoundrySettingsSectionSpacing}">
            <controls:PageHeader
                Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}"
                Description="{x:Bind ViewModel.PageDescription, Mode=OneWay}"
                DocumentationUrl="{x:Bind ViewModel.DocumentationUrl, Mode=OneWay}"
                IconGlyph="&#xE958;">
                <controls:PageHeader.ActionContent>
                    <ToggleSwitch
                        behaviors:LocalizedToggleSwitch.UseLocalizedStateContent="True"
                        AutomationProperties.Name="{x:Bind ViewModel.EnableLabel, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanToggle, Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}"
                        Style="{StaticResource FoundryPageHeaderToggleSwitchStyle}" />
                </controls:PageHeader.ActionContent>
            </controls:PageHeader>
            <ContentControl
                HorizontalContentAlignment="Stretch"
                IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}">
                <StackPanel Spacing="{ThemeResource FoundrySettingsSectionSpacing}">
                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasReadinessIssue, Mode=OneWay}"
                        Message="{x:Bind ViewModel.ReadinessMessage, Mode=OneWay}"
                        Severity="Warning" />
                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                        Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                        Severity="Error" />
                    <StackPanel Spacing="{ThemeResource FoundryContentGroupSpacing}">
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Enabled"
                            IsTabStop="False"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalScrollMode="Disabled">
                            <CommandBar
                                HorizontalAlignment="Left"
                                DefaultLabelPosition="Right"
                                IsDynamicOverflowEnabled="False"
                                IsEnabled="{x:Bind ViewModel.CanAct, Mode=OneWay}"
                                OverflowButtonVisibility="Collapsed">
                                <CommandBar.PrimaryCommands>
                                    <AppBarButton
                                        Command="{x:Bind ViewModel.ImportCommand}"
                                        Label="{x:Bind ViewModel.ImportLabel, Mode=OneWay}">
                                        <AppBarButton.Icon>
                                            <FontIcon Glyph="&#xE710;" />
                                        </AppBarButton.Icon>
                                    </AppBarButton>
                                    <AppBarButton
                                        Command="{x:Bind ViewModel.RefreshCommand}"
                                        Icon="Refresh"
                                        Label="{x:Bind ViewModel.RefreshLabel, Mode=OneWay}" />
                                    <AppBarSeparator />
                                    <AppBarButton
                                        Click="OnEditClick"
                                        Icon="Edit"
                                        IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                        Label="{x:Bind ViewModel.RenameLabel, Mode=OneWay}" />
                                    <AppBarButton
                                        Command="{x:Bind ViewModel.ToggleIncludedCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                        Label="{x:Bind ViewModel.IncludeLabel, Mode=OneWay}">
                                        <AppBarButton.Icon>
                                            <SymbolIcon Symbol="{x:Bind ViewModel.IncludeSymbol, Mode=OneWay}" />
                                        </AppBarButton.Icon>
                                    </AppBarButton>
                                    <AppBarButton
                                        Command="{x:Bind ViewModel.RemoveCommand}"
                                        Icon="Delete"
                                        IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                        Label="{x:Bind ViewModel.RemoveLabel, Mode=OneWay}" />
                                    <AppBarSeparator />
                                    <AppBarButton
                                        Command="{x:Bind ViewModel.SetDefaultCommand}"
                                        Icon="Favorite"
                                        IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                        Label="{x:Bind ViewModel.SetDefaultLabel, Mode=OneWay}" />
                                    <AppBarButton
                                        Command="{x:Bind ViewModel.SetIndexDefaultCommand}"
                                        Icon="Accept"
                                        IsEnabled="{x:Bind ViewModel.CanSetIndexDefault, Mode=OneWay}"
                                        Label="{x:Bind ViewModel.SetIndexDefaultLabel, Mode=OneWay}" />
                                    <AppBarButton
                                        Command="{x:Bind ViewModel.ClearDefaultCommand}"
                                        Icon="Clear"
                                        IsEnabled="{x:Bind ViewModel.CanClearDefault, Mode=OneWay}"
                                        Label="{x:Bind ViewModel.ClearDefaultLabel, Mode=OneWay}" />
                                </CommandBar.PrimaryCommands>
                            </CommandBar>
                        </ScrollViewer>
                        <TextBlock
                            Style="{ThemeResource FoundrySecondaryBodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}"
                            TextWrapping="WrapWholeWords"
                            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
                        <tv:TableView x:Name="ImagesTable"
                            MaxHeight="{ThemeResource FoundryTableMaxHeight}"
                            AutoGenerateColumns="False"
                            AutomationProperties.Name="{x:Bind ViewModel.LibraryLabel, Mode=OneWay}"
                            CanFilterColumns="False"
                            CanReorderColumns="False"
                            CanResizeColumns="False"
                            CanSortColumns="False"
                            CornerButtonMode="None"
                            HeadersVisibility="Columns"
                            IsEnabled="{x:Bind ViewModel.CanAct, Mode=OneWay}"
                            IsReadOnly="True"
                            ItemsSource="{x:Bind ViewModel.Images, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedImage, Mode=TwoWay}"
                            SelectionMode="Single"
                            SelectionUnit="Row"
                            ShowExportOptions="False"
                            Visibility="{x:Bind ViewModel.HasImages, Mode=OneWay}">
                            <tv:TableView.Columns>
                                <tv:TableViewTextColumn
                                    Binding="{Binding Name}"
                                    Header="{x:Bind ViewModel.NameLabel, Mode=OneWay}" />
                                <tv:TableViewTextColumn
                                    Binding="{Binding Architecture}"
                                    Header="{x:Bind ViewModel.ArchitectureLabel, Mode=OneWay}" />
                                <tv:TableViewTextColumn
                                    Binding="{Binding Indexes}"
                                    Header="{x:Bind ViewModel.IndexesLabel, Mode=OneWay}" />
                                <tv:TableViewTextColumn
                                    Binding="{Binding Size}"
                                    Header="{x:Bind ViewModel.SizeLabel, Mode=OneWay}" />
                                <tv:TableViewTemplateColumn Header="{x:Bind ViewModel.IncludedLabel, Mode=OneWay}">
                                    <tv:TableViewTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Margin="12,0,12,0"
                                                Style="{Binding IncludedStyle}"
                                                Text="{Binding Included}"
                                                TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </tv:TableViewTemplateColumn.CellTemplate>
                                </tv:TableViewTemplateColumn>
                                <tv:TableViewTemplateColumn Header="{x:Bind ViewModel.DefaultLabel, Mode=OneWay}">
                                    <tv:TableViewTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Margin="12,0,12,0"
                                                Style="{Binding DefaultStyle}"
                                                Text="{Binding Default}"
                                                TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </tv:TableViewTemplateColumn.CellTemplate>
                                </tv:TableViewTemplateColumn>
                                <tv:TableViewTemplateColumn Header="{x:Bind ViewModel.StatusLabel, Mode=OneWay}">
                                    <tv:TableViewTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Margin="12,0,12,0"
                                                Style="{Binding StatusStyle}"
                                                Text="{Binding Status}"
                                                TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </tv:TableViewTemplateColumn.CellTemplate>
                                </tv:TableViewTemplateColumn>
                            </tv:TableView.Columns>
                        </tv:TableView>
                    </StackPanel>
                    <wct:SettingsCard
                        HorizontalContentAlignment="Stretch"
                        ContentAlignment="Vertical"
                        Description="{x:Bind ViewModel.SelectedImageName, Mode=OneWay}"
                        Header="{x:Bind ViewModel.DetailsLabel, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                        <StackPanel Spacing="{ThemeResource FoundryContentGroupSpacing}">
                            <tv:TableView
                                MaxHeight="{ThemeResource FoundryTableMaxHeight}"
                                AutoGenerateColumns="False"
                                AutomationProperties.Name="{x:Bind ViewModel.IndexesLabel, Mode=OneWay}"
                                CanFilterColumns="False"
                                CanReorderColumns="False"
                                CanResizeColumns="False"
                                CanSortColumns="False"
                                CornerButtonMode="None"
                                HeadersVisibility="Columns"
                                IsReadOnly="True"
                                ItemsSource="{x:Bind ViewModel.Indexes, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
                                SelectionMode="Single"
                                SelectionUnit="Row"
                                ShowExportOptions="False">
                                <tv:TableView.Columns>
                                    <tv:TableViewTextColumn
                                        Binding="{Binding Index.Index}"
                                        Header="{x:Bind ViewModel.IndexNumberLabel, Mode=OneWay}" />
                                    <tv:TableViewTextColumn
                                        Binding="{Binding Index.Name}"
                                        Header="{x:Bind ViewModel.NameLabel, Mode=OneWay}" />
                                    <tv:TableViewTextColumn
                                        Binding="{Binding Index.Architecture}"
                                        Header="{x:Bind ViewModel.ArchitectureLabel, Mode=OneWay}" />
                                    <tv:TableViewTextColumn
                                        Binding="{Binding Index.EditionId}"
                                        Header="{x:Bind ViewModel.EditionLabel, Mode=OneWay}" />
                                    <tv:TableViewTextColumn
                                        Binding="{Binding Index.Version}"
                                        Header="{x:Bind ViewModel.VersionLabel, Mode=OneWay}" />
                                    <tv:TableViewTextColumn
                                        Binding="{Binding Languages}"
                                        Header="{x:Bind ViewModel.LanguagesLabel, Mode=OneWay}" />
                                    <tv:TableViewTemplateColumn Header="{x:Bind ViewModel.IndexLabel, Mode=OneWay}">
                                        <tv:TableViewTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    Margin="12,0,12,0"
                                                    Style="{Binding PreferredStyle}"
                                                    Text="{Binding Preferred}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </tv:TableViewTemplateColumn.CellTemplate>
                                    </tv:TableViewTemplateColumn>
                                </tv:TableView.Columns>
                            </tv:TableView>
                            <TextBlock
                                IsTextSelectionEnabled="True"
                                Style="{ThemeResource FoundryCaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.ContentHash, Mode=OneWay}"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </wct:SettingsCard>
                    <wct:SettingsCard
                        Description="{x:Bind ViewModel.DefaultSourceDescription, Mode=OneWay}"
                        Header="{x:Bind ViewModel.DefaultSourceLabel, Mode=OneWay}">
                        <ComboBox
                            Width="{ThemeResource FoundryWideInputMinWidth}"
                            AutomationProperties.Name="{x:Bind ViewModel.DefaultSourceLabel, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.CanAct, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.SourceOptions, Mode=OneWay}"
                            SelectedIndex="{x:Bind ViewModel.DefaultSourceIndex, Mode=TwoWay}" />
                    </wct:SettingsCard>
                </StackPanel>
            </ContentControl>
        </StackPanel>
    </ScrollView>
</Page>
