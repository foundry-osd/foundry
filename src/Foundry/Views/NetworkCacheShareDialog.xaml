<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="Foundry.Views.NetworkCacheShareDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonStyle="{ThemeResource DefaultButtonStyle}"
    CornerRadius="{ThemeResource OverlayCornerRadius}"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    PrimaryButtonStyle="{ThemeResource AccentButtonStyle}"
    Style="{ThemeResource DefaultContentDialogStyle}">
    <StackPanel
        Width="{ThemeResource FoundryWideInputMinWidth}"
        Spacing="{ThemeResource FoundryContentGroupSpacing}">
        <TextBox x:Name="PathBox"
            MaxLength="260" />
        <StackPanel Spacing="{ThemeResource FoundryTextGroupSpacing}">
            <ComboBox x:Name="AccountComboBox"
                HorizontalAlignment="Stretch"
                DisplayMemberPath="DisplayName" />
            <TextBlock x:Name="AccountHintTextBlock"
                Style="{ThemeResource FoundrySecondaryBodyTextBlockStyle}"
                TextWrapping="WrapWholeWords" />
        </StackPanel>
        <TextBlock x:Name="ValidationTextBlock"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            TextWrapping="WrapWholeWords"
            Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
