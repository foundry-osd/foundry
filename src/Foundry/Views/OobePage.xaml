<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Foundry.Views.OobePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Foundry.Behaviors"
    xmlns:controls="using:Foundry.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Foundry.ViewModels"
    xmlns:wct="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">
    <ScrollView
        Margin="{ThemeResource ContentPageMargin}"
        Padding="{ThemeResource ContentPagePadding}"
        HorizontalContentAlignment="Stretch"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            HorizontalAlignment="Stretch"
            Spacing="{ThemeResource FoundrySettingsSectionSpacing}">
            <controls:PageHeader
                x:Uid="OobePageHeader"
                DocumentationUrl="{x:Bind ViewModel.OobeDocumentationUrl, Mode=OneWay}"
                IconGlyph="&#xF133;">
                <controls:PageHeader.ActionContent>
                    <ToggleSwitch
                        x:Uid="OobePageEnableToggle"
                        behaviors:LocalizedToggleSwitch.UseLocalizedStateContent="True"
                        IsOn="{x:Bind ViewModel.IsOobeEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource FoundryPageHeaderToggleSwitchStyle}" />
                </controls:PageHeader.ActionContent>
            </controls:PageHeader>

            <ContentControl
                HorizontalContentAlignment="Stretch"
                IsEnabled="{x:Bind ViewModel.IsOobeEnabled, Mode=OneWay}">
                <StackPanel Spacing="{ThemeResource FoundrySettingsSectionSpacing}">
                    <wct:SettingsExpander
                        Description="{x:Bind ViewModel.OobeAccountsDescription, Mode=OneWay}"
                        Header="{x:Bind ViewModel.OobeAccountsHeader, Mode=OneWay}">
                        <wct:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE77B;" />
                        </wct:SettingsExpander.HeaderIcon>
                        <wct:SettingsExpander.Items>
                            <Border
                                Padding="{ThemeResource FoundryDefaultContentPadding}"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource FoundryCardCornerRadius}">
                                <StackPanel Spacing="{ThemeResource FoundryContentGroupSpacing}">
                                    <InfoBar
                                        IsClosable="False"
                                        IsOpen="True"
                                        Message="{x:Bind ViewModel.OobeAccountsBlockedMessage, Mode=OneWay}"
                                        Severity="Error"
                                        Visibility="{x:Bind ViewModel.OobeAccountsBlockedVisibility, Mode=OneWay}" />

                                    <ContentControl
                                        HorizontalContentAlignment="Stretch"
                                        IsEnabled="{x:Bind ViewModel.AreOobeAccountControlsAvailable, Mode=OneWay}"
                                        IsTabStop="False">
                                        <StackPanel Spacing="{ThemeResource FoundrySpace16}">
                                            <Grid ColumnSpacing="{ThemeResource FoundryPageHeaderColumnSpacing}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="{ThemeResource FoundryTextGroupSpacing}">
                                                    <TextBlock
                                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                        Text="{x:Bind ViewModel.OobeAdministratorAccountLabel, Mode=OneWay}"
                                                        TextWrapping="WrapWholeWords" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind ViewModel.OobeAccountPasswordDescription, Mode=OneWay}"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                                <ToggleSwitch x:Name="AdministratorAccountToggle"
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    behaviors:LocalizedToggleSwitch.UseLocalizedStateContent="True"
                                                    IsOn="{x:Bind ViewModel.EnableAdministratorAccount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Toggled="AdministratorAccountToggle_Toggled" />
                                            </Grid>

                                            <StackPanel
                                                Width="{ThemeResource FoundryWideInputMinWidth}"
                                                HorizontalAlignment="Left"
                                                Spacing="{ThemeResource FoundrySettingsSectionSpacing}"
                                                Visibility="{x:Bind ViewModel.EnableAdministratorAccount, Mode=OneWay}">
                                                <PasswordBox x:Name="AdministratorPasswordBox"
                                                    Loaded="AdministratorPasswordBox_Loaded"
                                                    PasswordChanged="AdministratorPasswordBox_PasswordChanged"
                                                    PlaceholderText="{x:Bind ViewModel.OobePasswordPlaceholder, Mode=OneWay}" />
                                                <PasswordBox x:Name="AdministratorConfirmationBox"
                                                    Loaded="AdministratorConfirmationBox_Loaded"
                                                    PasswordChanged="AdministratorConfirmationBox_PasswordChanged"
                                                    PlaceholderText="{x:Bind ViewModel.OobeConfirmationPlaceholder, Mode=OneWay}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                    Text="{x:Bind ViewModel.OobeAdministratorValidationMessage, Mode=OneWay}"
                                                    TextWrapping="WrapWholeWords"
                                                    Visibility="{x:Bind ViewModel.OobeAdministratorValidationVisibility, Mode=OneWay}" />
                                            </StackPanel>

                                            <Rectangle
                                                Height="1"
                                                Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                            <Grid ColumnSpacing="{ThemeResource FoundryPageHeaderColumnSpacing}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="{ThemeResource FoundryTextGroupSpacing}">
                                                    <TextBlock
                                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                        Text="{x:Bind ViewModel.OobeAdditionalAccountsLabel, Mode=OneWay}"
                                                        TextWrapping="WrapWholeWords" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind ViewModel.OobeAdditionalAccountsEmpty, Mode=OneWay}"
                                                        TextWrapping="WrapWholeWords"
                                                        Visibility="{x:Bind ViewModel.OobeAdditionalAccountsEmptyVisibility, Mode=OneWay}" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="1"
                                                    MinWidth="{ThemeResource FoundryCompactActionMinWidth}"
                                                    VerticalAlignment="Center"
                                                    Command="{x:Bind ViewModel.AddOobeAdditionalAccountCommand}"
                                                    Content="{x:Bind ViewModel.OobeAdditionalAccountsAddButton, Mode=OneWay}" />
                                            </Grid>

                                            <ItemsControl ItemsSource="{x:Bind ViewModel.OobeAdditionalAccounts, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:OobeAdditionalAccountEntryViewModel">
                                                        <Border
                                                            Margin="0,0,0,8"
                                                            Padding="{ThemeResource FoundryCompactContentPadding}"
                                                            HorizontalAlignment="Stretch"
                                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                            CornerRadius="{ThemeResource FoundryControlCornerRadius}">
                                                            <Grid ColumnSpacing="{ThemeResource FoundryInlineControlSpacing}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Spacing="{ThemeResource FoundryCompactStackSpacing}">
                                                                    <TextBlock
                                                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                                        Text="{x:Bind UserName, Mode=OneWay}"
                                                                        TextWrapping="WrapWholeWords" />
                                                                    <TextBlock
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        Style="{ThemeResource FoundryCaptionTextBlockStyle}"
                                                                        Text="{x:Bind AccountTypeDisplayName, Mode=OneWay}"
                                                                        TextWrapping="WrapWholeWords" />
                                                                </StackPanel>
                                                                <StackPanel
                                                                    Grid.Column="1"
                                                                    VerticalAlignment="Center"
                                                                    Orientation="Horizontal"
                                                                    Spacing="{ThemeResource FoundryInlineControlSpacing}">
                                                                    <Button
                                                                        Command="{x:Bind EditCommand, Mode=OneWay}"
                                                                        Content="{x:Bind EditText, Mode=OneWay}" />
                                                                    <Button
                                                                        Command="{x:Bind RemoveCommand, Mode=OneWay}"
                                                                        Content="{x:Bind RemoveText, Mode=OneWay}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                Text="{x:Bind ViewModel.OobeAdditionalAccountsValidationMessage, Mode=OneWay}"
                                                TextWrapping="WrapWholeWords"
                                                Visibility="{x:Bind ViewModel.OobeAdditionalAccountsValidationVisibility, Mode=OneWay}" />

                                            <Grid ColumnSpacing="{ThemeResource FoundryInlineControlSpacing}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid VerticalAlignment="Top">
                                                    <FontIcon
                                                        FontSize="{ThemeResource FoundryIconSizeSmall}"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Glyph="&#xE946;"
                                                        Visibility="{x:Bind ViewModel.OobeAdditionalAccountsEmptyVisibility, Mode=OneWay}" />
                                                    <FontIcon
                                                        FontSize="{ThemeResource FoundryIconSizeSmall}"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Glyph="&#xE73E;"
                                                        Visibility="{x:Bind ViewModel.HasAdditionalOobeAccounts, Mode=OneWay}" />
                                                </Grid>
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="{ThemeResource FoundryTextGroupSpacing}">
                                                    <TextBlock
                                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                        Text="{x:Bind ViewModel.OobeSkipUserAccountCreationLabel, Mode=OneWay}"
                                                        TextWrapping="WrapWholeWords" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind ViewModel.OobeSkipUserAccountCreationEffectiveDescription, Mode=OneWay}"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                            </Grid>

                                            <Grid ColumnSpacing="{ThemeResource FoundryInlineControlSpacing}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon
                                                    VerticalAlignment="Top"
                                                    FontSize="{ThemeResource FoundryIconSizeSmall}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Glyph="&#xE72E;" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind ViewModel.OobeAccountsSecurityWarning, Mode=OneWay}"
                                                    TextWrapping="WrapWholeWords" />
                                            </Grid>
                                        </StackPanel>
                                    </ContentControl>
                                </StackPanel>
                            </Border>
                        </wct:SettingsExpander.Items>
                    </wct:SettingsExpander>

                    <wct:SettingsCard
                        Description="{x:Bind ViewModel.OobeSkipLicenseTermsDescription, Mode=OneWay}"
                        Header="{x:Bind ViewModel.OobeSkipLicenseTermsLabel, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsOobeOptionsEnabled, Mode=OneWay}">
                        <wct:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xEB95;" />
                        </wct:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                            behaviors:LocalizedToggleSwitch.UseLocalizedStateContent="True"
                            IsOn="{x:Bind ViewModel.SkipLicenseTerms, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </wct:SettingsCard>
                    <wct:SettingsCard
                        Description="{x:Bind ViewModel.OobeDiagnosticDataDescription, Mode=OneWay}"
                        Header="{x:Bind ViewModel.OobeDiagnosticDataLabel, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsOobeOptionsEnabled, Mode=OneWay}">
                        <wct:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE9D9;" />
                        </wct:SettingsCard.HeaderIcon>
                        <ComboBox
                            Width="{ThemeResource FoundryWideInputMinWidth}"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{x:Bind ViewModel.OobeDiagnosticDataOptions, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedOobeDiagnosticData, Mode=TwoWay}" />
                    </wct:SettingsCard>
                    <wct:SettingsCard
                        Description="{x:Bind ViewModel.OobeHidePrivacySetupDescription, Mode=OneWay}"
                        Header="{x:Bind ViewModel.OobeHidePrivacySetupLabel, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsOobeOptionsEnabled, Mode=OneWay}">
                        <wct:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE705;" />
                        </wct:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                            behaviors:LocalizedToggleSwitch.UseLocalizedStateContent="True"
                            IsOn="{x:Bind ViewModel.HidePrivacySetup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </wct:SettingsCard>
                    <wct:SettingsCard
                        Description="{x:Bind ViewModel.OobeTailoredExperiencesDescription, Mode=OneWay}"
                        Header="{x:Bind ViewModel.OobeTailoredExperiencesLabel, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsOobeOptionsEnabled, Mode=OneWay}">
                        <wct:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE728;" />
                        </wct:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                            behaviors:LocalizedToggleSwitch.UseLocalizedStateContent="True"
                            IsOn="{x:Bind ViewModel.AllowTailoredExperiences, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </wct:SettingsCard>
                    <wct:SettingsCard
                        Description="{x:Bind ViewModel.OobeAdvertisingIdDescription, Mode=OneWay}"
                        Header="{x:Bind ViewModel.OobeAdvertisingIdLabel, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsOobeOptionsEnabled, Mode=OneWay}">
                        <wct:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE789;" />
                        </wct:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                            behaviors:LocalizedToggleSwitch.UseLocalizedStateContent="True"
                            IsOn="{x:Bind ViewModel.AllowAdvertisingId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </wct:SettingsCard>
                    <wct:SettingsCard
                        Description="{x:Bind ViewModel.OobeOnlineSpeechRecognitionDescription, Mode=OneWay}"
                        Header="{x:Bind ViewModel.OobeOnlineSpeechRecognitionLabel, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsOobeOptionsEnabled, Mode=OneWay}">
                        <wct:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE720;" />
                        </wct:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                            behaviors:LocalizedToggleSwitch.UseLocalizedStateContent="True"
                            IsOn="{x:Bind ViewModel.AllowOnlineSpeechRecognition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </wct:SettingsCard>
                    <wct:SettingsCard
                        Description="{x:Bind ViewModel.OobeInkingAndTypingDiagnosticsDescription, Mode=OneWay}"
                        Header="{x:Bind ViewModel.OobeInkingAndTypingDiagnosticsLabel, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsOobeOptionsEnabled, Mode=OneWay}">
                        <wct:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xED5F;" />
                        </wct:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                            behaviors:LocalizedToggleSwitch.UseLocalizedStateContent="True"
                            IsOn="{x:Bind ViewModel.AllowInkingAndTypingDiagnostics, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </wct:SettingsCard>
                    <wct:SettingsCard
                        Description="{x:Bind ViewModel.OobeLocationAccessDescription, Mode=OneWay}"
                        Header="{x:Bind ViewModel.OobeLocationAccessLabel, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsOobeOptionsEnabled, Mode=OneWay}">
                        <wct:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE707;" />
                        </wct:SettingsCard.HeaderIcon>
                        <ComboBox
                            Width="{ThemeResource FoundryWideInputMinWidth}"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{x:Bind ViewModel.OobeLocationAccessOptions, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedOobeLocationAccess, Mode=TwoWay}" />
                    </wct:SettingsCard>
                </StackPanel>
            </ContentControl>
        </StackPanel>
    </ScrollView>
</Page>
