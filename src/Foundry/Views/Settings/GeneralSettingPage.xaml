<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Foundry.Views.GeneralSettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Foundry.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Foundry"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Foundry.Views"
    xmlns:wct="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">
    <ScrollView
        Margin="{ThemeResource ContentPageMargin}"
        Padding="{ThemeResource ContentPagePadding}"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="{ThemeResource FoundryCompactStackSpacing}">

            <wct:SettingsCard x:Name="StartupCard"
                x:Uid="GeneralSetting_StartupCard">
                <wct:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7F4;" />
                </wct:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="StartupToggle"
                    behaviors:LocalizedToggleSwitch.UseLocalizedStateContent="True"
                    Toggled="StartupToggle_Toggled" />
            </wct:SettingsCard>

            <wct:SettingsCard x:Name="LanguageCard"
                x:Uid="GeneralSetting_LanguageCard">
                <wct:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xF2B7;" />
                </wct:SettingsCard.HeaderIcon>
                <ComboBox x:Name="LanguageComboBox"
                    Width="{ThemeResource FoundryWideInputMinWidth}"
                    ItemsSource="{x:Bind ViewModel.SupportedLanguages, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}"
                    SelectionChanged="LanguageComboBox_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </wct:SettingsCard>

            <wct:SettingsCard x:Name="DeveloperDiagnosticsCard"
                x:Uid="GeneralSetting_DiagnosticsCard">
                <wct:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xEC7A;" />
                </wct:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    behaviors:LocalizedToggleSwitch.UseLocalizedStateContent="True"
                    IsOn="{x:Bind ViewModel.IsDeveloperMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </wct:SettingsCard>

            <wct:SettingsCard x:Name="ExportDiagnosticsCard">
                <wct:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE74E;" />
                </wct:SettingsCard.HeaderIcon>
                <StackPanel Spacing="8">
                    <HyperlinkButton
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Command="{x:Bind ViewModel.OpenLogFolderCommand}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.LogDirectoryPath}">
                        <TextBlock
                            Text="{x:Bind ViewModel.LogDirectoryPath}"
                            TextTrimming="CharacterEllipsis" />
                    </HyperlinkButton>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button x:Name="ExportDiagnosticsButton"
                            Command="{x:Bind ViewModel.ExportDiagnosticsCommand}" />
                        <Button x:Name="ExportRawDiagnosticsButton"
                            Command="{x:Bind ViewModel.ExportRawDiagnosticsCommand}" />
                    </StackPanel>
                </StackPanel>
            </wct:SettingsCard>

        </StackPanel>
    </ScrollView>
</Page>

