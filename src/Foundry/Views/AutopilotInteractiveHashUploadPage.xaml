<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Foundry.Views.AutopilotInteractiveHashUploadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Foundry.Behaviors"
    xmlns:controls="using:Foundry.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wct="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">
    <Grid
        Margin="{ThemeResource ContentPageMargin}"
        Padding="{ThemeResource ContentPagePadding}"
        RowSpacing="{ThemeResource FoundrySettingsSectionSpacing}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="{ThemeResource FoundrySettingsSectionSpacing}">
            <controls:PageHeader
                x:Uid="AutopilotInteractiveHashUploadPageHeader"
                DocumentationUrl="{x:Bind ViewModel.InteractiveDocumentationUrl, Mode=OneWay}"
                IconGlyph="&#xE928;">
                <controls:PageHeader.ActionContent>
                    <Button
                        Click="OnModeActionClick"
                        Content="{x:Bind ViewModel.InteractiveHardwareHashUploadActionText, Mode=OneWay}"
                        IsEnabled="{x:Bind Managed.IsEditable, Mode=OneWay}" />
                </controls:PageHeader.ActionContent>
            </controls:PageHeader>
            <controls:ManagedConfigurationBanner />
        </StackPanel>

        <ScrollView x:Name="InteractiveContentScrollView"
            Grid.Row="1"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            SizeChanged="OnInteractiveContentSizeChanged"
            VerticalScrollBarVisibility="Auto">
            <ContentControl
                MinHeight="{x:Bind InteractiveContentScrollView.ActualHeight, Mode=OneWay}"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsEnabled="{x:Bind ViewModel.IsInteractiveHardwareHashUploadActive, Mode=OneWay}">
                <Grid x:Name="InteractiveLayout"
                    RowSpacing="{ThemeResource FoundrySettingsSectionSpacing}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="InteractiveOptions"
                        HorizontalAlignment="Stretch"
                        SizeChanged="OnInteractiveContentSizeChanged"
                        Spacing="{ThemeResource FoundrySettingsSectionSpacing}">
                        <wct:SettingsCard
                            x:Uid="AutopilotInteractivePreselectCustomCard"
                            IsEnabled="{x:Bind Managed.IsEditable, Mode=OneWay}">
                            <wct:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8EC;" />
                            </wct:SettingsCard.HeaderIcon>
                            <ToggleSwitch
                                behaviors:LocalizedToggleSwitch.UseLocalizedStateContent="True"
                                IsOn="{x:Bind ViewModel.PreselectCustomGroupTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </wct:SettingsCard>
                        <wct:SettingsCard
                            x:Uid="AutopilotInteractiveOfferAssignedUserCard"
                            IsEnabled="{x:Bind Managed.IsEditable, Mode=OneWay}">
                            <wct:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE77B;" />
                            </wct:SettingsCard.HeaderIcon>
                            <ToggleSwitch
                                behaviors:LocalizedToggleSwitch.UseLocalizedStateContent="True"
                                IsOn="{x:Bind ViewModel.OfferAssignedUser, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </wct:SettingsCard>
                    </StackPanel>

                    <Grid x:Name="InteractivePresentation"
                        Grid.Row="1"
                        MaxWidth="{ThemeResource FoundryContentMaxWidth}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        RowSpacing="{ThemeResource FoundrySpace12}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Image x:Name="InteractiveImage"
                            MaxHeight="720"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            Source="ms-appx:///Assets/AutopilotInteractiveHardwareHashUpload.png"
                            Stretch="Uniform" />

                        <TextBlock x:Name="InteractiveDescription"
                            Grid.Row="1"
                            HorizontalAlignment="Stretch"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            SizeChanged="OnInteractiveContentSizeChanged"
                            Text="{x:Bind ViewModel.InteractiveHardwareHashDescription, Mode=OneWay}"
                            TextAlignment="Center"
                            TextWrapping="WrapWholeWords" />
                    </Grid>
                </Grid>
            </ContentControl>
        </ScrollView>
    </Grid>
</Page>
