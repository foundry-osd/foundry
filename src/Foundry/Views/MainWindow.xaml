<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="Foundry.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="using:Foundry.Services.Shell"
    mc:Ignorable="d">
    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <DataTemplate x:Key="OperationIndicatorTemplate">
                <Grid
                    Width="56"
                    Height="56"
                    HorizontalAlignment="Center">
                    <ProgressRing x:Name="OperationProgressRing"
                        Width="56"
                        Height="56"
                        IsActive="True" />
                    <FontIcon x:Name="OperationSuccessIcon"
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="56"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        Glyph="&#xE73E;"
                        Visibility="Collapsed" />
                    <FontIcon x:Name="OperationErrorIcon"
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="56"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Glyph="&#xEA39;"
                        Visibility="Collapsed" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar"
            MinHeight="48"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.png" />
            </TitleBar.IconSource>
        </TitleBar>
        <NavigationView x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            ItemInvoked="NavView_ItemInvoked">
            <NavigationView.Header>
                <BreadcrumbBar x:Name="Breadcrumbs"
                    ItemClicked="Breadcrumbs_ItemClicked"
                    ItemsSource="{x:Bind NavigationService.Breadcrumbs, Mode=OneWay}">
                    <BreadcrumbBar.ItemTemplate>
                        <DataTemplate x:DataType="shell:BreadcrumbEntry">
                            <TextBlock
                                Style="{StaticResource TitleTextBlockStyle}"
                                Text="{x:Bind Label}" />
                        </DataTemplate>
                    </BreadcrumbBar.ItemTemplate>
                </BreadcrumbBar>
            </NavigationView.Header>
            <Frame x:Name="NavFrame" />
        </NavigationView>
    </Grid>
</Window>

