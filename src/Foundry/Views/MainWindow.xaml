<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="Foundry.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="using:Foundry.Services.Shell"
    mc:Ignorable="d">
    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <DataTemplate x:Key="UpdateFooterContentTemplate">
                <Grid
                    Loaded="OnUpdateFooterContentLoaded"
                    Unloaded="OnUpdateFooterContentUnloaded">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="20"
                        Glyph="{Binding UpdateFooterGlyph, Mode=OneWay}" />
                    <TextBlock x:Name="UpdateFooterLabel"
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        Text="{Binding UpdateFooterTitle, Mode=OneWay}" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar"
            MinHeight="48"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.png" />
            </TitleBar.IconSource>
        </TitleBar>
        <NavigationView x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            ItemInvoked="NavView_ItemInvoked">
            <NavigationView.Header>
                <BreadcrumbBar x:Name="Breadcrumbs"
                    ItemClicked="Breadcrumbs_ItemClicked"
                    ItemsSource="{x:Bind NavigationService.Breadcrumbs, Mode=OneWay}">
                    <BreadcrumbBar.ItemTemplate>
                        <DataTemplate x:DataType="shell:BreadcrumbEntry">
                            <TextBlock
                                Style="{StaticResource TitleTextBlockStyle}"
                                Text="{x:Bind Label}" />
                        </DataTemplate>
                    </BreadcrumbBar.ItemTemplate>
                </BreadcrumbBar>
            </NavigationView.Header>
            <Frame x:Name="NavFrame" />
        </NavigationView>
    </Grid>
</Window>

