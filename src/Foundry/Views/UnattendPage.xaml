<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Foundry.Views.UnattendPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Foundry.Controls"
    xmlns:viewModels="using:Foundry.ViewModels"
    xmlns:wct="using:CommunityToolkit.WinUI.Controls">
    <ScrollView
        Margin="{ThemeResource ContentPageMargin}"
        Padding="{ThemeResource ContentPagePadding}"
        HorizontalContentAlignment="Stretch"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="{ThemeResource FoundrySettingsSectionSpacing}">
            <controls:PageHeader
                Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}"
                Description="{x:Bind ViewModel.PageDescription, Mode=OneWay}"
                IconGlyph="&#xE8A5;" />

            <wct:SettingsCard
                Description="{x:Bind ViewModel.EnableDescription, Mode=OneWay}"
                Header="{x:Bind ViewModel.EnableLabel, Mode=OneWay}">
                <ToggleSwitch
                    AutomationProperties.Name="{x:Bind ViewModel.EnableLabel, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.CanImport, Mode=OneWay}"
                    IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}" />
            </wct:SettingsCard>

            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind ViewModel.ProtectionDescription, Mode=OneWay}"
                Severity="Informational" />
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasReadinessIssue, Mode=OneWay}"
                Message="{x:Bind ViewModel.ReadinessMessage, Mode=OneWay}"
                Severity="Error" />
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="Warning" />

            <wct:SettingsCard
                HorizontalContentAlignment="Stretch"
                Description="{x:Bind ViewModel.CatalogDescription, Mode=OneWay}"
                Header="{x:Bind ViewModel.CatalogLabel, Mode=OneWay}">
                <StackPanel Spacing="{ThemeResource FoundrySettingsSectionSpacing}">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="{ThemeResource FoundryInlineControlSpacing}">
                        <Button
                            Command="{x:Bind ViewModel.ImportFilesCommand}"
                            Content="{x:Bind ViewModel.ImportLabel, Mode=OneWay}" />
                        <Button
                            Command="{x:Bind ViewModel.RefreshFileCommand}"
                            Content="{x:Bind ViewModel.RefreshLabel, Mode=OneWay}" />
                        <Button
                            Command="{x:Bind ViewModel.RefreshSourcesCommand}"
                            Content="{x:Bind ViewModel.CheckSourcesLabel, Mode=OneWay}" />
                        <Button
                            Command="{x:Bind ViewModel.RemoveFileCommand}"
                            Content="{x:Bind ViewModel.RemoveLabel, Mode=OneWay}" />
                        <ProgressRing
                            Width="{ThemeResource FoundryIconSizeDefault}"
                            Height="{ThemeResource FoundryIconSizeDefault}"
                            IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    </StackPanel>

                    <ListView
                        MaxHeight="{ThemeResource FoundryTableMaxHeight}"
                        AutomationProperties.Name="{x:Bind ViewModel.CatalogLabel, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanImport, Mode=OneWay}"
                        ItemsSource="{x:Bind ViewModel.Files}"
                        SelectedItem="{x:Bind ViewModel.SelectedFile, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:UnattendFileEntryViewModel">
                                <StackPanel
                                    Padding="0,8"
                                    Spacing="4">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{x:Bind DisplayName}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind SourcePath}"
                                        TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind ArchitectureText}" />
                                    <TextBlock
                                        Text="{x:Bind ValidationMessage}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid ColumnSpacing="{ThemeResource FoundryInlineControlSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Header="{x:Bind ViewModel.DisplayNameLabel, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                            MaxLength="120"
                            Text="{x:Bind ViewModel.RenameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Command="{x:Bind ViewModel.RenameFileCommand}"
                            Content="{x:Bind ViewModel.RenameLabel, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </wct:SettingsCard>

            <wct:SettingsCard
                Description="{x:Bind ViewModel.DefaultDescription, Mode=OneWay}"
                Header="{x:Bind ViewModel.DefaultLabel, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.CanImport, Mode=OneWay}">
                <ComboBox
                    Width="{ThemeResource FoundryWideInputMinWidth}"
                    AutomationProperties.Name="{x:Bind ViewModel.DefaultLabel, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.DefaultOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedDefault, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:UnattendDefaultOption">
                            <TextBlock Text="{x:Bind DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </wct:SettingsCard>

            <TextBlock
                Text="{x:Bind ViewModel.OwnershipDescription, Mode=OneWay}"
                TextWrapping="Wrap" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.CompatibilityDescription, Mode=OneWay}"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollView>
</Page>
