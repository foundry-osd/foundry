<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Foundry.Views.PostInstallationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Foundry.Behaviors"
    xmlns:controls="using:Foundry.Controls"
    xmlns:tv="using:WinUI.TableView">
    <ScrollView
        Margin="{ThemeResource ContentPageMargin}"
        Padding="{ThemeResource ContentPagePadding}"
        HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="{ThemeResource FoundrySettingsSectionSpacing}">
            <controls:PageHeader
                Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}"
                Description="{x:Bind ViewModel.PageDescription, Mode=OneWay}"
                DocumentationUrl="{x:Bind ViewModel.DocumentationUrl, Mode=OneWay}"
                IconGlyph="&#xE90F;"
                Warning="{x:Bind ViewModel.PxeWarning, Mode=OneWay}">
                <controls:PageHeader.ActionContent>
                    <ToggleSwitch
                        behaviors:LocalizedToggleSwitch.UseLocalizedStateContent="True"
                        AutomationProperties.Name="{x:Bind ViewModel.EnableLabel, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanChangeEnabled, Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}"
                        Style="{StaticResource FoundryPageHeaderToggleSwitchStyle}" />
                </controls:PageHeader.ActionContent>
            </controls:PageHeader>
            <ContentControl
                HorizontalContentAlignment="Stretch"
                IsEnabled="{x:Bind ViewModel.CanConfigure, Mode=OneWay}">
                <StackPanel Spacing="{ThemeResource FoundryContentGroupSpacing}">
                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasReadinessIssue, Mode=OneWay}"
                        Message="{x:Bind ViewModel.ReadinessDescription, Mode=OneWay}"
                        Severity="Warning"
                        Visibility="{x:Bind ViewModel.HasReadinessIssue, Mode=OneWay}" />
                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                        Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                        Severity="Error"
                        Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay}" />
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Enabled"
                        IsTabStop="False"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled">
                        <CommandBar
                            HorizontalAlignment="Left"
                            DefaultLabelPosition="Right"
                            IsDynamicOverflowEnabled="False"
                            OverflowButtonVisibility="Collapsed">
                            <CommandBar.PrimaryCommands>
                                <AppBarButton
                                    Icon="Add"
                                    Label="{x:Bind ViewModel.AddLabel, Mode=OneWay}">
                                    <AppBarButton.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem
                                                Click="OnAddClick"
                                                IsEnabled="{x:Bind ViewModel.CanConfigure, Mode=OneWay}"
                                                Tag="PowerShell"
                                                Text="{x:Bind ViewModel.PowerShellLabel, Mode=OneWay}" />
                                            <MenuFlyoutItem
                                                Click="OnAddClick"
                                                IsEnabled="{x:Bind ViewModel.CanConfigure, Mode=OneWay}"
                                                Tag="Command"
                                                Text="{x:Bind ViewModel.CommandLabel, Mode=OneWay}" />
                                            <MenuFlyoutItem
                                                Click="OnAddClick"
                                                IsEnabled="{x:Bind ViewModel.CanConfigure, Mode=OneWay}"
                                                Tag="Application"
                                                Text="{x:Bind ViewModel.ApplicationLabel, Mode=OneWay}" />
                                            <MenuFlyoutItem
                                                Click="OnAddClick"
                                                IsEnabled="{x:Bind ViewModel.CanConfigure, Mode=OneWay}"
                                                Tag="Restart"
                                                Text="{x:Bind ViewModel.RestartLabel, Mode=OneWay}" />
                                        </MenuFlyout>
                                    </AppBarButton.Flyout>
                                </AppBarButton>
                                <AppBarButton
                                    Click="OnEditClick"
                                    Icon="Edit"
                                    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                    Label="{x:Bind ViewModel.EditLabel, Mode=OneWay}" />
                                <AppBarButton
                                    Command="{x:Bind ViewModel.RemoveCommand}"
                                    Icon="Delete"
                                    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                    Label="{x:Bind ViewModel.RemoveLabel, Mode=OneWay}" />
                                <AppBarSeparator />
                                <AppBarButton
                                    Command="{x:Bind ViewModel.ToggleCommand}"
                                    Icon="Accept"
                                    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                    Label="{x:Bind ViewModel.ToggleLabel, Mode=OneWay}" />
                                <AppBarButton
                                    Command="{x:Bind ViewModel.MoveUpCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanMoveUp, Mode=OneWay}"
                                    Label="{x:Bind ViewModel.MoveUpLabel, Mode=OneWay}">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE70E;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton
                                    Command="{x:Bind ViewModel.MoveDownCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanMoveDown, Mode=OneWay}"
                                    Label="{x:Bind ViewModel.MoveDownLabel, Mode=OneWay}">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE70D;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton
                                    Command="{x:Bind ViewModel.RefreshCommand}"
                                    Icon="Refresh"
                                    Label="{x:Bind ViewModel.RefreshLabel, Mode=OneWay}" />
                            </CommandBar.PrimaryCommands>
                        </CommandBar>
                    </ScrollViewer>
                    <TextBlock
                        Style="{ThemeResource FoundrySecondaryBodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}"
                        TextWrapping="WrapWholeWords"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
                    <!--  Rows are listed in execution order, so this table is not sortable.  -->
                    <tv:TableView x:Name="ActionsTable"
                        MaxHeight="{ThemeResource FoundryTableMaxHeight}"
                        AutoGenerateColumns="False"
                        AutomationProperties.Name="{x:Bind ViewModel.PageTitle, Mode=OneWay}"
                        CanFilterColumns="False"
                        CanReorderColumns="False"
                        CanResizeColumns="False"
                        CanSortColumns="False"
                        CornerButtonMode="None"
                        HeadersVisibility="Columns"
                        IsReadOnly="True"
                        ItemsSource="{x:Bind ViewModel.Actions}"
                        SelectedItem="{x:Bind ViewModel.SelectedAction, Mode=TwoWay}"
                        SelectionMode="Single"
                        SelectionUnit="Row"
                        ShowExportOptions="False"
                        Visibility="{x:Bind ViewModel.HasActions, Mode=OneWay}">
                        <tv:TableView.Columns>
                            <tv:TableViewTextColumn
                                Width="*"
                                Binding="{Binding Position}"
                                Header="{x:Bind ViewModel.OrderHeader, Mode=OneWay}" />
                            <tv:TableViewTextColumn
                                Width="4*"
                                Binding="{Binding Name}"
                                Header="{x:Bind ViewModel.NameHeader, Mode=OneWay}" />
                            <tv:TableViewTextColumn
                                Width="2*"
                                Binding="{Binding Type}"
                                Header="{x:Bind ViewModel.TypeHeader, Mode=OneWay}" />
                            <tv:TableViewTemplateColumn
                                Width="*"
                                Header="{x:Bind ViewModel.EnabledHeader, Mode=OneWay}">
                                <tv:TableViewTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Margin="12,0,12,0"
                                            Style="{Binding EnabledStyle}"
                                            Text="{Binding Enabled}"
                                            TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </tv:TableViewTemplateColumn.CellTemplate>
                            </tv:TableViewTemplateColumn>
                            <tv:TableViewTemplateColumn
                                Width="2*"
                                Header="{x:Bind ViewModel.ContentStatusHeader, Mode=OneWay}">
                                <tv:TableViewTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Margin="12,0,12,0"
                                            Style="{Binding ReadinessStyle}"
                                            Text="{Binding Readiness}"
                                            TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </tv:TableViewTemplateColumn.CellTemplate>
                            </tv:TableViewTemplateColumn>
                        </tv:TableView.Columns>
                    </tv:TableView>
                </StackPanel>
            </ContentControl>
        </StackPanel>
    </ScrollView>
</Page>
