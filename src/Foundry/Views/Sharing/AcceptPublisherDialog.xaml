<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="Foundry.Views.AcceptPublisherDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{x:Bind ViewModel.Title, Mode=OneWay}"
    CloseButtonClick="OnCloseButtonClick"
    CloseButtonStyle="{ThemeResource DefaultButtonStyle}"
    CloseButtonText="{x:Bind ViewModel.CancelLabel, Mode=OneWay}"
    Closing="OnClosing"
    CornerRadius="{ThemeResource OverlayCornerRadius}"
    DefaultButton="Close"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanAccept, Mode=OneWay}"
    PrimaryButtonClick="OnPrimaryButtonClick"
    PrimaryButtonStyle="{ThemeResource AccentButtonStyle}"
    PrimaryButtonText="{x:Bind ViewModel.AcceptLabel, Mode=OneWay}"
    Style="{ThemeResource DefaultContentDialogStyle}">
    <StackPanel
        Width="520"
        Padding="0,4,0,8"
        Spacing="{ThemeResource FoundryContentGroupSpacing}">
        <TextBlock
            Text="{x:Bind ViewModel.DescriptionText, Mode=OneWay}"
            TextWrapping="Wrap" />
        <Grid
            ColumnSpacing="{ThemeResource FoundryInlineControlSpacing}"
            RowSpacing="{ThemeResource FoundryTextGroupSpacing}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.PreviousKeyLabel, Mode=OneWay}" />
            <TextBlock
                Grid.Column="1"
                FlowDirection="LeftToRight"
                FontFamily="Consolas"
                IsTextSelectionEnabled="True"
                Text="{x:Bind ViewModel.PreviousKey}"
                TextWrapping="Wrap" />
            <TextBlock
                Grid.Row="1"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.NewKeyLabel, Mode=OneWay}" />
            <TextBlock
                Grid.Row="1"
                Grid.Column="1"
                FlowDirection="LeftToRight"
                FontFamily="Consolas"
                IsTextSelectionEnabled="True"
                Text="{x:Bind ViewModel.NewKey, Mode=OneWay}"
                TextWrapping="Wrap" />
            <TextBlock
                Grid.Row="2"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.VersionLabel, Mode=OneWay}" />
            <TextBlock
                Grid.Row="2"
                Grid.Column="1"
                Text="{x:Bind ViewModel.NewVersion, Mode=OneWay}" />
        </Grid>
        <ProgressBar
            IsIndeterminate="True"
            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        <InfoBar
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasWarning, Mode=OneWay}"
            Message="{x:Bind ViewModel.WarningMessage, Mode=OneWay}"
            Severity="Warning"
            Visibility="{x:Bind ViewModel.HasWarning, Mode=OneWay}" />
        <InfoBar
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error"
            Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />
    </StackPanel>
</ContentDialog>
