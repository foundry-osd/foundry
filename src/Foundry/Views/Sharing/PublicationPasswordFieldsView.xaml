<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Foundry.Views.PublicationPasswordFieldsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="{ThemeResource FoundryContentGroupSpacing}">
        <StackPanel Spacing="{ThemeResource FoundryTextGroupSpacing}">
            <Grid ColumnSpacing="{ThemeResource FoundryInlineControlSpacing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <PasswordBox
                    Header="{x:Bind Fields.PasswordLabel, Mode=OneWay}"
                    IsEnabled="{x:Bind IsEditable, Mode=OneWay}"
                    MaxLength="1024"
                    Password="{x:Bind Fields.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PasswordRevealMode="{x:Bind RevealMode(Fields.IsRevealed), Mode=OneWay}" />
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind Fields.GenerateCommand}"
                    Content="{x:Bind Fields.GenerateLabel, Mode=OneWay}"
                    IsEnabled="{x:Bind IsEditable, Mode=OneWay}"
                    Style="{ThemeResource DefaultButtonStyle}" />
                <Button
                    Grid.Column="2"
                    VerticalAlignment="Bottom"
                    Click="OnCopyClick"
                    Content="{x:Bind Fields.CopyLabel, Mode=OneWay}"
                    IsEnabled="{x:Bind CanCopy(IsEditable, Fields.CanCopy), Mode=OneWay}"
                    Style="{ThemeResource DefaultButtonStyle}" />
            </Grid>
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource FoundryCaptionTextBlockStyle}"
                Text="{x:Bind Fields.RuleText, Mode=OneWay}"
                TextWrapping="WrapWholeWords" />
            <TextBlock
                AutomationProperties.LiveSetting="Polite"
                Style="{ThemeResource FoundryCaptionTextBlockStyle}"
                Text="{x:Bind Fields.CopiedText, Mode=OneWay}"
                TextWrapping="WrapWholeWords"
                Visibility="{x:Bind Fields.IsCopied, Mode=OneWay}" />
        </StackPanel>
        <StackPanel Spacing="{ThemeResource FoundryTextGroupSpacing}">
            <PasswordBox
                Header="{x:Bind Fields.ConfirmationLabel, Mode=OneWay}"
                IsEnabled="{x:Bind IsEditable, Mode=OneWay}"
                MaxLength="1024"
                Password="{x:Bind Fields.Confirmation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                PasswordRevealMode="{x:Bind RevealMode(Fields.IsRevealed), Mode=OneWay}" />
            <TextBlock
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{ThemeResource FoundryCaptionTextBlockStyle}"
                Text="{x:Bind Fields.ValidationMessage, Mode=OneWay}"
                TextWrapping="WrapWholeWords"
                Visibility="{x:Bind Fields.HasValidationMessage, Mode=OneWay}" />
        </StackPanel>
    </StackPanel>
</UserControl>
