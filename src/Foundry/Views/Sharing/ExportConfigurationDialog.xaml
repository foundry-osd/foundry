<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="Foundry.Views.ExportConfigurationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{x:Bind ViewModel.Title, Mode=OneWay}"
    CloseButtonClick="OnCloseButtonClick"
    CloseButtonStyle="{ThemeResource DefaultButtonStyle}"
    CloseButtonText="{x:Bind ViewModel.CancelLabel, Mode=OneWay}"
    Closing="OnClosing"
    CornerRadius="{ThemeResource OverlayCornerRadius}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanExport, Mode=OneWay}"
    PrimaryButtonClick="OnPrimaryButtonClick"
    PrimaryButtonStyle="{ThemeResource AccentButtonStyle}"
    PrimaryButtonText="{x:Bind ViewModel.ExportLabel, Mode=OneWay}"
    Style="{ThemeResource DefaultContentDialogStyle}">
    <StackPanel
        Width="480"
        Padding="0,4,0,8"
        Spacing="{ThemeResource FoundryContentGroupSpacing}">
        <TextBlock
            Text="{x:Bind ViewModel.DescriptionText, Mode=OneWay}"
            TextWrapping="Wrap" />
        <StackPanel Spacing="{ThemeResource FoundryTextGroupSpacing}">
            <Grid ColumnSpacing="{ThemeResource FoundryInlineControlSpacing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <PasswordBox
                    Header="{x:Bind ViewModel.PassphraseLabel, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                    MaxLength="1024"
                    Password="{x:Bind ViewModel.Passphrase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PasswordRevealMode="{x:Bind RevealMode(ViewModel.IsPassphraseRevealed), Mode=OneWay}" />
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.GenerateCommand}"
                    Content="{x:Bind ViewModel.GenerateLabel, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                    Style="{ThemeResource DefaultButtonStyle}" />
                <Button
                    Grid.Column="2"
                    VerticalAlignment="Bottom"
                    Click="OnCopyClick"
                    Content="{x:Bind ViewModel.CopyLabel, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.CanCopy, Mode=OneWay}"
                    Style="{ThemeResource DefaultButtonStyle}" />
            </Grid>
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource FoundryCaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.RuleText, Mode=OneWay}"
                TextWrapping="WrapWholeWords" />
            <TextBlock
                AutomationProperties.LiveSetting="Polite"
                Style="{ThemeResource FoundryCaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.CopiedText, Mode=OneWay}"
                TextWrapping="WrapWholeWords"
                Visibility="{x:Bind ViewModel.IsCopied, Mode=OneWay}" />
        </StackPanel>
        <StackPanel Spacing="{ThemeResource FoundryTextGroupSpacing}">
            <PasswordBox
                Header="{x:Bind ViewModel.ConfirmationLabel, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                MaxLength="1024"
                Password="{x:Bind ViewModel.Confirmation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                PasswordRevealMode="{x:Bind RevealMode(ViewModel.IsPassphraseRevealed), Mode=OneWay}" />
            <TextBlock
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{ThemeResource FoundryCaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}"
                TextWrapping="WrapWholeWords"
                Visibility="{x:Bind ViewModel.HasValidationMessage, Mode=OneWay}" />
        </StackPanel>
        <StackPanel Spacing="{ThemeResource FoundryTextGroupSpacing}">
            <CheckBox
                Content="{x:Bind ViewModel.IncludePasswordsLabel, Mode=OneWay}"
                IsChecked="{x:Bind ViewModel.IncludePasswords, Mode=TwoWay}"
                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
            <TextBlock
                AutomationProperties.LiveSetting="Polite"
                Style="{ThemeResource FoundryCaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.IncludePasswordsWarning, Mode=OneWay}"
                TextWrapping="WrapWholeWords"
                Visibility="{x:Bind ViewModel.IncludePasswords, Mode=OneWay}" />
        </StackPanel>
        <ProgressBar
            IsIndeterminate="True"
            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        <InfoBar
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error"
            Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />
    </StackPanel>
</ContentDialog>
