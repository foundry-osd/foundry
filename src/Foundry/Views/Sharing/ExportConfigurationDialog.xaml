<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="Foundry.Views.ExportConfigurationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Foundry.Views"
    Title="{x:Bind ViewModel.Title, Mode=OneWay}"
    CloseButtonClick="OnCloseButtonClick"
    CloseButtonStyle="{ThemeResource DefaultButtonStyle}"
    CloseButtonText="{x:Bind ViewModel.CancelLabel, Mode=OneWay}"
    Closing="OnClosing"
    CornerRadius="{ThemeResource OverlayCornerRadius}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanExport, Mode=OneWay}"
    PrimaryButtonClick="OnPrimaryButtonClick"
    PrimaryButtonStyle="{ThemeResource AccentButtonStyle}"
    PrimaryButtonText="{x:Bind ViewModel.ExportLabel, Mode=OneWay}"
    Style="{ThemeResource DefaultContentDialogStyle}">
    <StackPanel
        Width="{StaticResource FoundryDialogContentWidth}"
        Padding="0,4,0,8"
        Spacing="{ThemeResource FoundryContentGroupSpacing}">
        <TextBlock
            Text="{x:Bind ViewModel.DescriptionText, Mode=OneWay}"
            TextWrapping="Wrap" />
        <views:NewSecretFieldsView
            Fields="{x:Bind ViewModel.Fields}"
            IsEditable="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
        <StackPanel Spacing="{ThemeResource FoundryTextGroupSpacing}">
            <CheckBox
                Content="{x:Bind ViewModel.IncludePasswordsLabel, Mode=OneWay}"
                IsChecked="{x:Bind ViewModel.IncludePasswords, Mode=TwoWay}"
                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
            <TextBlock
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                Style="{ThemeResource FoundryCaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.IncludePasswordsWarning, Mode=OneWay}"
                TextWrapping="WrapWholeWords"
                Visibility="{x:Bind ViewModel.IncludePasswords, Mode=OneWay}" />
        </StackPanel>
        <ProgressBar
            IsIndeterminate="True"
            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        <InfoBar
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error"
            Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />
        <InfoBar
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasWarning, Mode=OneWay}"
            Message="{x:Bind ViewModel.WarningMessage, Mode=OneWay}"
            Severity="Warning"
            Visibility="{x:Bind ViewModel.HasWarning, Mode=OneWay}" />
    </StackPanel>
</ContentDialog>
