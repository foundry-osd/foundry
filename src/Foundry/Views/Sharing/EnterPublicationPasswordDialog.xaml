<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="Foundry.Views.EnterPublicationPasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{x:Bind ViewModel.Title, Mode=OneWay}"
    CloseButtonClick="OnCloseButtonClick"
    CloseButtonStyle="{ThemeResource DefaultButtonStyle}"
    CloseButtonText="{x:Bind ViewModel.CancelLabel, Mode=OneWay}"
    Closing="OnClosing"
    CornerRadius="{ThemeResource OverlayCornerRadius}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanSubmit, Mode=OneWay}"
    PrimaryButtonClick="OnPrimaryButtonClick"
    PrimaryButtonStyle="{ThemeResource AccentButtonStyle}"
    PrimaryButtonText="{x:Bind ViewModel.SubmitLabel, Mode=OneWay}"
    Style="{ThemeResource DefaultContentDialogStyle}">
    <StackPanel
        Width="440"
        Padding="0,4,0,8"
        Spacing="{ThemeResource FoundryContentGroupSpacing}">
        <TextBlock
            Text="{x:Bind ViewModel.DescriptionText, Mode=OneWay}"
            TextWrapping="Wrap" />
        <PasswordBox
            Header="{x:Bind ViewModel.PasswordLabel, Mode=OneWay}"
            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
            MaxLength="1024"
            Password="{x:Bind ViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <ProgressBar
            IsIndeterminate="True"
            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        <InfoBar
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error"
            Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />
    </StackPanel>
</ContentDialog>
