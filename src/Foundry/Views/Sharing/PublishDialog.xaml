<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="Foundry.Views.PublishDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Foundry.Views"
    Title="{x:Bind ViewModel.Title, Mode=OneWay}"
    CloseButtonClick="OnCloseButtonClick"
    CloseButtonStyle="{ThemeResource DefaultButtonStyle}"
    CloseButtonText="{x:Bind ViewModel.CancelLabel, Mode=OneWay}"
    Closing="OnClosing"
    CornerRadius="{ThemeResource OverlayCornerRadius}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanPublish, Mode=OneWay}"
    PrimaryButtonClick="OnPrimaryButtonClick"
    PrimaryButtonStyle="{ThemeResource AccentButtonStyle}"
    PrimaryButtonText="{x:Bind ViewModel.PublishLabel, Mode=OneWay}"
    Style="{ThemeResource DefaultContentDialogStyle}">
    <StackPanel
        Width="{StaticResource FoundryDialogContentWidth}"
        Padding="0,4,0,8"
        Spacing="{ThemeResource FoundryContentGroupSpacing}">
        <TextBlock
            Text="{x:Bind ViewModel.DescriptionText, Mode=OneWay}"
            TextWrapping="Wrap" />
        <Grid ColumnSpacing="{ThemeResource FoundryInlineControlSpacing}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                FlowDirection="LeftToRight"
                Header="{x:Bind ViewModel.FolderLabel, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                Text="{x:Bind ViewModel.Folder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Command="{x:Bind ViewModel.BrowseCommand}"
                Content="{x:Bind ViewModel.BrowseLabel, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                Style="{ThemeResource DefaultButtonStyle}" />
        </Grid>
        <views:PublicationPasswordFieldsView
            Fields="{x:Bind ViewModel.Fields}"
            IsEditable="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
        <StackPanel Spacing="{ThemeResource FoundryTextGroupSpacing}">
            <CheckBox
                Content="{x:Bind ViewModel.IncludePasswordsLabel, Mode=OneWay}"
                IsChecked="{x:Bind ViewModel.IncludePasswords, Mode=TwoWay}"
                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
            <TextBlock
                AutomationProperties.LiveSetting="Polite"
                Style="{ThemeResource FoundryCaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.IncludePasswordsWarning, Mode=OneWay}"
                TextWrapping="WrapWholeWords"
                Visibility="{x:Bind ViewModel.IncludePasswords, Mode=OneWay}" />
        </StackPanel>
        <StackPanel
            Spacing="{ThemeResource FoundryTextGroupSpacing}"
            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
            <Grid ColumnSpacing="{ThemeResource FoundryContentGroupSpacing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    Text="{x:Bind ViewModel.Progress.StageText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind ViewModel.Progress.StageText, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="1"
                    MinWidth="40"
                    AutomationProperties.AccessibilityView="Raw"
                    Text="{x:Bind ViewModel.Progress.PercentText, Mode=OneWay}"
                    TextAlignment="Right" />
            </Grid>
            <ProgressBar
                IsIndeterminate="{x:Bind ViewModel.Progress.IsIndeterminate, Mode=OneWay}"
                Maximum="100"
                Minimum="0"
                Value="{x:Bind ViewModel.Progress.Percent, Mode=OneWay}" />
        </StackPanel>
        <InfoBar
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error"
            Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />
    </StackPanel>
</ContentDialog>
