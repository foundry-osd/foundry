<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="Foundry.Views.ImportConfigurationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:legacy="using:Foundry.Core.Services.Configuration.Legacy"
    xmlns:viewModels="using:Foundry.ViewModels"
    Title="{x:Bind ViewModel.Title, Mode=OneWay}"
    CloseButtonClick="OnCloseButtonClick"
    CloseButtonStyle="{ThemeResource DefaultButtonStyle}"
    CloseButtonText="{x:Bind ViewModel.CancelLabel, Mode=OneWay}"
    Closing="OnClosing"
    CornerRadius="{ThemeResource OverlayCornerRadius}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanImport, Mode=OneWay}"
    PrimaryButtonClick="OnPrimaryButtonClick"
    PrimaryButtonStyle="{ThemeResource AccentButtonStyle}"
    PrimaryButtonText="{x:Bind ViewModel.ImportLabel, Mode=OneWay}"
    Style="{ThemeResource DefaultContentDialogStyle}">
    <StackPanel
        Width="520"
        Padding="0,4,0,8"
        Spacing="{ThemeResource FoundryContentGroupSpacing}">
        <Grid ColumnSpacing="{ThemeResource FoundryInlineControlSpacing}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                FlowDirection="LeftToRight"
                Header="{x:Bind ViewModel.FileLabel, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                IsReadOnly="True"
                Text="{x:Bind ViewModel.FilePath, Mode=OneWay}" />
            <Button
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Command="{x:Bind ViewModel.BrowseCommand}"
                Content="{x:Bind ViewModel.BrowseLabel, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                Style="{ThemeResource DefaultButtonStyle}" />
        </Grid>
        <Grid ColumnSpacing="{ThemeResource FoundryInlineControlSpacing}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <PasswordBox
                Header="{x:Bind ViewModel.PassphraseLabel, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                MaxLength="1024"
                Password="{x:Bind ViewModel.Passphrase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Command="{x:Bind ViewModel.OpenFileCommand}"
                Content="{x:Bind ViewModel.OpenLabel, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.CanOpenFile, Mode=OneWay}"
                Style="{ThemeResource DefaultButtonStyle}" />
        </Grid>
        <StackPanel
            Spacing="{ThemeResource FoundryTextGroupSpacing}"
            Visibility="{x:Bind ViewModel.HasLegacyProfiles, Mode=OneWay}">
            <TextBlock
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.PreviousVersionProfilesLabel, Mode=OneWay}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource FoundryCaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.PreviousVersionProfilesHint, Mode=OneWay}"
                TextWrapping="WrapWholeWords" />
            <Grid ColumnSpacing="{ThemeResource FoundryInlineControlSpacing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ListView
                    MaxHeight="160"
                    AutomationProperties.Name="{x:Bind ViewModel.PreviousVersionProfilesLabel, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.LegacyProfiles}"
                    SelectedItem="{x:Bind ViewModel.SelectedLegacyProfile, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="legacy:LegacyLocalProfile">
                            <TextBlock
                                Text="{x:Bind DisplayName}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind DisplayName}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    Command="{x:Bind ViewModel.OpenLegacyProfileCommand}"
                    Content="{x:Bind ViewModel.OpenLabel, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.CanOpenLegacyProfile, Mode=OneWay}"
                    Style="{ThemeResource DefaultButtonStyle}" />
            </Grid>
        </StackPanel>
        <ProgressBar
            IsIndeterminate="True"
            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        <InfoBar
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error"
            Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />
        <StackPanel
            Spacing="{ThemeResource FoundryContentGroupSpacing}"
            Visibility="{x:Bind ViewModel.HasPreview, Mode=OneWay}">
            <Grid
                ColumnSpacing="{ThemeResource FoundryInlineControlSpacing}"
                RowSpacing="{ThemeResource FoundryTextGroupSpacing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.NameLabel, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind ViewModel.PreviewName, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Grid.Row="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.CreatedLabel, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasPreviewCreated, Mode=OneWay}" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="{x:Bind ViewModel.PreviewCreated, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasPreviewCreated, Mode=OneWay}" />
                <TextBlock
                    Grid.Row="2"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.PasswordsLabel, Mode=OneWay}" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="1"
                    Text="{x:Bind ViewModel.PreviewPasswords, Mode=OneWay}" />
            </Grid>
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsLegacyConnectionFile, Mode=OneWay}"
                Message="{x:Bind ViewModel.LegacySyncRetiredText, Mode=OneWay}"
                Severity="Informational"
                Visibility="{x:Bind ViewModel.IsLegacyConnectionFile, Mode=OneWay}" />
            <StackPanel
                Spacing="{ThemeResource FoundryTextGroupSpacing}"
                Visibility="{x:Bind ViewModel.HasMissingContent, Mode=OneWay}">
                <TextBlock
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.MissingContentHeader, Mode=OneWay}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource FoundryCaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.MissingContentGuidance, Mode=OneWay}"
                    TextWrapping="WrapWholeWords" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.MissingContent}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:MissingContentItem">
                            <Grid ColumnSpacing="{ThemeResource FoundryInlineControlSpacing}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind KindText}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind Name}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind ViewModel.ReplaceWarning, Mode=OneWay}"
                Severity="Warning" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
