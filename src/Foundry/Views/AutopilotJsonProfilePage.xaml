<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Foundry.Views.AutopilotJsonProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Foundry.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tv="using:WinUI.TableView"
    mc:Ignorable="d">
    <ScrollView
        Margin="{ThemeResource ContentPageMargin}"
        Padding="{ThemeResource ContentPagePadding}"
        HorizontalContentAlignment="Stretch"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            HorizontalAlignment="Stretch"
            Spacing="{ThemeResource FoundrySettingsSectionSpacing}">
            <controls:PageHeader
                x:Uid="AutopilotJsonProfilePageHeader"
                DocumentationUrl="{x:Bind ViewModel.JsonProfileDocumentationUrl, Mode=OneWay}"
                IconGlyph="&#xE8A5;">
                <controls:PageHeader.ActionContent>
                    <Button
                        Click="OnModeActionClick"
                        Content="{x:Bind ViewModel.JsonProfileActionText, Mode=OneWay}" />
                </controls:PageHeader.ActionContent>
            </controls:PageHeader>

            <ContentControl
                HorizontalContentAlignment="Stretch"
                IsEnabled="{x:Bind ViewModel.IsJsonProfileActive, Mode=OneWay}">
                <StackPanel Spacing="{ThemeResource FoundryContentGroupSpacing}">
                    <Grid ColumnSpacing="{ThemeResource FoundryContentGroupSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ScrollViewer
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Enabled"
                            IsTabStop="False"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalScrollMode="Disabled">
                            <CommandBar
                                HorizontalAlignment="Left"
                                DefaultLabelPosition="Right"
                                IsDynamicOverflowEnabled="False"
                                OverflowButtonVisibility="Collapsed">
                                <CommandBar.PrimaryCommands>
                                    <AppBarButton
                                        Command="{x:Bind ViewModel.ImportProfileCommand}"
                                        Label="{x:Bind ViewModel.ImportButtonText, Mode=OneWay}">
                                        <AppBarButton.Icon>
                                            <FontIcon Glyph="&#xE710;" />
                                        </AppBarButton.Icon>
                                    </AppBarButton>
                                    <AppBarButton
                                        Command="{x:Bind ViewModel.DownloadProfilesCommand}"
                                        Label="{x:Bind ViewModel.DownloadButtonText, Mode=OneWay}">
                                        <AppBarButton.Icon>
                                            <FontIcon Glyph="&#xE896;" />
                                        </AppBarButton.Icon>
                                    </AppBarButton>
                                    <AppBarSeparator />
                                    <AppBarButton
                                        Command="{x:Bind ViewModel.SetDefaultProfileCommand}"
                                        Icon="Favorite"
                                        Label="{x:Bind ViewModel.SetDefaultProfileButtonText, Mode=OneWay}" />
                                    <AppBarButton
                                        Command="{x:Bind ViewModel.RemoveSelectedProfilesCommand}"
                                        Icon="Delete"
                                        Label="{x:Bind ViewModel.RemoveButtonText, Mode=OneWay}" />
                                </CommandBar.PrimaryCommands>
                            </CommandBar>
                        </ScrollViewer>

                        <Grid
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            ColumnSpacing="{ThemeResource FoundrySpace8}"
                            Visibility="{x:Bind ViewModel.BusyStatusVisibility, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ProgressRing
                                Width="{ThemeResource FoundryIconSizeDefault}"
                                Height="{ThemeResource FoundryIconSizeDefault}"
                                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{x:Bind ViewModel.BusyStatusText, Mode=OneWay}"
                                TextWrapping="WrapWholeWords" />
                        </Grid>
                    </Grid>

                    <TextBlock
                        Style="{ThemeResource FoundrySecondaryBodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.EmptyProfilesText, Mode=OneWay}"
                        TextWrapping="WrapWholeWords"
                        Visibility="{x:Bind ViewModel.EmptyProfilesVisibility, Mode=OneWay}" />
                    <tv:TableView x:Name="ProfilesTable"
                        MaxHeight="{ThemeResource FoundryTableMaxHeight}"
                        AutoGenerateColumns="False"
                        AutomationProperties.Name="{x:Bind ViewModel.ProfilesLabel, Mode=OneWay}"
                        CanFilterColumns="False"
                        CanReorderColumns="False"
                        CanResizeColumns="True"
                        CanSortColumns="True"
                        CornerButtonMode="None"
                        HeadersVisibility="Columns"
                        IsReadOnly="True"
                        ItemsSource="{x:Bind ViewModel.Profiles, Mode=OneWay}"
                        SelectionChanged="ProfilesTable_SelectionChanged"
                        SelectionMode="Multiple"
                        SelectionUnit="Row"
                        ShowExportOptions="False"
                        Visibility="{x:Bind ViewModel.ProfilesVisibility, Mode=OneWay}">
                        <tv:TableView.Columns>
                            <tv:TableViewTextColumn
                                Width="2*"
                                Binding="{Binding DisplayName}"
                                Header="{x:Bind ViewModel.ProfileNameColumnHeader, Mode=OneWay}" />
                            <tv:TableViewTextColumn
                                Width="*"
                                Binding="{Binding Source}"
                                Header="{x:Bind ViewModel.ProfileSourceColumnHeader, Mode=OneWay}" />
                            <tv:TableViewTextColumn
                                Width="*"
                                Binding="{Binding ImportedAtDisplay}"
                                Header="{x:Bind ViewModel.ProfileImportedColumnHeader, Mode=OneWay}"
                                SortMemberPath="ImportedAtUtc" />
                            <tv:TableViewTextColumn
                                Width="2*"
                                Binding="{Binding FolderName}"
                                Header="{x:Bind ViewModel.ProfileFolderColumnHeader, Mode=OneWay}" />
                            <tv:TableViewTextColumn
                                Width="*"
                                Binding="{Binding DefaultText}"
                                Header="{x:Bind ViewModel.ProfileDefaultColumnHeader, Mode=OneWay}" />
                        </tv:TableView.Columns>
                    </tv:TableView>
                </StackPanel>
            </ContentControl>
        </StackPanel>
    </ScrollView>
</Page>
