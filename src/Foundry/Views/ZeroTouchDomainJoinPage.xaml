<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Foundry.Views.ZeroTouchDomainJoinPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Foundry.Controls"
    xmlns:viewModels="using:Foundry.ViewModels"
    xmlns:wct="using:CommunityToolkit.WinUI.Controls">
    <ScrollView
        Margin="{ThemeResource ContentPageMargin}"
        Padding="{ThemeResource ContentPagePadding}"
        HorizontalContentAlignment="Stretch"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="{ThemeResource FoundrySettingsSectionSpacing}">
            <controls:PageHeader
                x:Uid="ZeroTouchDomainJoinPageHeader"
                DocumentationUrl="{x:Bind ViewModel.DocumentationUrl, Mode=OneWay}"
                IconGlyph="&#xE902;">
                <controls:PageHeader.ActionContent>
                    <Button
                        Command="{x:Bind ViewModel.ToggleModeCommand}"
                        Content="{x:Bind ViewModel.ActionText, Mode=OneWay}" />
                </controls:PageHeader.ActionContent>
            </controls:PageHeader>

            <ContentControl
                HorizontalContentAlignment="Stretch"
                IsEnabled="{x:Bind ViewModel.IsActive, Mode=OneWay}">
                <StackPanel Spacing="{ThemeResource FoundrySettingsSectionSpacing}">
                    <TextBlock
                        Text="{x:Bind ViewModel.ReadinessText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <wct:SettingsCard
                        x:Uid="DomainJoinTargetDomain"
                        HorizontalContentAlignment="Stretch">
                        <TextBox
                            MaxLength="253"
                            Text="{x:Bind ViewModel.DomainName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </wct:SettingsCard>
                    <wct:SettingsCard
                        x:Uid="DomainJoinCredentials"
                        HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="{ThemeResource FoundrySpace8}">
                            <TextBox
                                x:Uid="DomainJoinAccount"
                                MaxLength="512"
                                Text="{x:Bind ViewModel.AccountName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <PasswordBox x:Name="DomainPasswordBox"
                                x:Uid="DomainJoinPassword"
                                Loaded="OnPasswordLoaded"
                                MaxLength="2560"
                                PasswordChanged="OnPasswordChanged" />
                        </StackPanel>
                    </wct:SettingsCard>
                    <wct:SettingsCard
                        x:Uid="DomainJoinDestinationPolicy"
                        HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="{ThemeResource FoundrySpace8}">
                            <ComboBox
                                x:Uid="DomainJoinDefaultOu"
                                DisplayMemberPath="Hierarchy"
                                ItemsSource="{x:Bind ViewModel.OrganizationalUnits}"
                                SelectedItem="{x:Bind ViewModel.SelectedDefaultOu, Mode=TwoWay}" />
                            <Button
                                x:Uid="DomainJoinClearDefault"
                                Command="{x:Bind ViewModel.ClearDefaultCommand}" />
                            <CheckBox
                                x:Uid="DomainJoinAllowSelection"
                                IsChecked="{x:Bind ViewModel.AllowOuSelectionDuringDeployment, Mode=TwoWay}" />
                        </StackPanel>
                    </wct:SettingsCard>
                    <wct:SettingsCard
                        x:Uid="DomainJoinManualDestination"
                        HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="{ThemeResource FoundrySpace8}">
                            <TextBox
                                x:Uid="DomainJoinManualLabel"
                                MaxLength="120"
                                Text="{x:Bind ViewModel.ManualDisplayName, Mode=TwoWay}" />
                            <TextBox
                                x:Uid="DomainJoinManualDn"
                                MaxLength="4096"
                                Text="{x:Bind ViewModel.ManualDistinguishedName, Mode=TwoWay}" />
                            <Button
                                x:Uid="DomainJoinAdd"
                                Command="{x:Bind ViewModel.AddOrganizationalUnitCommand}" />
                        </StackPanel>
                    </wct:SettingsCard>
                    <ListView
                        MaxHeight="{ThemeResource FoundryTableMaxHeight}"
                        ItemsSource="{x:Bind ViewModel.OrganizationalUnits}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:DomainJoinOrganizationalUnitEntryViewModel">
                                <Grid ColumnSpacing="{ThemeResource FoundrySpace12}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind DisplayName}" />
                                        <TextBlock
                                            Text="{x:Bind Hierarchy}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Text="{x:Bind DistinguishedName}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button
                                        x:Uid="DomainJoinRemove"
                                        Grid.Column="1"
                                        Click="OnRemoveOuClick"
                                        Tag="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <wct:SettingsCard
                        x:Uid="DomainJoinDiscovery"
                        HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="{ThemeResource FoundrySpace8}">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="{ThemeResource FoundrySpace8}">
                                <Button
                                    x:Uid="DomainJoinDiscover"
                                    Command="{x:Bind ViewModel.DiscoverCommand}" />
                                <Button
                                    x:Uid="DomainJoinCancel"
                                    Command="{x:Bind ViewModel.CancelDiscoveryCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsDiscovering, Mode=OneWay}" />
                                <ProgressRing
                                    Width="24"
                                    Height="24"
                                    IsActive="{x:Bind ViewModel.IsDiscovering, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock
                                Text="{x:Bind ViewModel.PreviewDomainText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <ListView
                                MaxHeight="{ThemeResource FoundryTableMaxHeight}"
                                ItemsSource="{x:Bind ViewModel.PreviewUnits}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:DomainJoinOrganizationalUnitEntryViewModel">
                                        <StackPanel>
                                            <CheckBox
                                                Content="{x:Bind Hierarchy}"
                                                IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                            <TextBlock
                                                Text="{x:Bind DistinguishedName}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button
                                x:Uid="DomainJoinImportSelected"
                                Command="{x:Bind ViewModel.ImportSelectedCommand}" />
                        </StackPanel>
                    </wct:SettingsCard>
                </StackPanel>
            </ContentControl>
            <TextBlock
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                TextWrapping="Wrap" />

        </StackPanel>
    </ScrollView>
</Page>
