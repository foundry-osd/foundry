<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Foundry.Views.ZeroTouchDomainJoinPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Foundry.Behaviors"
    xmlns:controls="using:Foundry.Controls"
    xmlns:tv="using:WinUI.TableView"
    xmlns:wct="using:CommunityToolkit.WinUI.Controls">
    <ScrollView
        Margin="{ThemeResource ContentPageMargin}"
        Padding="{ThemeResource ContentPagePadding}"
        HorizontalContentAlignment="Stretch"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            HorizontalAlignment="Stretch"
            Spacing="{ThemeResource FoundrySettingsSectionSpacing}">
            <controls:PageHeader
                x:Uid="ZeroTouchDomainJoinPageHeader"
                DocumentationUrl="{x:Bind ViewModel.DocumentationUrl, Mode=OneWay}"
                IconGlyph="&#xF003;">
                <controls:PageHeader.ActionContent>
                    <Button
                        Command="{x:Bind ViewModel.ToggleModeCommand}"
                        Content="{x:Bind ViewModel.ActionText, Mode=OneWay}" />
                </controls:PageHeader.ActionContent>
            </controls:PageHeader>

            <ContentControl
                HorizontalContentAlignment="Stretch"
                IsEnabled="{x:Bind ViewModel.IsActive, Mode=OneWay}">
                <StackPanel Spacing="{ThemeResource FoundrySettingsSectionSpacing}">
                    <wct:SettingsCard
                        x:Uid="DomainJoinTargetDomain"
                        HorizontalContentAlignment="Stretch">
                        <wct:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE774;" />
                        </wct:SettingsCard.HeaderIcon>
                        <StackPanel
                            Width="{ThemeResource FoundryWideInputMinWidth}"
                            HorizontalAlignment="Right"
                            Spacing="{ThemeResource FoundrySpace4}">
                            <TextBox
                                x:Uid="DomainJoinDomainName"
                                Width="{ThemeResource FoundryWideInputMinWidth}"
                                MaxLength="253"
                                Text="{x:Bind ViewModel.DomainName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Text="{x:Bind ViewModel.DomainValidationMessage, Mode=OneWay}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{x:Bind ViewModel.DomainValidationVisibility, Mode=OneWay}" />
                        </StackPanel>
                    </wct:SettingsCard>

                    <wct:SettingsCard
                        x:Uid="DomainJoinCredentials"
                        HorizontalContentAlignment="Stretch">
                        <wct:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8D7;" />
                        </wct:SettingsCard.HeaderIcon>
                        <StackPanel
                            Width="{ThemeResource FoundryWideInputMinWidth}"
                            HorizontalAlignment="Right"
                            Spacing="{ThemeResource FoundrySpace8}">
                            <TextBox
                                x:Uid="DomainJoinAccount"
                                Width="{ThemeResource FoundryWideInputMinWidth}"
                                MaxLength="512"
                                Text="{x:Bind ViewModel.AccountName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <PasswordBox x:Name="DomainPasswordBox"
                                x:Uid="DomainJoinPassword"
                                Width="{ThemeResource FoundryWideInputMinWidth}"
                                Loaded="OnPasswordLoaded"
                                MaxLength="2560"
                                PasswordChanged="OnPasswordChanged" />
                            <TextBlock
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Text="{x:Bind ViewModel.CredentialsValidationMessage, Mode=OneWay}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{x:Bind ViewModel.CredentialsValidationVisibility, Mode=OneWay}" />
                        </StackPanel>
                    </wct:SettingsCard>
                    <wct:SettingsCard
                        x:Uid="DomainJoinOuActions"
                        HorizontalContentAlignment="Stretch">
                        <wct:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE710;" />
                        </wct:SettingsCard.HeaderIcon>
                        <Grid ColumnSpacing="{ThemeResource FoundryInlineControlSpacing}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid
                                VerticalAlignment="Center"
                                ColumnSpacing="{ThemeResource FoundrySpace8}"
                                Visibility="{x:Bind ViewModel.StatusVisibility, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ProgressRing
                                    Width="{ThemeResource FoundryIconSizeDefault}"
                                    Height="{ThemeResource FoundryIconSizeDefault}"
                                    IsActive="{x:Bind ViewModel.IsDiscovering, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.DiscoveringVisibility, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />
                            </Grid>

                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="{ThemeResource FoundryInlineControlSpacing}">
                                <Button
                                    x:Uid="DomainJoinAdd"
                                    MinWidth="{StaticResource FoundrySettingsActionMinWidth}"
                                    Command="{x:Bind ViewModel.AddOrganizationalUnitCommand}" />
                                <Button
                                    MinWidth="{StaticResource FoundrySettingsActionMinWidth}"
                                    Command="{x:Bind ViewModel.ImportFromDomainCommand}"
                                    Content="{x:Bind ViewModel.ImportButtonText, Mode=OneWay}" />
                                <Button
                                    MinWidth="{StaticResource FoundrySettingsActionMinWidth}"
                                    Command="{x:Bind ViewModel.RemoveSelectedCommand}"
                                    Content="{x:Bind ViewModel.RemoveSelectedText, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </wct:SettingsCard>

                    <wct:SettingsCard
                        x:Uid="DomainJoinCatalog"
                        HorizontalContentAlignment="Stretch">
                        <wct:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8B7;" />
                        </wct:SettingsCard.HeaderIcon>
                        <StackPanel Spacing="{ThemeResource FoundrySettingsSectionSpacing}">
                            <TextBlock
                                Text="{x:Bind ViewModel.EmptyListText, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.EmptyListVisibility, Mode=OneWay}" />
                            <TextBlock
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Text="{x:Bind ViewModel.OrganizationalUnitsValidationMessage, Mode=OneWay}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{x:Bind ViewModel.OrganizationalUnitsValidationVisibility, Mode=OneWay}" />
                            <tv:TableView x:Name="OrganizationalUnitsTable"
                                MaxHeight="{ThemeResource FoundryTableMaxHeight}"
                                AutoGenerateColumns="False"
                                CanFilterColumns="False"
                                CanReorderColumns="False"
                                CanResizeColumns="False"
                                CanSortColumns="True"
                                CornerButtonMode="None"
                                HeadersVisibility="Columns"
                                IsReadOnly="True"
                                ItemsSource="{x:Bind ViewModel.OrganizationalUnits, Mode=OneWay}"
                                SelectionChanged="CatalogTable_SelectionChanged"
                                SelectionMode="Multiple"
                                SelectionUnit="Row"
                                ShowExportOptions="False"
                                Visibility="{x:Bind ViewModel.ListVisibility, Mode=OneWay}">
                                <tv:TableView.Columns>
                                    <tv:TableViewTextColumn
                                        Binding="{Binding DisplayName}"
                                        Header="{x:Bind ViewModel.LabelColumnHeader, Mode=OneWay}" />
                                    <tv:TableViewTextColumn
                                        Binding="{Binding DistinguishedName}"
                                        Header="{x:Bind ViewModel.DistinguishedNameColumnHeader, Mode=OneWay}" />
                                </tv:TableView.Columns>
                            </tv:TableView>
                        </StackPanel>
                    </wct:SettingsCard>

                    <wct:SettingsCard
                        x:Uid="DomainJoinDefaultOu"
                        HorizontalContentAlignment="Stretch">
                        <wct:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE734;" />
                        </wct:SettingsCard.HeaderIcon>
                        <StackPanel
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="{ThemeResource FoundryInlineControlSpacing}">
                            <ComboBox
                                Width="{ThemeResource FoundryWideInputMinWidth}"
                                VerticalAlignment="Center"
                                DisplayMemberPath="Hierarchy"
                                IsEnabled="{x:Bind ViewModel.UseDefaultOu, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.OrganizationalUnits}"
                                SelectedItem="{x:Bind ViewModel.SelectedDefaultOu, Mode=TwoWay}" />
                            <ToggleSwitch
                                behaviors:LocalizedToggleSwitch.UseLocalizedStateContent="True"
                                IsEnabled="{x:Bind ViewModel.CanUseDefaultOu, Mode=OneWay}"
                                IsOn="{x:Bind ViewModel.UseDefaultOu, Mode=TwoWay}" />
                        </StackPanel>
                    </wct:SettingsCard>

                    <wct:SettingsCard x:Uid="DomainJoinAllowSelection">
                        <wct:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE762;" />
                        </wct:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                            behaviors:LocalizedToggleSwitch.UseLocalizedStateContent="True"
                            IsOn="{x:Bind ViewModel.AllowOuSelectionDuringDeployment, Mode=TwoWay}" />
                    </wct:SettingsCard>
                </StackPanel>
            </ContentControl>
        </StackPanel>
    </ScrollView>
</Page>
