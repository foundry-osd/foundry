<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Foundry.Views.ReleaseNotesDialogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Disabled"
    mc:Ignorable="d">
    <Grid Margin="{ThemeResource FoundryDialogPageMargin}">
        <WebView2 x:Name="ReleaseNotesWebView"
            CoreWebView2Initialized="ReleaseNotesWebView_CoreWebView2Initialized"
            NavigationCompleted="ReleaseNotesWebView_NavigationCompleted"
            NavigationStarting="ReleaseNotesWebView_NavigationStarting" />

        <StackPanel x:Name="ReleaseNotesLoadingPanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="{ThemeResource FoundryContentGroupSpacing}">
            <ProgressRing
                Width="40"
                Height="40"
                IsActive="True" />
            <TextBlock x:Name="ReleaseNotesLoadingText" />
        </StackPanel>

        <StackPanel x:Name="ReleaseNotesErrorPanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="{ThemeResource FoundryContentGroupSpacing}"
            Visibility="Collapsed">
            <FontIcon
                FontSize="{ThemeResource FoundryIconSizeHero}"
                Glyph="&#xE783;" />
            <TextBlock x:Name="ReleaseNotesErrorText"
                TextWrapping="WrapWholeWords" />
            <HyperlinkButton x:Name="OpenReleaseNotesLink" />
        </StackPanel>
    </Grid>
</Page>
