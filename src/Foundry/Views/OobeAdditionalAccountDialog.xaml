<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="Foundry.Views.OobeAdditionalAccountDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Foundry.Behaviors"
    CloseButtonStyle="{ThemeResource DefaultButtonStyle}"
    CornerRadius="{ThemeResource OverlayCornerRadius}"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    PrimaryButtonStyle="{ThemeResource AccentButtonStyle}"
    Style="{ThemeResource DefaultContentDialogStyle}">
    <Grid x:Name="DialogContentRoot"
        Width="{ThemeResource FoundryWideInputMinWidth}"
        RowSpacing="{ThemeResource FoundryContentGroupSpacing}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Text="{Binding Description}"
            TextWrapping="WrapWholeWords" />

        <TextBox
            Grid.Row="1"
            Header="{Binding UserNameLabel}"
            PlaceholderText="{Binding UserNamePlaceholder}"
            Text="{Binding UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <ComboBox
            Grid.Row="2"
            HorizontalAlignment="Stretch"
            DisplayMemberPath="DisplayName"
            Header="{Binding AccountTypeLabel}"
            ItemsSource="{Binding AccountTypeOptions}"
            SelectedItem="{Binding SelectedAccountType, Mode=TwoWay}" />

        <Grid
            Grid.Row="3"
            ColumnSpacing="{ThemeResource FoundryInlineControlSpacing}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="{ThemeResource FoundryTextGroupSpacing}">
                <TextBlock
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="{Binding PasswordLabel}"
                    TextWrapping="WrapWholeWords" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding PasswordDescription}"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
            <ToggleSwitch
                Grid.Column="1"
                VerticalAlignment="Center"
                behaviors:LocalizedToggleSwitch.UseLocalizedStateContent="True"
                AutomationProperties.Name="{Binding PasswordLabel}"
                IsOn="{Binding UsePassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <PasswordBox x:Name="PasswordBox"
            Grid.Row="4"
            Header="{Binding PasswordPlaceholder}"
            IsEnabled="{Binding UsePassword}"
            PlaceholderText="{Binding PasswordPlaceholder}" />

        <StackPanel
            Grid.Row="5"
            Spacing="{ThemeResource FoundryCompactStackSpacing}">
            <PasswordBox x:Name="ConfirmationBox"
                Header="{Binding ConfirmationPlaceholder}"
                IsEnabled="{Binding UsePassword}"
                PlaceholderText="{Binding ConfirmationPlaceholder}" />
            <TextBlock x:Name="ValidationTextBlock"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="WrapWholeWords" />
        </StackPanel>
    </Grid>
</ContentDialog>
