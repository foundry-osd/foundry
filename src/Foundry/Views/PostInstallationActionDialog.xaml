<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="Foundry.Views.PostInstallationActionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{x:Bind ViewModel.Title}"
    CloseButtonStyle="{ThemeResource DefaultButtonStyle}"
    CloseButtonText="{x:Bind ViewModel.CancelLabel}"
    CornerRadius="{ThemeResource OverlayCornerRadius}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
    PrimaryButtonClick="OnPrimaryButtonClick"
    PrimaryButtonStyle="{ThemeResource AccentButtonStyle}"
    PrimaryButtonText="{x:Bind ViewModel.SaveLabel}"
    Style="{ThemeResource DefaultContentDialogStyle}">
    <Grid x:Name="DialogContentRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
            IsTabStop="False"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="{ThemeResource FoundrySpace24}">
                <StackPanel Spacing="{ThemeResource FoundryContentGroupSpacing}">
                    <StackPanel x:Name="NameGroup"
                        Spacing="{ThemeResource FoundryTextGroupSpacing}">
                        <TextBox x:Name="NameInput"
                            Header="{x:Bind ViewModel.NameLabel}"
                            MaxLength="256"
                            Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Style="{ThemeResource FoundryCaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}"
                            TextWrapping="WrapWholeWords"
                            Visibility="{x:Bind ViewModel.ValidationVisibility('Name', ViewModel.InvalidField), Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        Style="{ThemeResource FoundrySecondaryBodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.ExecutionHelp}"
                        TextWrapping="WrapWholeWords"
                        Visibility="{x:Bind ViewModel.IsExecutable}" />
                    <TextBlock
                        Style="{ThemeResource FoundrySecondaryBodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.RestartDescription}"
                        TextWrapping="WrapWholeWords"
                        Visibility="{x:Bind ViewModel.IsRestart}" />
                </StackPanel>
                <Grid x:Name="SettingsGrid"
                    ColumnSpacing="{ThemeResource FoundrySpace24}"
                    RowSpacing="{ThemeResource FoundrySpace24}"
                    Visibility="{x:Bind ViewModel.IsExecutable}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="ExecutionColumn"
                            Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="{ThemeResource FoundryContentGroupSpacing}">
                        <TextBlock
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind ViewModel.ContentLabel}"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            Style="{ThemeResource FoundrySecondaryBodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.PackageName, Mode=OneWay}"
                            TextWrapping="WrapWholeWords" />
                        <StackPanel x:Name="PackageNameGroup"
                            Spacing="{ThemeResource FoundryTextGroupSpacing}">
                            <Grid ColumnSpacing="{ThemeResource FoundryInlineControlSpacing}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PackageNameInput"
                                    HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.ImportFileCommand}">
                                    <TextBlock
                                        Text="{x:Bind ViewModel.ImportFileLabel}"
                                        TextWrapping="WrapWholeWords" />
                                </Button>
                                <Button
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.ImportFolderCommand}">
                                    <TextBlock
                                        Text="{x:Bind ViewModel.ImportFolderLabel}"
                                        TextWrapping="WrapWholeWords" />
                                </Button>
                            </Grid>
                            <TextBlock
                                AutomationProperties.LiveSetting="Polite"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Style="{ThemeResource FoundryCaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{x:Bind ViewModel.ValidationVisibility('PackageName', ViewModel.InvalidField), Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel x:Name="EntryPointGroup"
                            Spacing="{ThemeResource FoundryTextGroupSpacing}"
                            Visibility="{x:Bind ViewModel.HasEntryPoint}">
                            <ComboBox x:Name="EntryPointInput"
                                HorizontalAlignment="Stretch"
                                Header="{x:Bind ViewModel.EntryPointLabel}"
                                IsEditable="True"
                                IsEnabled="{x:Bind ViewModel.HasPackage, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.EntryPoints}"
                                Text="{x:Bind ViewModel.EntryPoint, Mode=TwoWay}" />
                            <TextBlock
                                AutomationProperties.LiveSetting="Polite"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Style="{ThemeResource FoundryCaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{x:Bind ViewModel.ValidationVisibility('EntryPoint', ViewModel.InvalidField), Mode=OneWay}" />
                        </StackPanel>
                        <TextBox
                            Header="{x:Bind ViewModel.ApplicationModeLabel}"
                            IsReadOnly="True"
                            Text="{x:Bind ViewModel.InstallerType, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsApplication}" />
                        <StackPanel x:Name="WorkingDirectoryGroup"
                            Spacing="{ThemeResource FoundryTextGroupSpacing}">
                            <TextBox x:Name="WorkingDirectoryInput"
                                Header="{x:Bind ViewModel.WorkingDirectoryLabel}"
                                IsEnabled="{x:Bind ViewModel.HasPackage, Mode=OneWay}"
                                Text="{x:Bind ViewModel.WorkingDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                AutomationProperties.LiveSetting="Polite"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Style="{ThemeResource FoundryCaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{x:Bind ViewModel.ValidationVisibility('WorkingDirectory', ViewModel.InvalidField), Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel x:Name="PowerShellArgumentsGroup"
                            Spacing="{ThemeResource FoundryTextGroupSpacing}"
                            Visibility="{x:Bind ViewModel.IsPowerShell}">
                            <TextBox x:Name="PowerShellArgumentsInput"
                                MaxHeight="120"
                                Header="{x:Bind ViewModel.PowerShellArgumentsLabel}"
                                MaxLength="8191"
                                Text="{x:Bind ViewModel.PowerShellArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                AutomationProperties.LiveSetting="Polite"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Style="{ThemeResource FoundryCaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{x:Bind ViewModel.ValidationVisibility('PowerShellArguments', ViewModel.InvalidField), Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel x:Name="ArgumentsGroup"
                            Spacing="{ThemeResource FoundryTextGroupSpacing}"
                            Visibility="{x:Bind ViewModel.HasEntryPoint}">
                            <TextBox x:Name="ArgumentsInput"
                                MaxHeight="120"
                                Header="{x:Bind ViewModel.ArgumentsLabel}"
                                MaxLength="8191"
                                Text="{x:Bind ViewModel.Arguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                AutomationProperties.LiveSetting="Polite"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Style="{ThemeResource FoundryCaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{x:Bind ViewModel.ValidationVisibility('Arguments', ViewModel.InvalidField), Mode=OneWay}" />
                        </StackPanel>
                        <CheckBox
                            IsChecked="{x:Bind ViewModel.GenerateInstallationLog, Mode=TwoWay}"
                            Visibility="{x:Bind ViewModel.IsMsi, Mode=OneWay}">
                            <TextBlock
                                Text="{x:Bind ViewModel.GenerateInstallationLogLabel}"
                                TextWrapping="WrapWholeWords" />
                        </CheckBox>
                        <StackPanel x:Name="CommandTextGroup"
                            Spacing="{ThemeResource FoundryTextGroupSpacing}"
                            Visibility="{x:Bind ViewModel.IsCommand}">
                            <TextBox x:Name="CommandTextInput"
                                MaxHeight="120"
                                Header="{x:Bind ViewModel.CommandLabel}"
                                MaxLength="8191"
                                Text="{x:Bind ViewModel.CommandText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                AutomationProperties.LiveSetting="Polite"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Style="{ThemeResource FoundryCaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{x:Bind ViewModel.ValidationVisibility('CommandText', ViewModel.InvalidField), Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="ExecutionSettingsPanel"
                        Grid.Column="1"
                        Spacing="{ThemeResource FoundryContentGroupSpacing}">
                        <TextBlock
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind ViewModel.ExecutionSettingsLabel}"
                            TextWrapping="WrapWholeWords" />
                        <StackPanel x:Name="TimeoutSecondsGroup"
                            Spacing="{ThemeResource FoundryTextGroupSpacing}">
                            <NumberBox x:Name="TimeoutSecondsInput"
                                Header="{x:Bind ViewModel.TimeoutLabel}"
                                LargeChange="60"
                                Maximum="86400"
                                Minimum="1"
                                SmallChange="30"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind ViewModel.TimeoutSeconds, Mode=TwoWay}" />
                            <TextBlock
                                AutomationProperties.LiveSetting="Polite"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Style="{ThemeResource FoundryCaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{x:Bind ViewModel.ValidationVisibility('TimeoutSeconds', ViewModel.InvalidField), Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel x:Name="SuccessCodesGroup"
                            Spacing="{ThemeResource FoundryTextGroupSpacing}">
                            <TextBox x:Name="SuccessCodesInput"
                                Header="{x:Bind ViewModel.SuccessCodesLabel}"
                                Text="{x:Bind ViewModel.SuccessCodes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                AutomationProperties.LiveSetting="Polite"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Style="{ThemeResource FoundryCaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{x:Bind ViewModel.ValidationVisibility('SuccessCodes', ViewModel.InvalidField), Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel x:Name="RestartCodesGroup"
                            Spacing="{ThemeResource FoundryTextGroupSpacing}">
                            <TextBox x:Name="RestartCodesInput"
                                Header="{x:Bind ViewModel.RestartCodesLabel}"
                                Text="{x:Bind ViewModel.RestartCodes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                AutomationProperties.LiveSetting="Polite"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Style="{ThemeResource FoundryCaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{x:Bind ViewModel.ValidationVisibility('RestartCodes', ViewModel.InvalidField), Mode=OneWay}" />
                        </StackPanel>
                        <CheckBox
                            VerticalContentAlignment="Top"
                            AutomationProperties.HelpText="{x:Bind ViewModel.ContinueDescription}"
                            AutomationProperties.Name="{x:Bind ViewModel.ContinueLabel}"
                            IsChecked="{x:Bind ViewModel.ContinueOnError, Mode=TwoWay}">
                            <StackPanel Spacing="{ThemeResource FoundryTextGroupSpacing}">
                                <TextBlock
                                    Text="{x:Bind ViewModel.ContinueLabel}"
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource FoundryCaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.ContinueDescription}"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox
                            VerticalContentAlignment="Top"
                            AutomationProperties.HelpText="{x:Bind ViewModel.DeferRestartDescription}"
                            AutomationProperties.Name="{x:Bind ViewModel.DeferRestartLabel}"
                            IsChecked="{x:Bind ViewModel.DeferRestart, Mode=TwoWay}">
                            <StackPanel Spacing="{ThemeResource FoundryTextGroupSpacing}">
                                <TextBlock
                                    Text="{x:Bind ViewModel.DeferRestartLabel}"
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource FoundryCaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.DeferRestartDescription}"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        <TextBox
            Grid.Row="1"
            MaxHeight="120"
            Margin="0,12,0,0"
            Header="{x:Bind ViewModel.CommandPreviewLabel}"
            IsReadOnly="True"
            PlaceholderText="{x:Bind ViewModel.CommandPreviewPlaceholder}"
            Text="{x:Bind ViewModel.CommandPreview, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.IsExecutable}" />
        <StackPanel
            Grid.Row="2"
            Margin="0,12,0,0"
            Spacing="{ThemeResource FoundryContentGroupSpacing}"
            Visibility="{x:Bind ViewModel.HasFeedback, Mode=OneWay}">
            <ProgressBar
                AutomationProperties.Name="{x:Bind ViewModel.ContentLabel}"
                IsIndeterminate="True"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <InfoBar
                AutomationProperties.LiveSetting="Polite"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                Severity="Error"
                Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</ContentDialog>
