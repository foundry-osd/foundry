<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Foundry.Views.OptionalFeaturesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Foundry.Behaviors"
    xmlns:controls="using:Foundry.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Foundry.ViewModels"
    xmlns:wct="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">
    <ScrollView
        Margin="{ThemeResource ContentPageMargin}"
        Padding="{ThemeResource ContentPagePadding}"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="{ThemeResource FoundrySettingsSectionSpacing}">
            <controls:PageHeader
                x:Uid="OptionalFeaturesPageHeader"
                DocumentationUrl="{x:Bind ViewModel.DocumentationUrl, Mode=OneWay}"
                IconGlyph="&#xE74C;">
                <controls:PageHeader.ActionContent>
                    <ToggleSwitch
                        x:Uid="OptionalFeaturesPageEnableToggle"
                        behaviors:LocalizedToggleSwitch.UseLocalizedStateContent="True"
                        IsOn="{x:Bind ViewModel.IsWindowsOptionalFeaturesEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </controls:PageHeader.ActionContent>
            </controls:PageHeader>

            <ContentControl IsEnabled="{x:Bind ViewModel.IsWindowsOptionalFeaturesEnabled, Mode=OneWay}">
                <StackPanel Spacing="{ThemeResource FoundrySettingsSectionSpacing}">
                    <wct:SettingsCard
                        Description="{x:Bind ViewModel.WindowsOptionalFeaturesExplanation, Mode=OneWay}"
                        Header="{x:Bind ViewModel.WindowsOptionalFeatureConfiguredCountText, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsWindowsOptionalFeatureOptionsEnabled, Mode=OneWay}">
                        <wct:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE9D2;" />
                        </wct:SettingsCard.HeaderIcon>
                    </wct:SettingsCard>
                    <wct:SettingsCard
                        Header="{x:Bind ViewModel.WindowsOptionalFeatureSearchLabel, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsWindowsOptionalFeatureOptionsEnabled, Mode=OneWay}">
                        <wct:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE721;" />
                        </wct:SettingsCard.HeaderIcon>
                        <TextBox
                            MinWidth="{ThemeResource FoundryWideInputMinWidth}"
                            AutomationProperties.Name="{x:Bind ViewModel.WindowsOptionalFeatureSearchLabel, Mode=OneWay}"
                            PlaceholderText="{x:Bind ViewModel.WindowsOptionalFeatureSearchPlaceholder, Mode=OneWay}"
                            Text="{x:Bind ViewModel.WindowsOptionalFeatureSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </wct:SettingsCard>
                    <wct:SettingsCard
                        HorizontalContentAlignment="Stretch"
                        IsEnabled="{x:Bind ViewModel.IsWindowsOptionalFeatureOptionsEnabled, Mode=OneWay}">
                        <StackPanel Spacing="{ThemeResource FoundrySettingsSectionSpacing}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Text="{x:Bind ViewModel.WindowsOptionalFeatureEmptySearchText, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.WindowsOptionalFeatureEmptySearchVisibility, Mode=OneWay}" />
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.VisibleWindowsOptionalFeatureCategories, Mode=OneWay}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:WindowsOptionalFeatureCategoryViewModel">
                                        <wct:SettingsExpander
                                            Description="{x:Bind SummaryText, Mode=OneWay}"
                                            Header="{x:Bind DisplayName, Mode=OneWay}"
                                            IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                                            <wct:SettingsExpander.Items>
                                                <wct:SettingsCard HorizontalContentAlignment="Stretch">
                                                    <StackPanel
                                                        HorizontalAlignment="Right"
                                                        Orientation="Horizontal"
                                                        Spacing="{ThemeResource FoundryInlineControlSpacing}">
                                                        <Button
                                                            MinWidth="{ThemeResource FoundryCompactActionMinWidth}"
                                                            AutomationProperties.Name="{x:Bind EnableAutomationName, Mode=OneWay}"
                                                            Command="{x:Bind EnableVisibleCommand}"
                                                            Content="{x:Bind EnableActionText, Mode=OneWay}" />
                                                        <Button
                                                            MinWidth="{ThemeResource FoundryCompactActionMinWidth}"
                                                            AutomationProperties.Name="{x:Bind DisableAutomationName, Mode=OneWay}"
                                                            Command="{x:Bind DisableVisibleCommand}"
                                                            Content="{x:Bind DisableActionText, Mode=OneWay}" />
                                                        <Button
                                                            MinWidth="{ThemeResource FoundryCompactActionMinWidth}"
                                                            AutomationProperties.Name="{x:Bind ClearAutomationName, Mode=OneWay}"
                                                            Command="{x:Bind ClearVisibleCommand}"
                                                            Content="{x:Bind ClearActionText, Mode=OneWay}" />
                                                    </StackPanel>
                                                </wct:SettingsCard>
                                                <wct:SettingsCard HorizontalContentAlignment="Stretch">
                                                    <ItemsRepeater ItemsSource="{x:Bind VisibleItems, Mode=OneWay}">
                                                        <ItemsRepeater.ItemTemplate>
                                                            <DataTemplate x:DataType="viewModels:WindowsOptionalFeatureItemViewModel">
                                                                <wct:SettingsCard
                                                                    Margin="{x:Bind Indentation, Mode=OneWay}"
                                                                    Description="{x:Bind DetailText, Mode=OneWay}"
                                                                    Header="{x:Bind DisplayName, Mode=OneWay}">
                                                                    <ComboBox
                                                                        MinWidth="{ThemeResource FoundryCompactInputMinWidth}"
                                                                        AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}"
                                                                        DisplayMemberPath="DisplayName"
                                                                        ItemsSource="{x:Bind StateOptions, Mode=OneWay}"
                                                                        SelectedItem="{x:Bind SelectedState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                </wct:SettingsCard>
                                                            </DataTemplate>
                                                        </ItemsRepeater.ItemTemplate>
                                                    </ItemsRepeater>
                                                </wct:SettingsCard>
                                            </wct:SettingsExpander.Items>
                                        </wct:SettingsExpander>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </wct:SettingsCard>
                </StackPanel>
            </ContentControl>
        </StackPanel>
    </ScrollView>
</Page>
