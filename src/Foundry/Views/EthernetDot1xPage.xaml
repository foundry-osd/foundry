<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Foundry.Views.EthernetDot1xPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Foundry.Behaviors"
    xmlns:controls="using:Foundry.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Foundry.ViewModels"
    xmlns:wct="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">
    <ScrollView
        Margin="{ThemeResource ContentPageMargin}"
        Padding="{ThemeResource ContentPagePadding}"
        HorizontalContentAlignment="Stretch"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            HorizontalAlignment="Stretch"
            Spacing="{ThemeResource FoundrySettingsSectionSpacing}">
            <controls:PageHeader
                x:Uid="EthernetDot1xPageHeader"
                DocumentationUrl="{x:Bind ViewModel.EthernetDot1xDocumentationUrl, Mode=OneWay}"
                IconGlyph="&#xE839;">
                <controls:PageHeader.ActionContent>
                    <ToggleSwitch
                        x:Uid="EthernetDot1xPageEnableToggle"
                        behaviors:LocalizedToggleSwitch.UseLocalizedStateContent="True"
                        IsEnabled="{x:Bind Managed.IsEditable, Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.IsDot1xEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource FoundryPageHeaderToggleSwitchStyle}" />
                </controls:PageHeader.ActionContent>
            </controls:PageHeader>
            <controls:ManagedConfigurationBanner />

            <ContentControl
                HorizontalContentAlignment="Stretch"
                IsEnabled="{x:Bind ViewModel.IsDot1xEnabled, Mode=OneWay}">
                <StackPanel Spacing="{ThemeResource FoundrySettingsSectionSpacing}">
                    <InfoBar
                        Title="{x:Bind ViewModel.NeedsAttentionText, Mode=OneWay}"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasDot1xMediaProtectionIssue, Mode=OneWay}"
                        Message="{x:Bind ViewModel.Dot1xMediaProtectionMessage, Mode=OneWay}"
                        Severity="Error"
                        Visibility="{x:Bind ViewModel.HasDot1xMediaProtectionIssue, Mode=OneWay}" />
                    <wct:SettingsCard
                        HorizontalContentAlignment="Stretch"
                        Header="{x:Bind ViewModel.ProfileTemplateLabel, Mode=OneWay}"
                        IsEnabled="{x:Bind Managed.IsEditable, Mode=OneWay}">
                        <StackPanel
                            HorizontalAlignment="Right"
                            Spacing="{ThemeResource FoundrySpace4}">
                            <Grid ColumnSpacing="{ThemeResource FoundryInlineControlSpacing}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Width="{ThemeResource FoundryWideInputMinWidth}"
                                    AutomationProperties.Name="{x:Bind ViewModel.ProfileTemplateLabel, Mode=OneWay}"
                                    IsReadOnly="True"
                                    Text="{x:Bind ViewModel.Dot1xProfileTemplateFileName, Mode=OneWay}" />
                                <Button
                                    Grid.Column="1"
                                    MinWidth="{StaticResource FoundryCompactActionMinWidth}"
                                    Command="{x:Bind ViewModel.BrowseDot1xProfileTemplateCommand}"
                                    Content="{x:Bind ViewModel.BrowseButtonText, Mode=OneWay}" />
                            </Grid>
                            <TextBlock
                                MaxWidth="{ThemeResource FoundryWideInputMinWidth}"
                                HorizontalAlignment="Left"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Text="{x:Bind ViewModel.Dot1xProfileTemplateValidationMessage, Mode=OneWay}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{x:Bind ViewModel.Dot1xProfileTemplateValidationVisibility, Mode=OneWay}" />
                        </StackPanel>
                    </wct:SettingsCard>
                    <wct:SettingsCard
                        Header="{x:Bind ViewModel.RequiresCertificateText, Mode=OneWay}"
                        IsEnabled="{x:Bind Managed.IsEditable, Mode=OneWay}">
                        <ToggleSwitch
                            behaviors:LocalizedToggleSwitch.UseLocalizedStateContent="True"
                            IsOn="{x:Bind ViewModel.IsDot1xCertificateRequired, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </wct:SettingsCard>
                    <wct:SettingsCard
                        HorizontalContentAlignment="Stretch"
                        Description="{x:Bind ViewModel.ClientCertificateDescription, Mode=OneWay}"
                        Header="{x:Bind ViewModel.ClientCertificateLabel, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.Dot1xCertificatePathVisibility, Mode=OneWay}">
                        <StackPanel
                            HorizontalAlignment="Right"
                            Spacing="{ThemeResource FoundrySpace4}">
                            <ContentControl IsEnabled="{x:Bind Managed.IsEditable, Mode=OneWay}">
                                <Grid ColumnSpacing="{ThemeResource FoundryInlineControlSpacing}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        Width="{ThemeResource FoundryWideInputMinWidth}"
                                        AutomationProperties.Name="{x:Bind ViewModel.ClientCertificateLabel, Mode=OneWay}"
                                        IsReadOnly="True"
                                        Text="{x:Bind ViewModel.Dot1xClientCertificateFileName, Mode=OneWay}" />
                                    <Button
                                        Grid.Column="1"
                                        MinWidth="{StaticResource FoundryCompactActionMinWidth}"
                                        Command="{x:Bind ViewModel.BrowseDot1xClientCertificateCommand}"
                                        Content="{x:Bind ViewModel.BrowseButtonText, Mode=OneWay}" />
                                    <Button
                                        Grid.Column="2"
                                        MinWidth="{StaticResource FoundryCompactActionMinWidth}"
                                        AutomationProperties.Name="{x:Bind ViewModel.RemoveClientCertificateText, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.RemoveDot1xClientCertificateCommand}"
                                        Content="{x:Bind ViewModel.RemoveCertificateText, Mode=OneWay}" />
                                </Grid>
                            </ContentControl>
                            <PasswordBox
                                Width="{ThemeResource FoundryWideInputMinWidth}"
                                HorizontalAlignment="Left"
                                Header="{x:Bind ViewModel.CertificatePasswordLabel, Mode=OneWay}"
                                IsEnabled="{x:Bind Managed.ArePasswordsEditable, Mode=OneWay}"
                                Password="{x:Bind ViewModel.Dot1xCertificatePassword, Mode=TwoWay}"
                                Visibility="{x:Bind ViewModel.Dot1xClientCertificatePasswordVisibility, Mode=OneWay}" />
                            <TextBlock
                                MaxWidth="{ThemeResource FoundryWideInputMinWidth}"
                                HorizontalAlignment="Left"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Text="{x:Bind ViewModel.Dot1xCertificateValidationMessage, Mode=OneWay}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{x:Bind ViewModel.Dot1xCertificateValidationVisibility, Mode=OneWay}" />
                        </StackPanel>
                    </wct:SettingsCard>
                    <wct:SettingsCard
                        HorizontalContentAlignment="Stretch"
                        ContentAlignment="Vertical"
                        Description="{x:Bind ViewModel.TrustedRootCertificatesDescription, Mode=OneWay}"
                        Header="{x:Bind ViewModel.TrustedRootCertificatesLabel, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.Dot1xCertificatePathVisibility, Mode=OneWay}">
                        <ContentControl
                            HorizontalContentAlignment="Stretch"
                            IsEnabled="{x:Bind Managed.IsEditable, Mode=OneWay}">
                            <StackPanel Spacing="{ThemeResource FoundryContentGroupSpacing}">
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="{ThemeResource FoundryInlineControlSpacing}">
                                    <Button
                                        Command="{x:Bind ViewModel.AddDot1xTrustedRootCertificateCommand}"
                                        Content="{x:Bind ViewModel.AddTrustedRootCertificateText, Mode=OneWay}"
                                        Style="{StaticResource AccentButtonStyle}" />
                                    <Button
                                        AutomationProperties.Name="{x:Bind ViewModel.RemoveTrustedRootCertificateText, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.RemoveDot1xTrustedRootCertificateCommand}"
                                        Content="{x:Bind ViewModel.RemoveCertificateText, Mode=OneWay}" />
                                </StackPanel>

                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource FoundryBodyTextBlockStyle}"
                                    Text="{x:Bind ViewModel.NoTrustedRootCertificatesText, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords"
                                    Visibility="{x:Bind ViewModel.Dot1xNoTrustedRootCertificatesVisibility, Mode=OneWay}" />
                                <ListView
                                    MaxHeight="{ThemeResource FoundryTableMaxHeight}"
                                    AutomationProperties.Name="{x:Bind ViewModel.TrustedRootCertificatesLabel, Mode=OneWay}"
                                    ItemsSource="{x:Bind ViewModel.Dot1xTrustedRootCertificates}"
                                    SelectedItem="{x:Bind ViewModel.SelectedDot1xTrustedRootCertificate, Mode=TwoWay}"
                                    SelectionMode="Single">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:TrustedRootCertificateEntry">
                                            <TextBlock
                                                Padding="0,8"
                                                Style="{StaticResource FoundryBodyTextBlockStyle}"
                                                Text="{x:Bind FileName}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind FileName}" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </ContentControl>
                    </wct:SettingsCard>

                    <wct:SettingsExpander
                        Description="{x:Bind ViewModel.WiredDot1xWindowsRoamingDescription, Mode=OneWay}"
                        Header="{x:Bind ViewModel.WiredDot1xWindowsRoamingHeader, Mode=OneWay}"
                        IsEnabled="{x:Bind controls:BindingFunctions.And(ViewModel.IsWiredDot1xProfileRoamingAvailable, Managed.IsEditable), Mode=OneWay}"
                        IsExpanded="{x:Bind ViewModel.IsWiredDot1xWindowsRoamingExpanded, Mode=TwoWay}">
                        <wct:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE8AB;" />
                        </wct:SettingsExpander.HeaderIcon>
                        <ToggleSwitch
                            behaviors:LocalizedToggleSwitch.UseLocalizedStateContent="True"
                            AutomationProperties.Name="{x:Bind ViewModel.RoamNetworkProfilesText, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.IsWiredDot1xProfileRoamingAvailable, Mode=OneWay}"
                            IsOn="{x:Bind ViewModel.IsWiredDot1xProfileRoamingEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <wct:SettingsExpander.Items>
                            <wct:SettingsCard
                                Description="{x:Bind ViewModel.RoamPrivateKeyMaterialDescription, Mode=OneWay}"
                                Header="{x:Bind ViewModel.RoamPrivateKeyMaterialText, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.WiredDot1xRoamPrivateKeyMaterialVisibility, Mode=OneWay}">
                                <ToggleSwitch
                                    behaviors:LocalizedToggleSwitch.UseLocalizedStateContent="True"
                                    IsEnabled="{x:Bind ViewModel.IsWiredDot1xPrivateKeyMaterialRoamingEnabled, Mode=OneWay}"
                                    IsOn="{x:Bind ViewModel.IsWiredDot1xPrivateKeyMaterialRoamingRequested, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </wct:SettingsCard>
                        </wct:SettingsExpander.Items>
                    </wct:SettingsExpander>
                </StackPanel>
            </ContentControl>
        </StackPanel>
    </ScrollView>
</Page>
