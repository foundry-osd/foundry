<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="Foundry.Views.CustomImageImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:WinUI.TableView"
    Title="{x:Bind ViewModel.Title, Mode=OneWay}"
    CloseButtonClick="OnCloseButtonClick"
    CloseButtonStyle="{ThemeResource DefaultButtonStyle}"
    CloseButtonText="{x:Bind ViewModel.CancelLabel, Mode=OneWay}"
    Closed="OnClosed"
    Closing="OnClosing"
    CornerRadius="{ThemeResource OverlayCornerRadius}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanImport, Mode=OneWay}"
    PrimaryButtonClick="OnPrimaryButtonClick"
    PrimaryButtonStyle="{ThemeResource AccentButtonStyle}"
    PrimaryButtonText="{x:Bind ViewModel.Title, Mode=OneWay}"
    Style="{ThemeResource DefaultContentDialogStyle}">
    <ScrollViewer
        MaxHeight="{ThemeResource FoundryDialogMaxHeight}"
        VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="DialogContentRoot"
            Spacing="{ThemeResource FoundryContentGroupSpacing}">
            <Grid ColumnSpacing="{ThemeResource FoundryInlineControlSpacing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    Header="{x:Bind ViewModel.SourceLabel, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                    IsReadOnly="True"
                    Text="{x:Bind ViewModel.SourcePath, Mode=OneWay}" />
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.BrowseCommand}"
                    Content="{x:Bind ViewModel.BrowseLabel, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                    Style="{ThemeResource DefaultButtonStyle}" />
            </Grid>
            <ComboBox
                HorizontalAlignment="Stretch"
                Header="{x:Bind ViewModel.SourceChoiceMessage, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                ItemsSource="{x:Bind ViewModel.SourceChoices, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedIsoImagePath, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.HasSourceChoices, Mode=OneWay}" />
            <StackPanel Spacing="{ThemeResource FoundryTextGroupSpacing}">
                <TextBox
                    Header="{x:Bind ViewModel.NameLabel, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                    MaxLength="200"
                    Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Style="{ThemeResource FoundryCaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.NameValidationMessage, Mode=OneWay}"
                    TextWrapping="WrapWholeWords"
                    Visibility="{x:Bind ViewModel.HasNameValidation, Mode=OneWay}" />
            </StackPanel>
            <StackPanel
                Spacing="{ThemeResource FoundryTextGroupSpacing}"
                Visibility="{x:Bind ViewModel.HasPreview, Mode=OneWay}">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="{ThemeResource FoundryContentGroupSpacing}">
                    <TextBlock
                        Style="{ThemeResource FoundrySecondaryBodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.PreviewSizeText, Mode=OneWay}" />
                    <TextBlock
                        Style="{ThemeResource FoundrySecondaryBodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.PreviewIndexCountText, Mode=OneWay}" />
                </StackPanel>
                <tv:TableView
                    MaxHeight="{ThemeResource FoundryTableMaxHeight}"
                    AutoGenerateColumns="False"
                    AutomationProperties.Name="{x:Bind ViewModel.IndexesLabel, Mode=OneWay}"
                    CanFilterColumns="False"
                    CanReorderColumns="False"
                    CanResizeColumns="True"
                    CanSortColumns="False"
                    CornerButtonMode="None"
                    HeadersVisibility="Columns"
                    IsReadOnly="True"
                    ItemsSource="{x:Bind ViewModel.PreviewIndexes, Mode=OneWay}"
                    SelectionMode="None"
                    ShowExportOptions="False">
                    <tv:TableView.Columns>
                        <tv:TableViewTextColumn
                            Width="Auto"
                            Binding="{Binding Index}"
                            Header="{x:Bind ViewModel.IndexNumberLabel, Mode=OneWay}" />
                        <tv:TableViewTextColumn
                            Width="3*"
                            Binding="{Binding Name}"
                            Header="{x:Bind ViewModel.NameLabel, Mode=OneWay}" />
                        <tv:TableViewTextColumn
                            Width="*"
                            Binding="{Binding Architecture}"
                            Header="{x:Bind ViewModel.ArchitectureLabel, Mode=OneWay}" />
                        <tv:TableViewTextColumn
                            Width="2*"
                            Binding="{Binding Version}"
                            Header="{x:Bind ViewModel.VersionLabel, Mode=OneWay}" />
                        <tv:TableViewTextColumn
                            Width="2*"
                            Binding="{Binding Languages}"
                            Header="{x:Bind ViewModel.LanguagesLabel, Mode=OneWay}" />
                    </tv:TableView.Columns>
                </tv:TableView>
            </StackPanel>
            <ProgressBar
                IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"
                Maximum="100"
                Visibility="{x:Bind ViewModel.IsProcessing, Mode=OneWay}"
                Value="{x:Bind ViewModel.Progress, Mode=OneWay}" />
            <TextBlock
                Style="{ThemeResource FoundrySecondaryBodyTextBlockStyle}"
                Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                TextWrapping="WrapWholeWords"
                Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
