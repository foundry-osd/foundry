<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Foundry.Views.StartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Foundry.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Foundry.ViewModels"
    xmlns:wct="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">
    <Page.Resources>
        <DataTemplate x:Key="StartConfigurationOverviewItemTemplate"
            x:DataType="viewModels:StartConfigurationOverviewItemViewModel">
            <Grid
                MinHeight="56"
                Padding="0,6"
                ColumnSpacing="{ThemeResource FoundrySpace12}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid
                    Grid.Column="0"
                    Width="{ThemeResource FoundryIconSizeDefault}"
                    Height="{ThemeResource FoundryIconSizeDefault}"
                    VerticalAlignment="Center">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="{ThemeResource FoundryIconSizeSmall}"
                        Foreground="{x:Bind GlyphForeground}"
                        Glyph="{x:Bind Glyph}" />
                </Grid>
                <StackPanel
                    Grid.Column="1"
                    Spacing="{ThemeResource FoundryCompactStackSpacing}">
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{x:Bind Title}"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Description}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind ActionAutomationName}"
                    Click="ReadinessActionButton_Click"
                    Content="{x:Bind ActionText}"
                    Tag="{x:Bind NavigationTarget}"
                    Visibility="{x:Bind ActionVisibility}" />
                <TextBlock
                    Grid.Column="3"
                    MinWidth="{ThemeResource FoundryStatusTextMinWidth}"
                    MaxWidth="{ThemeResource FoundryStatusTextMaxWidth}"
                    VerticalAlignment="Center"
                    Style="{ThemeResource FoundryCaptionTextBlockStyle}"
                    Text="{x:Bind Status}"
                    TextWrapping="WrapWholeWords" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid
        Margin="{ThemeResource ContentPageMargin}"
        Padding="{ThemeResource ContentPagePadding}">
        <Grid RowSpacing="{ThemeResource FoundrySettingsSectionSpacing}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:PageHeader
                Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}"
                Description="{x:Bind ViewModel.PageDescription, Mode=OneWay}"
                DocumentationUrl="{x:Bind ViewModel.DocumentationUrl, Mode=OneWay}"
                IconGlyph="&#xE768;" />

            <InfoBar
                Title="{x:Bind ViewModel.StatusSummary, Mode=OneWay}"
                Grid.Row="1"
                IsClosable="False"
                IsIconVisible="True"
                IsOpen="True"
                Message="{x:Bind ViewModel.FinalExecutionStatus, Mode=OneWay}"
                Severity="{x:Bind ViewModel.ReadinessSeverity, Mode=OneWay}" />

            <ScrollView
                Grid.Row="2"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="{ThemeResource FoundrySettingsSectionSpacing}">
                    <wct:SettingsExpander x:Name="GeneralConfigurationOverviewCard"
                        Description="{x:Bind ViewModel.GeneralConfigurationOverviewSummary, Mode=OneWay}"
                        IsExpanded="{x:Bind ViewModel.IsGeneralConfigurationOverviewExpanded, Mode=TwoWay}">
                        <wct:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE713;" />
                        </wct:SettingsExpander.HeaderIcon>
                        <wct:SettingsExpander.ItemsHeader>
                            <Grid Padding="{ThemeResource FoundryDefaultContentPadding}">
                                <ItemsControl
                                    ItemTemplate="{StaticResource StartConfigurationOverviewItemTemplate}"
                                    ItemsSource="{x:Bind ViewModel.GeneralConfigurationOverviewItems, Mode=OneWay}" />
                            </Grid>
                        </wct:SettingsExpander.ItemsHeader>
                    </wct:SettingsExpander>

                    <wct:SettingsExpander x:Name="NetworkOverviewCard"
                        Description="{x:Bind ViewModel.NetworkOverviewSummary, Mode=OneWay}"
                        IsExpanded="{x:Bind ViewModel.IsNetworkOverviewExpanded, Mode=TwoWay}">
                        <wct:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE774;" />
                        </wct:SettingsExpander.HeaderIcon>
                        <wct:SettingsExpander.ItemsHeader>
                            <Grid Padding="{ThemeResource FoundryDefaultContentPadding}">
                                <ItemsControl
                                    ItemTemplate="{StaticResource StartConfigurationOverviewItemTemplate}"
                                    ItemsSource="{x:Bind ViewModel.NetworkOverviewItems, Mode=OneWay}" />
                            </Grid>
                        </wct:SettingsExpander.ItemsHeader>
                    </wct:SettingsExpander>

                    <wct:SettingsExpander x:Name="AutopilotOverviewCard"
                        Description="{x:Bind ViewModel.AutopilotOverviewSummary, Mode=OneWay}"
                        IsExpanded="{x:Bind ViewModel.IsAutopilotOverviewExpanded, Mode=TwoWay}">
                        <wct:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE753;" />
                        </wct:SettingsExpander.HeaderIcon>
                        <wct:SettingsExpander.ItemsHeader>
                            <Grid Padding="{ThemeResource FoundryDefaultContentPadding}">
                                <ItemsControl
                                    ItemTemplate="{StaticResource StartConfigurationOverviewItemTemplate}"
                                    ItemsSource="{x:Bind ViewModel.AutopilotOverviewItems, Mode=OneWay}" />
                            </Grid>
                        </wct:SettingsExpander.ItemsHeader>
                    </wct:SettingsExpander>

                    <wct:SettingsExpander x:Name="CustomizationOverviewCard"
                        Description="{x:Bind ViewModel.CustomizationOverviewSummary, Mode=OneWay}"
                        IsExpanded="{x:Bind ViewModel.IsCustomizationOverviewExpanded, Mode=TwoWay}">
                        <wct:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE771;" />
                        </wct:SettingsExpander.HeaderIcon>
                        <wct:SettingsExpander.ItemsHeader>
                            <Grid Padding="{ThemeResource FoundryDefaultContentPadding}">
                                <ItemsControl
                                    ItemTemplate="{StaticResource StartConfigurationOverviewItemTemplate}"
                                    ItemsSource="{x:Bind ViewModel.CustomizationOverviewItems, Mode=OneWay}" />
                            </Grid>
                        </wct:SettingsExpander.ItemsHeader>
                    </wct:SettingsExpander>
                </StackPanel>
            </ScrollView>

            <StackPanel
                Grid.Row="3"
                Spacing="{ThemeResource FoundrySettingsSectionSpacing}">
                <wct:SettingsCard x:Name="IsoPathCard">
                    <wct:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE958;" />
                    </wct:SettingsCard.HeaderIcon>
                    <StackPanel
                        Margin="{ThemeResource FoundrySettingsExpanderTrailingAffordanceMargin}"
                        Orientation="Horizontal"
                        Spacing="{ThemeResource FoundryInlineControlSpacing}">
                        <TextBox
                            Width="{ThemeResource FoundryWideInputMinWidth}"
                            Text="{x:Bind ViewModel.IsoOutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button x:Name="BrowseIsoButton"
                            MinWidth="{StaticResource FoundrySettingsActionMinWidth}"
                            Command="{x:Bind ViewModel.BrowseIsoOutputPathCommand}" />
                    </StackPanel>
                </wct:SettingsCard>

                <wct:SettingsExpander x:Name="UsbTargetCard"
                    Description="{x:Bind ViewModel.UsbCandidateStatus, Mode=OneWay}">
                    <wct:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE88E;" />
                    </wct:SettingsExpander.HeaderIcon>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="{ThemeResource FoundryInlineControlSpacing}">
                        <ComboBox
                            Width="{ThemeResource FoundryWideInputMinWidth}"
                            DisplayMemberPath="DisplayName"
                            IsEnabled="{x:Bind ViewModel.CanSelectUsbDisk, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.UsbCandidates, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedUsbDisk, Mode=TwoWay}" />
                        <Button x:Name="RefreshUsbButton"
                            MinWidth="{StaticResource FoundrySettingsActionMinWidth}"
                            Command="{x:Bind ViewModel.RefreshUsbCandidatesCommand}" />
                    </StackPanel>
                    <wct:SettingsExpander.Items>
                        <wct:SettingsCard x:Name="UsbPartitionStyleCard">
                            <ComboBox
                                MinWidth="{StaticResource FoundrySettingsActionMinWidth}"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{x:Bind ViewModel.PartitionStyles, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedPartitionStyle, Mode=TwoWay}" />
                        </wct:SettingsCard>
                        <wct:SettingsCard x:Name="UsbFormatModeCard">
                            <ComboBox
                                MinWidth="{StaticResource FoundrySettingsActionMinWidth}"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{x:Bind ViewModel.FormatModes, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedFormatMode, Mode=TwoWay}" />
                        </wct:SettingsCard>
                    </wct:SettingsExpander.Items>
                </wct:SettingsExpander>

                <wct:SettingsCard x:Name="FinalCommandsCard">
                    <wct:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE768;" />
                    </wct:SettingsCard.HeaderIcon>
                    <StackPanel
                        Margin="{ThemeResource FoundrySettingsExpanderTrailingAffordanceMargin}"
                        Orientation="Horizontal"
                        Spacing="{ThemeResource FoundryInlineControlSpacing}">
                        <Button x:Name="CreateIsoButton"
                            MinWidth="{StaticResource FoundrySettingsActionMinWidth}"
                            Command="{x:Bind ViewModel.CreateIsoCommand}"
                            IsEnabled="{x:Bind ViewModel.CanCreateIso, Mode=OneWay}" />
                        <Button x:Name="CreateUsbButton"
                            MinWidth="{StaticResource FoundrySettingsActionMinWidth}"
                            Command="{x:Bind ViewModel.CreateUsbCommand}"
                            IsEnabled="{x:Bind ViewModel.CanCreateUsb, Mode=OneWay}" />
                    </StackPanel>
                </wct:SettingsCard>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
