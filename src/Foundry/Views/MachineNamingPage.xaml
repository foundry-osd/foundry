<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Foundry.Views.MachineNamingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Foundry.Behaviors"
    xmlns:controls="using:Foundry.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Foundry.ViewModels"
    xmlns:wct="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">
    <ScrollView
        Margin="{ThemeResource ContentPageMargin}"
        Padding="{ThemeResource ContentPagePadding}"
        HorizontalContentAlignment="Stretch"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            HorizontalAlignment="Stretch"
            Spacing="{ThemeResource FoundrySettingsSectionSpacing}">
            <controls:PageHeader
                x:Uid="MachineNamingPageHeader"
                DocumentationUrl="{x:Bind ViewModel.MachineNamingDocumentationUrl, Mode=OneWay}"
                IconGlyph="&#xE8AC;">
                <controls:PageHeader.ActionContent>
                    <ToggleSwitch
                        x:Uid="MachineNamingPageEnableToggle"
                        behaviors:LocalizedToggleSwitch.UseLocalizedStateContent="True"
                        IsOn="{x:Bind ViewModel.IsMachineNamingEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource FoundryPageHeaderToggleSwitchStyle}" />
                </controls:PageHeader.ActionContent>
            </controls:PageHeader>

            <ContentControl
                HorizontalContentAlignment="Stretch"
                IsEnabled="{x:Bind ViewModel.IsMachineNamingEnabled, Mode=OneWay}">
                <StackPanel Spacing="{ThemeResource FoundrySettingsSectionSpacing}">
                    <wct:SettingsCard
                        HorizontalContentAlignment="Stretch"
                        Description="{x:Bind ViewModel.MachineNamingModeDescription, Mode=OneWay}"
                        Header="{x:Bind ViewModel.MachineNamingModeLabel, Mode=OneWay}">
                        <StackPanel
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="{ThemeResource FoundrySpace24}">
                            <RadioButton
                                Content="{x:Bind ViewModel.MachineNamingManualLabel, Mode=OneWay}"
                                GroupName="MachineNamingMode"
                                IsChecked="{x:Bind ViewModel.IsManualMachineNamingMode, Mode=TwoWay}" />
                            <RadioButton
                                Content="{x:Bind ViewModel.MachineNamingComposedLabel, Mode=OneWay}"
                                GroupName="MachineNamingMode"
                                IsChecked="{x:Bind ViewModel.IsComposedMachineNamingMode, Mode=TwoWay}" />
                        </StackPanel>
                    </wct:SettingsCard>

                    <wct:SettingsCard
                        HorizontalContentAlignment="Stretch"
                        Description="{x:Bind ViewModel.MachineNamingManualDescription, Mode=OneWay}"
                        Header="{x:Bind ViewModel.MachineNamingManualLabel, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ManualMachineNamingVisibility, Mode=OneWay}">
                        <StackPanel
                            HorizontalAlignment="Stretch"
                            Spacing="{ThemeResource FoundrySpace4}">
                            <TextBox
                                Width="{ThemeResource FoundryWideInputMinWidth}"
                                HorizontalAlignment="Right"
                                AutomationProperties.Name="{x:Bind ViewModel.MachineNamingManualLabel, Mode=OneWay}"
                                MaxLength="15"
                                Text="{x:Bind ViewModel.ManualMachineName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Text="{x:Bind ViewModel.MachineNamingValidationMessage, Mode=OneWay}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{x:Bind ViewModel.MachineNamingValidationVisibility, Mode=OneWay}" />
                        </StackPanel>
                    </wct:SettingsCard>

                    <wct:SettingsCard
                        HorizontalContentAlignment="Stretch"
                        ContentAlignment="Vertical"
                        Description="{x:Bind ViewModel.MachineNamingComponentsDescription, Mode=OneWay}"
                        Header="{x:Bind ViewModel.MachineNamingComponentsLabel, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ComposedMachineNamingVisibility, Mode=OneWay}">
                        <StackPanel
                            HorizontalAlignment="Stretch"
                            Spacing="{ThemeResource FoundrySpace16}">
                            <CommandBar
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                IsDynamicOverflowEnabled="False">
                                <CommandBar.Content>
                                    <Grid
                                        HorizontalAlignment="Stretch"
                                        ColumnSpacing="{ThemeResource FoundryInlineControlSpacing}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox
                                            MinWidth="{ThemeResource FoundrySettingsActionMinWidth}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{x:Bind ViewModel.MachineNamingAddComponentText, Mode=OneWay}"
                                            ItemsSource="{x:Bind ViewModel.AvailableMachineNameComponentTypes, Mode=OneWay}"
                                            SelectedItem="{x:Bind ViewModel.SelectedAvailableMachineNameComponent, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="viewModels:MachineNameComponentChoice">
                                                    <TextBlock
                                                        Text="{x:Bind DisplayName, Mode=OneTime}"
                                                        TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button
                                            Grid.Column="1"
                                            MinWidth="{ThemeResource FoundryCompactActionMinWidth}"
                                            VerticalAlignment="Center"
                                            Click="AddComponentButton_Click"
                                            Content="{x:Bind ViewModel.MachineNamingAddComponentText, Mode=OneWay}"
                                            IsEnabled="{x:Bind ViewModel.CanAddMachineNameComponent, Mode=OneWay}"
                                            Style="{StaticResource AccentButtonStyle}" />
                                        <AppBarSeparator
                                            Grid.Column="2"
                                            VerticalAlignment="Stretch" />
                                        <StackPanel
                                            Grid.Column="3"
                                            MinWidth="{ThemeResource FoundryCompactInputMinWidth}"
                                            VerticalAlignment="Center"
                                            Spacing="{ThemeResource FoundrySpace4}">
                                            <TextBlock
                                                Style="{ThemeResource FoundryCaptionTextBlockStyle}"
                                                Text="{x:Bind ViewModel.MachineNamingSeparatorLabel, Mode=OneWay}" />
                                            <ComboBox
                                                HorizontalAlignment="Stretch"
                                                ItemsSource="{x:Bind ViewModel.MachineNameSeparatorChoices, Mode=OneWay}"
                                                SelectedItem="{x:Bind ViewModel.SelectedMachineNameSeparator, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:MachineNameSeparatorChoice">
                                                        <TextBlock
                                                            Text="{x:Bind DisplayName, Mode=OneTime}"
                                                            TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <AppBarSeparator
                                            Grid.Column="4"
                                            VerticalAlignment="Stretch" />
                                        <StackPanel
                                            Grid.Column="5"
                                            MinWidth="{ThemeResource FoundrySettingsActionMinWidth}"
                                            VerticalAlignment="Center"
                                            Spacing="{ThemeResource FoundrySpace4}">
                                            <TextBlock
                                                Style="{ThemeResource FoundryCaptionTextBlockStyle}"
                                                Text="{x:Bind ViewModel.MachineNamingCasingLabel, Mode=OneWay}" />
                                            <ComboBox
                                                HorizontalAlignment="Stretch"
                                                ItemsSource="{x:Bind ViewModel.MachineNameCasingChoices, Mode=OneWay}"
                                                SelectedItem="{x:Bind ViewModel.SelectedMachineNameCasing, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:MachineNameCasingChoice">
                                                        <TextBlock
                                                            Text="{x:Bind DisplayName, Mode=OneTime}"
                                                            TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <AppBarSeparator
                                            Grid.Column="6"
                                            VerticalAlignment="Stretch" />
                                        <StackPanel
                                            Grid.Column="7"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            Spacing="{ThemeResource FoundrySpace4}">
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Style="{ThemeResource FoundryCaptionTextBlockStyle}"
                                                Text="{x:Bind ViewModel.MachineNamingPreviewLabel, Mode=OneWay}"
                                                TextAlignment="Right" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind ViewModel.MachineNamingPreview, Mode=OneWay}"
                                                TextAlignment="Right"
                                                TextWrapping="WrapWholeWords" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{ThemeResource FoundryCaptionTextBlockStyle}"
                                                Text="{x:Bind ViewModel.MachineNamingBudgetText, Mode=OneWay}"
                                                TextAlignment="Right"
                                                TextWrapping="WrapWholeWords" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                Text="{x:Bind ViewModel.MachineNamingValidationMessage, Mode=OneWay}"
                                                TextAlignment="Right"
                                                TextWrapping="WrapWholeWords"
                                                Visibility="{x:Bind ViewModel.MachineNamingValidationVisibility, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                </CommandBar.Content>
                            </CommandBar>

                            <ItemsControl
                                MaxWidth="{ThemeResource FoundryContentMaxWidth}"
                                HorizontalContentAlignment="Stretch"
                                ItemsSource="{x:Bind ViewModel.MachineNameComponents, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="{ThemeResource FoundrySpace12}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter
                                            Property="HorizontalContentAlignment"
                                            Value="Stretch" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:MachineNameComponentRowViewModel">
                                        <Border
                                            Padding="16,12"
                                            HorizontalAlignment="Stretch"
                                            Background="{ThemeResource FoundrySurfaceBrush}"
                                            BorderBrush="{ThemeResource FoundrySurfaceBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{ThemeResource FoundryCardCornerRadius}">
                                            <Grid
                                                MinHeight="48"
                                                ColumnSpacing="{ThemeResource FoundrySpace16}"
                                                RowSpacing="{ThemeResource FoundrySpace8}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{ThemeResource FoundryCompactInputMinWidth}" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                    Text="{x:Bind DisplayName, Mode=OneWay}"
                                                    TextWrapping="Wrap" />
                                                <Grid
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center"
                                                    ColumnSpacing="{ThemeResource FoundryInlineControlSpacing}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{ThemeResource FoundryCompactInputMinWidth}" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox
                                                        Grid.ColumnSpan="2"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}"
                                                        MaxLength="15"
                                                        Text="{x:Bind StaticText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Visibility="{x:Bind StaticTextVisibility, Mode=OneWay}" />
                                                    <NumberBox
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}"
                                                        Maximum="15"
                                                        Minimum="1"
                                                        SmallChange="1"
                                                        SpinButtonPlacementMode="Compact"
                                                        ValidationMode="InvalidInputOverwritten"
                                                        Visibility="{x:Bind MaximumLengthVisibility, Mode=OneWay}"
                                                        Value="{x:Bind MaximumLength, Mode=TwoWay}" />
                                                    <ComboBox
                                                        Grid.Column="1"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}"
                                                        SelectedIndex="{x:Bind TruncationIndex, Mode=TwoWay}"
                                                        Visibility="{x:Bind TruncationVisibility, Mode=OneWay}">
                                                        <ComboBoxItem x:Uid="MachineNamingKeepLeftOption" />
                                                        <ComboBoxItem x:Uid="MachineNamingKeepRightOption" />
                                                    </ComboBox>
                                                </Grid>
                                                <StackPanel
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="{ThemeResource FoundryInlineControlSpacing}">
                                                    <Button
                                                        x:Uid="MachineNamingMoveUpButton"
                                                        MinWidth="40"
                                                        MinHeight="40"
                                                        Padding="{ThemeResource FoundrySpace8}"
                                                        Click="MoveComponentUpButton_Click"
                                                        IsEnabled="{x:Bind CanMoveUp, Mode=OneWay}"
                                                        Tag="{x:Bind}">
                                                        <FontIcon Glyph="&#xE70E;" />
                                                    </Button>
                                                    <Button
                                                        x:Uid="MachineNamingMoveDownButton"
                                                        MinWidth="40"
                                                        MinHeight="40"
                                                        Padding="{ThemeResource FoundrySpace8}"
                                                        Click="MoveComponentDownButton_Click"
                                                        IsEnabled="{x:Bind CanMoveDown, Mode=OneWay}"
                                                        Tag="{x:Bind}">
                                                        <FontIcon Glyph="&#xE70D;" />
                                                    </Button>
                                                    <Button
                                                        x:Uid="MachineNamingRemoveButton"
                                                        MinWidth="40"
                                                        MinHeight="40"
                                                        Padding="{ThemeResource FoundrySpace8}"
                                                        Click="RemoveComponentButton_Click"
                                                        Tag="{x:Bind}">
                                                        <SymbolIcon Symbol="Delete" />
                                                    </Button>
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Grid.ColumnSpan="2"
                                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                    Text="{x:Bind ValidationMessage, Mode=OneWay}"
                                                    TextWrapping="WrapWholeWords"
                                                    Visibility="{x:Bind ValidationVisibility, Mode=OneWay}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </wct:SettingsCard>

                    <wct:SettingsCard
                        Description="{x:Bind ViewModel.MachineNamingEditingDescription, Mode=OneWay}"
                        Header="{x:Bind ViewModel.MachineNamingEditingLabel, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ComposedMachineNamingVisibility, Mode=OneWay}">
                        <ToggleSwitch
                            behaviors:LocalizedToggleSwitch.UseLocalizedStateContent="True"
                            IsOn="{x:Bind ViewModel.AllowMachineNameEditingDuringDeployment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </wct:SettingsCard>

                </StackPanel>
            </ContentControl>
        </StackPanel>
    </ScrollView>
</Page>
