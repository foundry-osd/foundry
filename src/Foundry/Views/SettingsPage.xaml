<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Foundry.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Foundry.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Foundry.Views"
    xmlns:wct="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">
    <ScrollView
        Margin="{ThemeResource ContentPageMargin}"
        Padding="{ThemeResource ContentPagePadding}"
        HorizontalAlignment="Stretch"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="{ThemeResource FoundryCompactStackSpacing}">
            <wct:SettingsCard x:Name="GeneralSettingsCard"
                x:Uid="SettingsPage_GeneralCard"
                Click="GeneralSettingsCard_Click"
                IsClickEnabled="True">
                <wct:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE713;" />
                </wct:SettingsCard.HeaderIcon>
            </wct:SettingsCard>
            <wct:SettingsCard x:Name="TelemetryCard"
                x:Uid="SettingsPage_TelemetryCard">
                <wct:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9D9;" />
                </wct:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="TelemetryToggle"
                    behaviors:LocalizedToggleSwitch.UseLocalizedStateContent="True"
                    IsOn="{x:Bind ViewModel.IsTelemetryEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </wct:SettingsCard>
            <wct:SettingsCard x:Name="RemoteDiagnosticsCard"
                x:Uid="SettingsPage_RemoteDiagnosticsCard">
                <wct:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9D9;" />
                </wct:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="RemoteDiagnosticsToggle"
                    behaviors:LocalizedToggleSwitch.UseLocalizedStateContent="True"
                    IsOn="{x:Bind ViewModel.IsRemoteDiagnosticsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </wct:SettingsCard>
            <wct:SettingsCard x:Name="ProxySettingsCard"
                x:Uid="SettingsPage_ProxyCard"
                Click="ProxySettingsCard_Click"
                IsClickEnabled="True">
                <wct:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE774;" />
                </wct:SettingsCard.HeaderIcon>
            </wct:SettingsCard>
            <wct:SettingsCard x:Name="ThemeSettingsCard"
                x:Uid="SettingsPage_ThemeCard"
                Click="ThemeSettingsCard_Click"
                IsClickEnabled="True">
                <wct:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE790;" />
                </wct:SettingsCard.HeaderIcon>
            </wct:SettingsCard>
            <wct:SettingsCard x:Name="UpdateSettingsCard"
                x:Uid="SettingsPage_UpdateCard"
                Click="UpdateSettingsCard_Click"
                IsClickEnabled="True">
                <wct:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE895;" />
                </wct:SettingsCard.HeaderIcon>
            </wct:SettingsCard>
        </StackPanel>
    </ScrollView>
</Page>

