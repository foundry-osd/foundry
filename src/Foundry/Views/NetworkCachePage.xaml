<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Foundry.Views.NetworkCachePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Foundry.Controls"
    xmlns:tv="using:WinUI.TableView"
    xmlns:wct="using:CommunityToolkit.WinUI.Controls">
    <ScrollView
        Margin="{ThemeResource ContentPageMargin}"
        Padding="{ThemeResource ContentPagePadding}"
        HorizontalContentAlignment="Stretch"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            HorizontalAlignment="Stretch"
            Spacing="{ThemeResource FoundrySettingsSectionSpacing}">
            <controls:PageHeader
                x:Uid="NetworkCachePageHeader"
                DocumentationUrl="{x:Bind ViewModel.DocumentationUrl, Mode=OneWay}"
                IconGlyph="&#xE968;">
                <controls:PageHeader.ActionContent>
                    <ContentControl IsEnabled="{x:Bind Managed.IsEditable, Mode=OneWay}">
                        <Button
                            Command="{x:Bind ViewModel.ToggleEnabledCommand}"
                            Content="{x:Bind ViewModel.ActionText, Mode=OneWay}" />
                    </ContentControl>
                </controls:PageHeader.ActionContent>
            </controls:PageHeader>
            <controls:ManagedConfigurationBanner />

            <ContentControl
                HorizontalContentAlignment="Stretch"
                IsEnabled="{x:Bind ViewModel.IsActive, Mode=OneWay}">
                <StackPanel Spacing="{ThemeResource FoundrySettingsSectionSpacing}">
                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasMediaProtectionIssue, Mode=OneWay}"
                        Message="{x:Bind ViewModel.MediaProtectionMessage, Mode=OneWay}"
                        Severity="Warning"
                        Visibility="{x:Bind ViewModel.HasMediaProtectionIssue, Mode=OneWay}" />

                    <wct:SettingsCard
                        HorizontalContentAlignment="Stretch"
                        ContentAlignment="Vertical"
                        Description="{x:Bind ViewModel.AccountsDescription, Mode=OneWay}"
                        Header="{x:Bind ViewModel.AccountsHeader, Mode=OneWay}">
                        <wct:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8D7;" />
                        </wct:SettingsCard.HeaderIcon>
                        <StackPanel Spacing="{ThemeResource FoundryContentGroupSpacing}">
                            <ScrollViewer
                                HorizontalScrollBarVisibility="Auto"
                                HorizontalScrollMode="Enabled"
                                IsTabStop="False"
                                VerticalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Disabled">
                                <CommandBar
                                    HorizontalAlignment="Left"
                                    DefaultLabelPosition="Right"
                                    IsDynamicOverflowEnabled="False"
                                    OverflowButtonVisibility="Collapsed">
                                    <CommandBar.PrimaryCommands>
                                        <AppBarButton
                                            Command="{x:Bind ViewModel.AddAccountCommand}"
                                            Label="{x:Bind ViewModel.AddLabel, Mode=OneWay}">
                                            <AppBarButton.Icon>
                                                <FontIcon Glyph="&#xE710;" />
                                            </AppBarButton.Icon>
                                        </AppBarButton>
                                        <AppBarButton
                                            Command="{x:Bind ViewModel.EditAccountCommand}"
                                            Icon="Edit"
                                            Label="{x:Bind ViewModel.EditLabel, Mode=OneWay}" />
                                        <AppBarButton
                                            Command="{x:Bind ViewModel.RemoveAccountCommand}"
                                            Icon="Delete"
                                            Label="{x:Bind ViewModel.RemoveLabel, Mode=OneWay}" />
                                    </CommandBar.PrimaryCommands>
                                </CommandBar>
                            </ScrollViewer>
                            <TextBlock
                                Style="{ThemeResource FoundrySecondaryBodyTextBlockStyle}"
                                Text="{x:Bind ViewModel.EmptyAccountsText, Mode=OneWay}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{x:Bind ViewModel.EmptyAccountsVisibility, Mode=OneWay}" />
                            <tv:TableView x:Name="AccountsTable"
                                MaxHeight="{ThemeResource FoundryTableMaxHeight}"
                                AutoGenerateColumns="False"
                                CanFilterColumns="False"
                                CanReorderColumns="False"
                                CanResizeColumns="True"
                                CanSortColumns="True"
                                CornerButtonMode="None"
                                HeadersVisibility="Columns"
                                IsReadOnly="True"
                                ItemsSource="{x:Bind ViewModel.Accounts, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedAccount, Mode=TwoWay}"
                                SelectionMode="Single"
                                SelectionUnit="Row"
                                ShowExportOptions="False"
                                Visibility="{x:Bind ViewModel.AccountListVisibility, Mode=OneWay}">
                                <!--  Proportional widths keep rows aligned; automatic widths lag when several rows arrive at once.  -->
                                <tv:TableView.Columns>
                                    <tv:TableViewTextColumn
                                        Width="4*"
                                        Binding="{Binding UserName}"
                                        Header="{x:Bind ViewModel.UserNameColumnHeader, Mode=OneWay}" />
                                    <tv:TableViewTextColumn
                                        Width="2*"
                                        Binding="{Binding PasswordText}"
                                        Header="{x:Bind ViewModel.PasswordColumnHeader, Mode=OneWay}" />
                                    <tv:TableViewTextColumn
                                        Width="*"
                                        Binding="{Binding UsedByCount}"
                                        Header="{x:Bind ViewModel.UsedByColumnHeader, Mode=OneWay}" />
                                    <tv:TableViewTemplateColumn
                                        Width="3*"
                                        Header="{x:Bind ViewModel.StatusColumnHeader, Mode=OneWay}"
                                        SortMemberPath="StatusText">
                                        <tv:TableViewTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    Margin="12,0,12,0"
                                                    Style="{Binding StatusStyle}"
                                                    Text="{Binding StatusText}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTipService.ToolTip="{Binding StatusText}" />
                                            </DataTemplate>
                                        </tv:TableViewTemplateColumn.CellTemplate>
                                    </tv:TableViewTemplateColumn>
                                </tv:TableView.Columns>
                            </tv:TableView>
                        </StackPanel>
                    </wct:SettingsCard>

                    <wct:SettingsCard
                        HorizontalContentAlignment="Stretch"
                        ContentAlignment="Vertical"
                        Description="{x:Bind ViewModel.SharesDescription, Mode=OneWay}"
                        Header="{x:Bind ViewModel.SharesHeader, Mode=OneWay}">
                        <wct:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8CE;" />
                        </wct:SettingsCard.HeaderIcon>
                        <StackPanel Spacing="{ThemeResource FoundryContentGroupSpacing}">
                            <ScrollViewer
                                HorizontalScrollBarVisibility="Auto"
                                HorizontalScrollMode="Enabled"
                                IsTabStop="False"
                                VerticalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Disabled">
                                <CommandBar
                                    HorizontalAlignment="Left"
                                    DefaultLabelPosition="Right"
                                    IsDynamicOverflowEnabled="False"
                                    IsEnabled="{x:Bind Managed.IsEditable, Mode=OneWay}"
                                    OverflowButtonVisibility="Collapsed">
                                    <CommandBar.PrimaryCommands>
                                        <AppBarButton
                                            Command="{x:Bind ViewModel.AddShareCommand}"
                                            Label="{x:Bind ViewModel.AddLabel, Mode=OneWay}">
                                            <AppBarButton.Icon>
                                                <FontIcon Glyph="&#xE710;" />
                                            </AppBarButton.Icon>
                                        </AppBarButton>
                                        <AppBarButton
                                            Command="{x:Bind ViewModel.EditShareCommand}"
                                            Icon="Edit"
                                            Label="{x:Bind ViewModel.EditLabel, Mode=OneWay}" />
                                        <AppBarButton
                                            Command="{x:Bind ViewModel.RemoveShareCommand}"
                                            Icon="Delete"
                                            Label="{x:Bind ViewModel.RemoveLabel, Mode=OneWay}" />
                                    </CommandBar.PrimaryCommands>
                                </CommandBar>
                            </ScrollViewer>
                            <TextBlock
                                Style="{ThemeResource FoundrySecondaryBodyTextBlockStyle}"
                                Text="{x:Bind ViewModel.EmptySharesText, Mode=OneWay}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{x:Bind ViewModel.EmptySharesVisibility, Mode=OneWay}" />
                            <TextBlock
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Text="{x:Bind ViewModel.SharesValidationMessage, Mode=OneWay}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{x:Bind ViewModel.SharesValidationVisibility, Mode=OneWay}" />
                            <tv:TableView x:Name="SharesTable"
                                MaxHeight="{ThemeResource FoundryTableMaxHeight}"
                                AutoGenerateColumns="False"
                                CanFilterColumns="False"
                                CanReorderColumns="False"
                                CanResizeColumns="True"
                                CanSortColumns="True"
                                CornerButtonMode="None"
                                HeadersVisibility="Columns"
                                IsReadOnly="True"
                                ItemsSource="{x:Bind ViewModel.Shares, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedShare, Mode=TwoWay}"
                                SelectionMode="Single"
                                SelectionUnit="Row"
                                ShowExportOptions="False"
                                Visibility="{x:Bind ViewModel.ShareListVisibility, Mode=OneWay}">
                                <!--  Proportional widths keep rows aligned; automatic widths lag when several rows arrive at once.  -->
                                <tv:TableView.Columns>
                                    <tv:TableViewTextColumn
                                        Width="4*"
                                        Binding="{Binding Path}"
                                        Header="{x:Bind ViewModel.PathColumnHeader, Mode=OneWay}" />
                                    <tv:TableViewTextColumn
                                        Width="3*"
                                        Binding="{Binding AccountText}"
                                        Header="{x:Bind ViewModel.AccountColumnHeader, Mode=OneWay}" />
                                    <tv:TableViewTemplateColumn
                                        Width="3*"
                                        Header="{x:Bind ViewModel.StatusColumnHeader, Mode=OneWay}"
                                        SortMemberPath="StatusText">
                                        <tv:TableViewTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    Margin="12,0,12,0"
                                                    Style="{Binding StatusStyle}"
                                                    Text="{Binding StatusText}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTipService.ToolTip="{Binding StatusText}" />
                                            </DataTemplate>
                                        </tv:TableViewTemplateColumn.CellTemplate>
                                    </tv:TableViewTemplateColumn>
                                </tv:TableView.Columns>
                            </tv:TableView>
                        </StackPanel>
                    </wct:SettingsCard>

                    <wct:SettingsCard
                        HorizontalContentAlignment="Stretch"
                        ContentAlignment="Vertical"
                        Description="{x:Bind ViewModel.ScopesDescription, Mode=OneWay}"
                        Header="{x:Bind ViewModel.ScopesHeader, Mode=OneWay}">
                        <wct:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE774;" />
                        </wct:SettingsCard.HeaderIcon>
                        <StackPanel Spacing="{ThemeResource FoundryContentGroupSpacing}">
                            <ScrollViewer
                                HorizontalScrollBarVisibility="Auto"
                                HorizontalScrollMode="Enabled"
                                IsTabStop="False"
                                VerticalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Disabled">
                                <CommandBar
                                    HorizontalAlignment="Left"
                                    DefaultLabelPosition="Right"
                                    IsDynamicOverflowEnabled="False"
                                    IsEnabled="{x:Bind Managed.IsEditable, Mode=OneWay}"
                                    OverflowButtonVisibility="Collapsed">
                                    <CommandBar.PrimaryCommands>
                                        <AppBarButton
                                            Command="{x:Bind ViewModel.AddScopeCommand}"
                                            Label="{x:Bind ViewModel.AddLabel, Mode=OneWay}">
                                            <AppBarButton.Icon>
                                                <FontIcon Glyph="&#xE710;" />
                                            </AppBarButton.Icon>
                                        </AppBarButton>
                                        <AppBarButton
                                            Command="{x:Bind ViewModel.EditScopeCommand}"
                                            Icon="Edit"
                                            Label="{x:Bind ViewModel.EditLabel, Mode=OneWay}" />
                                        <AppBarButton
                                            Command="{x:Bind ViewModel.RemoveScopeCommand}"
                                            Icon="Delete"
                                            Label="{x:Bind ViewModel.RemoveLabel, Mode=OneWay}" />
                                    </CommandBar.PrimaryCommands>
                                </CommandBar>
                            </ScrollViewer>
                            <TextBlock
                                Style="{ThemeResource FoundrySecondaryBodyTextBlockStyle}"
                                Text="{x:Bind ViewModel.EmptyScopesText, Mode=OneWay}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{x:Bind ViewModel.EmptyScopesVisibility, Mode=OneWay}" />
                            <TextBlock
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Text="{x:Bind ViewModel.ScopesValidationMessage, Mode=OneWay}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{x:Bind ViewModel.ScopesValidationVisibility, Mode=OneWay}" />
                            <tv:TableView x:Name="ScopesTable"
                                MaxHeight="{ThemeResource FoundryTableMaxHeight}"
                                AutoGenerateColumns="False"
                                CanFilterColumns="False"
                                CanReorderColumns="False"
                                CanResizeColumns="True"
                                CanSortColumns="True"
                                CornerButtonMode="None"
                                HeadersVisibility="Columns"
                                IsReadOnly="True"
                                ItemsSource="{x:Bind ViewModel.Scopes, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedScope, Mode=TwoWay}"
                                SelectionMode="Single"
                                SelectionUnit="Row"
                                ShowExportOptions="False"
                                Visibility="{x:Bind ViewModel.ScopeListVisibility, Mode=OneWay}">
                                <!--  Proportional widths keep rows aligned; automatic widths lag when several rows arrive at once.  -->
                                <tv:TableView.Columns>
                                    <tv:TableViewTextColumn
                                        Width="2*"
                                        Binding="{Binding Name}"
                                        Header="{x:Bind ViewModel.NameColumnHeader, Mode=OneWay}" />
                                    <tv:TableViewTextColumn
                                        Width="*"
                                        Binding="{Binding KindText}"
                                        Header="{x:Bind ViewModel.TypeColumnHeader, Mode=OneWay}" />
                                    <tv:TableViewTextColumn
                                        Width="2*"
                                        Binding="{Binding Value}"
                                        Header="{x:Bind ViewModel.ValueColumnHeader, Mode=OneWay}" />
                                    <tv:TableViewTextColumn
                                        Width="3*"
                                        Binding="{Binding SharesText}"
                                        Header="{x:Bind ViewModel.SharesColumnHeader, Mode=OneWay}" />
                                    <tv:TableViewTemplateColumn
                                        Width="2*"
                                        Header="{x:Bind ViewModel.StatusColumnHeader, Mode=OneWay}"
                                        SortMemberPath="StatusText">
                                        <tv:TableViewTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    Margin="12,0,12,0"
                                                    Style="{Binding StatusStyle}"
                                                    Text="{Binding StatusText}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTipService.ToolTip="{Binding StatusText}" />
                                            </DataTemplate>
                                        </tv:TableViewTemplateColumn.CellTemplate>
                                    </tv:TableViewTemplateColumn>
                                </tv:TableView.Columns>
                            </tv:TableView>
                            <TextBlock
                                Style="{ThemeResource FoundrySecondaryBodyTextBlockStyle}"
                                Text="{x:Bind ViewModel.ScopesSpecificityText, Mode=OneWay}"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </wct:SettingsCard>
                </StackPanel>
            </ContentControl>
        </StackPanel>
    </ScrollView>
</Page>
