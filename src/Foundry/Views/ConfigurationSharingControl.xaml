<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Foundry.Views.ConfigurationSharingControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wct="using:CommunityToolkit.WinUI.Controls">
    <StackPanel Spacing="{ThemeResource FoundryCompactStackSpacing}">
        <wct:SettingsExpander
            Description="{x:Bind ViewModel.Text('Sharing.CardDescription')}"
            Header="{x:Bind ViewModel.Text('Sharing.CardHeader')}">
            <wct:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xE72D;" />
            </wct:SettingsExpander.HeaderIcon>
            <wct:SettingsExpander.Items>
                <wct:SettingsCard
                    Description="{x:Bind ViewModel.Text('Sharing.ExportDescription')}"
                    Header="{x:Bind ViewModel.Text('Sharing.ExportTitle')}">
                    <wct:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE74E;" />
                    </wct:SettingsCard.HeaderIcon>
                    <Button
                        MinWidth="{ThemeResource FoundryCompactActionMinWidth}"
                        Command="{x:Bind ViewModel.ExportCommand}"
                        Content="{x:Bind ViewModel.Text('Sharing.ExportButton')}" />
                </wct:SettingsCard>
                <wct:SettingsCard
                    Description="{x:Bind ViewModel.Text('Sharing.ImportDescription')}"
                    Header="{x:Bind ViewModel.Text('Sharing.ImportTitle')}">
                    <wct:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8B5;" />
                    </wct:SettingsCard.HeaderIcon>
                    <Button
                        MinWidth="{ThemeResource FoundryCompactActionMinWidth}"
                        Command="{x:Bind ViewModel.ImportCommand}"
                        Content="{x:Bind ViewModel.Text('Sharing.ImportButton')}" />
                </wct:SettingsCard>
            </wct:SettingsExpander.Items>
        </wct:SettingsExpander>
        <InfoBar
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay}" />
    </StackPanel>
</UserControl>
