<Window x:Class="Foundry.AutopilotInteractive.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Foundry.Wpf.Controls;assembly=Foundry.Wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:Foundry.AutopilotInteractive.Views"
    Title="{Binding WindowTitle}"
    Icon="/Assets/Icons/app.ico"
    ResizeMode="NoResize"
    Topmost="True"
    WindowState="Maximized"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Panel.ZIndex="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Menu Grid.Column="0">
                <MenuItem Header="{Binding Strings[Menu.Theme]}">
                    <MenuItem
                        Command="{Binding SetSystemThemeCommand}"
                        Header="{Binding Strings[Theme.System]}" />
                    <MenuItem
                        Command="{Binding SetLightThemeCommand}"
                        Header="{Binding Strings[Theme.Light]}" />
                    <MenuItem
                        Command="{Binding SetDarkThemeCommand}"
                        Header="{Binding Strings[Theme.Dark]}" />
                </MenuItem>
                <MenuItem
                    Header="{Binding Strings[Menu.Language]}"
                    ItemsSource="{Binding SupportedCultures}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="{x:Type MenuItem}">
                            <Setter
                                Property="Header"
                                Value="{Binding DisplayName}" />
                            <Setter
                                Property="Command"
                                Value="{Binding DataContext.SetCultureCommand, RelativeSource={RelativeSource AncestorType={x:Type Menu}}}" />
                            <Setter
                                Property="CommandParameter"
                                Value="{Binding Code}" />
                            <Setter
                                Property="IsCheckable"
                                Value="True" />
                            <Setter
                                Property="IsChecked"
                                Value="{Binding IsSelected, Mode=OneWay}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <!--  Debug safety mode only: hidden here, and the command refuses to run outside it. Each entry restarts the run.  -->
                <MenuItem
                    Header="{Binding Strings[Menu.Debug]}"
                    ItemsSource="{Binding DebugScenarios}"
                    Visibility="{Binding IsDebugMenuVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="{x:Type MenuItem}">
                            <Setter
                                Property="Header"
                                Value="{Binding Header}" />
                            <Setter
                                Property="Command"
                                Value="{Binding DataContext.SetDebugScenarioCommand, RelativeSource={RelativeSource AncestorType={x:Type Menu}}}" />
                            <Setter
                                Property="CommandParameter"
                                Value="{Binding Scenario}" />
                            <Setter
                                Property="IsCheckable"
                                Value="True" />
                            <Setter
                                Property="IsChecked"
                                Value="{Binding IsSelected, Mode=OneWay}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem
                    Command="{Binding ShowAboutCommand}"
                    Header="{Binding Strings[Menu.About]}" />
            </Menu>

            <TextBlock
                Grid.Column="1"
                Margin="0,0,16,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{Binding VersionDisplay}" />
        </Grid>

        <!--  Page host: pages are centered and capped like Foundry Deploy; the transform serves TransitionAnimator.FadeAndTranslateY.  -->
        <Grid x:Name="ContentHost"
            Grid.Row="1"
            Margin="16"
            RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ContentTransform" />
            </Grid.RenderTransform>
            <Grid
                Width="{Binding ElementName=ContentHost, Path=ActualWidth}"
                Height="{Binding ElementName=ContentHost, Path=ActualHeight}"
                MaxWidth="1440"
                MaxHeight="900"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Grid x:Name="PageHost">
                    <views:SignInView
                        DataContext="{Binding SignIn}"
                        Visibility="{Binding DataContext.IsSignInPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <views:GroupTagView
                        DataContext="{Binding GroupTag}"
                        Visibility="{Binding DataContext.IsGroupTagPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Grid>
        </Grid>

        <!--  The deadline message covers the top of whichever page is shown for its few seconds before the exit.  -->
        <controls:InfoBar
            Grid.Row="1"
            MaxWidth="760"
            Margin="16"
            VerticalAlignment="Top"
            Panel.ZIndex="1"
            AutomationProperties.LiveSetting="Assertive"
            Message="{Binding DeadlineMessage}"
            Severity="Warning"
            Visibility="{Binding HasDeadlineMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Border
            Grid.Row="2"
            Padding="16,8"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{Binding DeviceFooter}" />
        </Border>
    </Grid>
</Window>
