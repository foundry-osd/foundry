<UserControl x:Class="Foundry.AutopilotInteractive.Views.SignInView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Foundry.Wpf.Controls;assembly=Foundry.Wpf">
    <!--
        Page 1, bound to SignInViewModel. The content is centered horizontally and vertically in the page host and capped at
        760 px; the scroll viewer only scrolls when the window is shorter than the content (1024 x 768 with a banner).
        Sign-in area: URL | vertical separator with "or" | static QR code of the URL (200 px); below it the user code, the
        decreasing lifetime bar and its caption. While a new code is requested the address and the QR code stay and a small
        progress ring replaces the code. The user code is a plain TextBlock, so it cannot be selected.
    -->
    <ScrollViewer
        Focusable="False"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <StackPanel
                MaxWidth="760"
                Margin="0,16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{Binding Strings[SignIn.Title]}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{Binding Strings[SignIn.Description]}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />

                <controls:InfoBar
                    Margin="0,24,0,0"
                    AutomationProperties.LiveSetting="Assertive"
                    Message="{Binding BannerText}"
                    Severity="{Binding BannerSeverity}"
                    Visibility="{Binding HasBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <!--  Retry is set as the body only after a blocking error, so other banners keep their compact height.  -->
                    <controls:InfoBar.Style>
                        <Style TargetType="controls:InfoBar">
                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsRetryVisible}"
                                    Value="True">
                                    <Setter Property="Body">
                                        <Setter.Value>
                                            <Button
                                                HorizontalAlignment="Left"
                                                Command="{Binding RetryCommand}"
                                                Content="{Binding Strings[SignIn.Retry]}" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:InfoBar.Style>
                </controls:InfoBar>

                <!--  Fixed height: the page does not jump when the ring and the code area swap.  -->
                <Grid
                    Height="380"
                    Margin="0,24,0,0">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsBusyIndicatorFullArea, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <controls:CustomProgressRing
                            Width="56"
                            Height="56"
                            AutomationProperties.Name="{Binding BusyText}"
                            IsIndeterminate="True"
                            ProgressBrush="{DynamicResource AccentFillColorDefaultBrush}"
                            Thickness="6"
                            TrackBrush="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                        <TextBlock
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{Binding BusyText}" />
                    </StackPanel>

                    <StackPanel
                        VerticalAlignment="Center"
                        Visibility="{Binding IsAddressVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="320" />
                            </Grid.ColumnDefinitions>

                            <StackPanel
                                Grid.Column="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{Binding Strings[SignIn.OpenOnAnotherDevice]}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    Text="{Binding VerificationUriText}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Grid
                                Grid.Column="1"
                                Height="200"
                                Margin="24,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Rectangle
                                    Grid.Row="0"
                                    Width="1"
                                    HorizontalAlignment="Center"
                                    Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Margin="0,8"
                                    HorizontalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{Binding Strings[SignIn.Or]}" />
                                <Rectangle
                                    Grid.Row="2"
                                    Width="1"
                                    HorizontalAlignment="Center"
                                    Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
                            </Grid>

                            <StackPanel
                                Grid.Column="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <!--  The QR image is black on white whatever the theme; aliased edges keep the modules sharp.  -->
                                <Border
                                    Padding="0"
                                    HorizontalAlignment="Center"
                                    Background="White"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <Image
                                        Width="200"
                                        Height="200"
                                        AutomationProperties.Name="{Binding Strings[SignIn.ScanCaption]}"
                                        RenderOptions.EdgeMode="Aliased"
                                        Source="{Binding QrCodeImage}"
                                        Stretch="Uniform" />
                                </Border>
                                <TextBlock
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{Binding Strings[SignIn.ScanCaption]}" />
                            </StackPanel>
                        </Grid>

                        <!--  Fixed height: the address and the QR code do not move when the code and the small ring swap.  -->
                        <Grid
                            Height="120"
                            Margin="0,24,0,0">
                            <StackPanel
                                VerticalAlignment="Top"
                                Visibility="{Binding IsCodeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{Binding Strings[SignIn.EnterCode]}" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Center"
                                    AutomationProperties.LiveSetting="Polite"
                                    FontSize="40"
                                    FontWeight="SemiBold"
                                    Text="{Binding UserCode}" />
                                <ProgressBar
                                    Width="320"
                                    Height="4"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Center"
                                    AutomationProperties.Name="{Binding RemainingCaption}"
                                    Maximum="1"
                                    Minimum="0"
                                    Value="{Binding RemainingFraction, Mode=OneWay}" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{Binding RemainingCaption}" />
                            </StackPanel>
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsCodeBusyIndicatorVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <controls:CustomProgressRing
                                    Width="40"
                                    Height="40"
                                    AutomationProperties.Name="{Binding BusyText}"
                                    IsIndeterminate="True"
                                    ProgressBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                    Thickness="4"
                                    TrackBrush="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{Binding BusyText}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
