<UserControl x:Class="Foundry.AutopilotInteractive.Views.GroupTagView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Foundry.Wpf.Controls;assembly=Foundry.Wpf">
    <!--
        Page 2, bound to GroupTagViewModel. Same frame as page 1: centered horizontally and vertically, capped at 640 px,
        scrolling only when the window is too short. The form is replaced by the success panel once the registration
        completed; the progress area is shown while a registration or the profile wait runs.
    -->
    <ScrollViewer
        Focusable="False"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <StackPanel
                MaxWidth="640"
                Margin="0,16"
                VerticalAlignment="Center">
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{Binding Strings[GroupTag.Title]}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{Binding Strings[GroupTag.Description]}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextAlignment="Center"
                    TextWrapping="Wrap">
                    <Run Text="{Binding AccountText, Mode=OneWay}" />
                    <Run Text=" · " />
                    <Hyperlink Command="{Binding UseAnotherAccountCommand}">
                        <Run Text="{Binding Strings[GroupTag.UseAnotherAccount], Mode=OneWay}" />
                    </Hyperlink>
                </TextBlock>

                <controls:InfoBar
                    Title="{Binding RegisteredDeviceBannerTitle}"
                    Margin="0,20,0,0"
                    Message="{Binding RegisteredDeviceBanner}"
                    Severity="{Binding RegisteredDeviceBannerSeverity}"
                    Visibility="{Binding HasRegisteredDeviceBanner, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <controls:InfoBar
                    Margin="0,12,0,0"
                    Message="{Binding TagDiscoveryWarning}"
                    Severity="Warning"
                    Visibility="{Binding HasTagDiscoveryWarning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <controls:InfoBar
                    Margin="0,12,0,0"
                    AutomationProperties.LiveSetting="Assertive"
                    Message="{Binding FailureBanner}"
                    Severity="Error"
                    Visibility="{Binding HasFailure, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!--  Form: hidden once the registration completed.  -->
                <StackPanel Margin="0,20,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsCompleted}"
                                    Value="True">
                                    <Setter
                                        Property="Visibility"
                                        Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock
                        Margin="0,0,0,6"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{Binding Strings[GroupTag.Label]}" />
                    <ComboBox
                        AutomationProperties.Name="{Binding Strings[GroupTag.Label]}"
                        DisplayMemberPath="Label"
                        IsEnabled="{Binding IsEditable}"
                        ItemsSource="{Binding GroupTagOptions}"
                        SelectedItem="{Binding SelectedChoice}" />
                    <TextBlock
                        Margin="0,16,0,6"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{Binding Strings[GroupTag.CustomLabel]}" />
                    <TextBox x:Name="CustomTextBox"
                        AutomationProperties.Name="{Binding Strings[GroupTag.CustomLabel]}"
                        IsEnabled="{Binding IsCustomEnabled}"
                        Text="{Binding CustomText, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel
                        Margin="0,16,0,0"
                        Visibility="{Binding ShowAssignedUser, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            Margin="0,0,0,6"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{Binding Strings[GroupTag.AssignedUserLabel]}" />
                        <TextBox
                            AutomationProperties.HelpText="{Binding AssignedUserError}"
                            AutomationProperties.Name="{Binding Strings[GroupTag.AssignedUserLabel]}"
                            IsEnabled="{Binding IsEditable}"
                            Text="{Binding AssignedUser, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Margin="0,6,0,0"
                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{Binding AssignedUserError}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Button
                        MinWidth="140"
                        Margin="0,24,0,0"
                        HorizontalAlignment="Right"
                        Command="{Binding RegisterCommand}"
                        Content="{Binding Strings[GroupTag.Register]}"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>

                <!--  Registration steps and profile wait.  -->
                <StackPanel
                    Margin="0,24,0,0"
                    AutomationProperties.LiveSetting="Polite"
                    Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ProgressBar
                        Height="4"
                        IsIndeterminate="{Binding IsProgressIndeterminate}"
                        Maximum="100"
                        Value="{Binding ProgressValue, Mode=OneWay}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{Binding StatusText}"
                        TextWrapping="Wrap" />
                    <StackPanel Visibility="{Binding IsProfileWaiting, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{Binding ProfileWaitText}"
                            TextWrapping="Wrap" />
                        <Button
                            Margin="0,12,0,0"
                            HorizontalAlignment="Right"
                            Command="{Binding ContinueWithoutWaitingCommand}"
                            Content="{Binding Strings[Registration.ContinueWithoutWaiting]}" />
                    </StackPanel>
                </StackPanel>

                <!--  Success panel and countdown.  -->
                <StackPanel
                    Margin="0,24,0,0"
                    AutomationProperties.LiveSetting="Polite"
                    Visibility="{Binding IsCompleted, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <!--  The shared glyph is drawn at 180 px; the page shows it at 72 px.  -->
                    <Viewbox
                        Width="72"
                        Height="72"
                        HorizontalAlignment="Center">
                        <controls:TerminalStatusGlyph
                            AutomationName="{Binding Strings[Registration.Completed]}"
                            IsSuccess="True" />
                    </Viewbox>
                    <TextBlock
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{Binding Strings[Registration.Completed]}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Text="{Binding ProfileOutcomeText}"
                        TextAlignment="Center"
                        TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style
                                BasedOn="{StaticResource BodyTextBlockStyle}"
                                TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsProfileOutcomeWarning}"
                                        Value="True">
                                        <Setter
                                            Property="Foreground"
                                            Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{Binding CountdownText}" />
                    <Button
                        MinWidth="140"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        Command="{Binding ContinueNowCommand}"
                        Content="{Binding Strings[Registration.ContinueNow]}"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
