<UserControl x:Class="Foundry.Deploy.Controls.CustomProgressRing"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="120"
    MinHeight="120"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="ProgressArcStyle"
            TargetType="Path">
            <Setter
                Property="Fill"
                Value="Transparent" />
            <Setter
                Property="Stroke"
                Value="{Binding ProgressBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter
                Property="StrokeEndLineCap"
                Value="Round" />
            <Setter
                Property="StrokeStartLineCap"
                Value="Round" />
            <Setter
                Property="StrokeThickness"
                Value="{Binding Thickness, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="16"
                        Opacity="0.8"
                        ShadowDepth="0"
                        Color="#00B7FF" />
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Ellipse x:Name="TrackCircle"
            Fill="Transparent"
            Stroke="{Binding TrackBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
            StrokeThickness="{Binding Thickness, RelativeSource={RelativeSource AncestorType=UserControl}}" />

        <Path x:Name="DeterminateArc"
            Style="{StaticResource ProgressArcStyle}" />

        <Path x:Name="IndeterminateArc"
            Style="{StaticResource ProgressArcStyle}"
            Visibility="Collapsed">
            <Path.RenderTransform>
                <RotateTransform x:Name="IndeterminateRotateTransform" />
            </Path.RenderTransform>
        </Path>
    </Grid>
</UserControl>
