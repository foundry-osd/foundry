<UserControl x:Class="Foundry.Deploy.Controls.WizardPageHeader" x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Margin="0,0,0,32">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontFamily="{DynamicResource SymbolThemeFontFamily}"
            FontSize="24"
            Text="{Binding Glyph, ElementName=Root}" />
        <StackPanel
            Grid.Column="2"
            VerticalAlignment="Center">
            <TextBlock
                Style="{DynamicResource TitleTextBlockStyle}"
                Text="{Binding Title, ElementName=Root}"
                TextWrapping="Wrap" />
            <TextBlock
                Margin="0,4,0,0"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Style="{DynamicResource BodyTextBlockStyle}"
                Text="{Binding Description, ElementName=Root}"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
