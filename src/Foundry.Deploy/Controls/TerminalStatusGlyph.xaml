<UserControl x:Class="Foundry.Deploy.Controls.TerminalStatusGlyph" x:Name="ViewRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="180"
    Height="180">
    <Grid x:Name="GlyphHost"
        RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="GlyphScale"
                ScaleX="1"
                ScaleY="1" />
        </Grid.RenderTransform>
        <TextBlock x:Name="ForegroundGlyph"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.Name="{Binding AutomationName, ElementName=ViewRoot}"
            FontFamily="{DynamicResource SymbolThemeFontFamily}"
            FontSize="144"
            Text="{Binding Glyph, ElementName=ViewRoot}" />
    </Grid>
</UserControl>
