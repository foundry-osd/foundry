<Application x:Class="Foundry.Deploy.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Foundry.Deploy.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Foundry.Wpf;component/Themes/FoundryWpfStyles.xaml" />
                <ResourceDictionary Source="Themes/DeployStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:OsCatalogFilterDisplayConverter x:Key="OsCatalogFilterDisplayConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
