<UserControl x:Class="Foundry.Deploy.Views.WizardView" x:Name="ViewRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wizardViews="clr-namespace:Foundry.Deploy.Views.Wizard"
    d:DesignHeight="720"
    d:DesignWidth="1100"
    mc:Ignorable="d">
    <UserControl.Resources>
        <DataTemplate x:Key="TargetStepTemplate">
            <wizardViews:TargetStepView />
        </DataTemplate>
        <DataTemplate x:Key="OperatingSystemCatalogStepTemplate">
            <wizardViews:OperatingSystemCatalogStepView />
        </DataTemplate>
        <DataTemplate x:Key="DriverPackStepTemplate">
            <wizardViews:DriverPackStepView />
        </DataTemplate>
        <DataTemplate x:Key="AutopilotStepTemplate">
            <wizardViews:AutopilotStepView />
        </DataTemplate>
        <DataTemplate x:Key="SummaryStepTemplate">
            <wizardViews:SummaryStepView />
        </DataTemplate>

        <DataTemplate x:Key="VerticalStepTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="18" />
                </Grid.RowDefinitions>
                <Button x:Name="VerticalStepButton"
                    Grid.ColumnSpan="3"
                    AutomationProperties.Name="{Binding Title}"
                    Command="{Binding DataContext.NavigateToWizardStepCommand, ElementName=ViewRoot}"
                    CommandParameter="{Binding}"
                    IsEnabled="{Binding IsEnabled}"
                    Style="{StaticResource WizardStepperButtonStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="VerticalStepMarker"
                            Style="{StaticResource WizardStepMarkerStyle}">
                            <Grid>
                                <TextBlock x:Name="VerticalStepNumber"
                                    Style="{StaticResource WizardStepNumberStyle}"
                                    Text="{Binding DisplayNumber}" />
                                <TextBlock x:Name="VerticalStepCheck"
                                    Style="{StaticResource WizardStepCheckStyle}" />
                            </Grid>
                        </Border>
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource WizardStepTitleStyle}"
                            Text="{Binding Title}"
                            TextWrapping="Wrap" />
                    </Grid>
                </Button>
                <Border x:Name="VerticalStepConnector"
                    Grid.Row="1"
                    Grid.Column="0"
                    Width="2"
                    HorizontalAlignment="Center"
                    IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter
                                Property="Background"
                                Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsConnectorCompleted}"
                                    Value="True">
                                    <Setter
                                        Property="Background"
                                        Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger
                                    Binding="{Binding IsLast}"
                                    Value="True">
                                    <Setter
                                        Property="Visibility"
                                        Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CompactStepTemplate">
            <Button
                MinWidth="44"
                AutomationProperties.Name="{Binding Title}"
                Command="{Binding DataContext.NavigateToWizardStepCommand, ElementName=ViewRoot}"
                CommandParameter="{Binding}"
                IsEnabled="{Binding IsEnabled}"
                Style="{StaticResource WizardStepperButtonStyle}">
                <Grid Margin="2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border x:Name="CompactStepLeftConnector"
                        Grid.ColumnSpan="2"
                        Height="2"
                        VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter
                                    Property="Background"
                                    Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsPreviousConnectorCompleted}"
                                        Value="True">
                                        <Setter
                                            Property="Background"
                                            Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger
                                        Binding="{Binding IsFirst}"
                                        Value="True">
                                        <Setter
                                            Property="Visibility"
                                            Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Border x:Name="CompactStepRightConnector"
                        Grid.Column="2"
                        Grid.ColumnSpan="2"
                        Height="2"
                        VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter
                                    Property="Background"
                                    Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsConnectorCompleted}"
                                        Value="True">
                                        <Setter
                                            Property="Background"
                                            Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger
                                        Binding="{Binding IsLast}"
                                        Value="True">
                                        <Setter
                                            Property="Visibility"
                                            Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Border x:Name="CompactStepMarker"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Style="{StaticResource WizardStepMarkerStyle}">
                        <Grid>
                            <TextBlock x:Name="CompactStepNumber"
                                Style="{StaticResource WizardStepNumberStyle}"
                                Text="{Binding DisplayNumber}" />
                            <TextBlock Style="{StaticResource WizardStepCheckStyle}" />
                        </Grid>
                    </Border>
                    <TextBlock
                        Grid.Row="1"
                        Grid.ColumnSpan="4"
                        MaxWidth="150"
                        Margin="4,8,4,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Style="{StaticResource WizardStepTitleStyle}"
                        Text="{Binding Title}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="StepperColumn"
                Width="190" />
            <ColumnDefinition x:Name="StepperGapColumn"
                Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="CompactStepperRow"
                Height="0" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ItemsControl x:Name="VerticalStepper"
            Grid.Row="1"
            Grid.Column="0"
            AutomationProperties.Name="{Binding Strings[Wizard.StepperAutomationName]}"
            ItemTemplate="{StaticResource VerticalStepTemplate}"
            ItemsSource="{Binding WizardSteps}" />

        <ItemsControl x:Name="CompactStepper"
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="0,0,0,12"
            AutomationProperties.Name="{Binding Strings[Wizard.StepperAutomationName]}"
            ItemTemplate="{StaticResource CompactStepTemplate}"
            ItemsSource="{Binding WizardSteps}"
            Visibility="Collapsed">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <Border x:Name="WizardContentCard"
            Grid.Row="1"
            Grid.Column="2"
            Style="{StaticResource WizardContentCardStyle}">
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ContentControl x:Name="StepContent"
                    Content="{Binding}">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="StepContentTransform" />
                    </ContentControl.RenderTransform>
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter
                                Property="ContentTemplate"
                                Value="{StaticResource TargetStepTemplate}" />
                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsOperatingSystemStep}"
                                    Value="True">
                                    <Setter
                                        Property="ContentTemplate"
                                        Value="{StaticResource OperatingSystemCatalogStepTemplate}" />
                                </DataTrigger>
                                <DataTrigger
                                    Binding="{Binding IsDriversStep}"
                                    Value="True">
                                    <Setter
                                        Property="ContentTemplate"
                                        Value="{StaticResource DriverPackStepTemplate}" />
                                </DataTrigger>
                                <DataTrigger
                                    Binding="{Binding IsAutopilotStep}"
                                    Value="True">
                                    <Setter
                                        Property="ContentTemplate"
                                        Value="{StaticResource AutopilotStepTemplate}" />
                                </DataTrigger>
                                <DataTrigger
                                    Binding="{Binding IsSummaryStep}"
                                    Value="True">
                                    <Setter
                                        Property="ContentTemplate"
                                        Value="{StaticResource SummaryStepTemplate}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </ScrollViewer>
        </Border>

        <Grid x:Name="WizardFooter"
            Grid.Row="2"
            Grid.Column="2"
            Width="{Binding ActualWidth, ElementName=WizardContentCard}"
            MaxWidth="980"
            Margin="0,12,0,0"
            HorizontalAlignment="Center">
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    MinWidth="120"
                    Margin="0,0,8,0"
                    Command="{Binding PreviousWizardStepCommand}"
                    Content="{Binding Strings[Common.Previous]}" />
                <Button x:Name="NextButton"
                    MinWidth="140"
                    Command="{Binding NextWizardStepCommand}"
                    Content="{Binding Strings[Common.Next]}">
                    <Button.Style>
                        <Style
                            BasedOn="{StaticResource {x:Type Button}}"
                            TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsReturningToSummary}"
                                    Value="True">
                                    <Setter
                                        Property="Visibility"
                                        Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger
                                    Binding="{Binding IsSummaryStep}"
                                    Value="True">
                                    <Setter
                                        Property="Visibility"
                                        Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="ReturnToSummaryButton"
                    MinWidth="160"
                    Command="{Binding NextWizardStepCommand}"
                    Content="{Binding Strings[Wizard.ReturnToSummary]}">
                    <Button.Style>
                        <Style
                            BasedOn="{StaticResource AccentButtonStyle}"
                            TargetType="Button">
                            <Setter
                                Property="Visibility"
                                Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsReturningToSummary}"
                                    Value="True">
                                    <Setter
                                        Property="Visibility"
                                        Value="Visible" />
                                </DataTrigger>
                                <DataTrigger
                                    Binding="{Binding IsSummaryStep}"
                                    Value="True">
                                    <Setter
                                        Property="Visibility"
                                        Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="DeployButton"
                    MinWidth="160"
                    Command="{Binding StartDeploymentCommand}"
                    Content="{Binding Strings[Common.Deploy]}"
                    Style="{DynamicResource AccentButtonStyle}"
                    Visibility="{Binding IsSummaryStep, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
