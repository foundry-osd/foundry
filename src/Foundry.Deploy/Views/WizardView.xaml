<UserControl x:Class="Foundry.Deploy.Views.WizardView" x:Name="ViewRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wizardViews="clr-namespace:Foundry.Deploy.Views.Wizard"
    d:DesignHeight="720"
    d:DesignWidth="1100"
    mc:Ignorable="d">
    <UserControl.Resources>
        <DataTemplate x:Key="TargetStepTemplate">
            <wizardViews:TargetStepView />
        </DataTemplate>
        <DataTemplate x:Key="OperatingSystemCatalogStepTemplate">
            <wizardViews:OperatingSystemCatalogStepView />
        </DataTemplate>
        <DataTemplate x:Key="DriverPackStepTemplate">
            <wizardViews:DriverPackStepView />
        </DataTemplate>
        <DataTemplate x:Key="AutopilotStepTemplate">
            <wizardViews:AutopilotStepView />
        </DataTemplate>
        <DataTemplate x:Key="SummaryStepTemplate">
            <wizardViews:SummaryStepView />
        </DataTemplate>

        <DataTemplate x:Key="VerticalStepTemplate">
            <Button
                AutomationProperties.Name="{Binding Title}"
                Command="{Binding DataContext.NavigateToWizardStepCommand, ElementName=ViewRoot}"
                CommandParameter="{Binding}"
                IsEnabled="{Binding IsEnabled}"
                Style="{StaticResource WizardStepButtonStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="{DynamicResource SymbolThemeFontFamily}"
                        FontSize="16"
                        Text="{Binding Glyph}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter
                                    Property="Foreground"
                                    Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsCompleted}"
                                        Value="True">
                                        <Setter
                                            Property="Foreground"
                                            Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger
                                        Binding="{Binding IsCurrent}"
                                        Value="True">
                                        <Setter
                                            Property="Foreground"
                                            Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{Binding Title}"
                        TextWrapping="Wrap" />
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="CompactStepTemplate">
            <Button
                MinWidth="44"
                Margin="2"
                Padding="8"
                AutomationProperties.Name="{Binding Title}"
                Command="{Binding DataContext.NavigateToWizardStepCommand, ElementName=ViewRoot}"
                CommandParameter="{Binding}"
                IsEnabled="{Binding IsEnabled}"
                Style="{StaticResource WizardStepButtonStyle}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="{DynamicResource SymbolThemeFontFamily}"
                        FontSize="16"
                        Text="{Binding Glyph}" />
                    <TextBlock
                        MaxWidth="150"
                        Margin="4,4,4,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Text="{Binding Title}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="StepperColumn"
                Width="220" />
            <ColumnDefinition x:Name="StepperGapColumn"
                Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="CompactStepperRow"
                Height="0" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ItemsControl x:Name="VerticalStepper"
            Grid.Row="1"
            Grid.Column="0"
            AutomationProperties.Name="{Binding Strings[Wizard.StepperAutomationName]}"
            ItemTemplate="{StaticResource VerticalStepTemplate}"
            ItemsSource="{Binding WizardSteps}" />

        <ItemsControl x:Name="CompactStepper"
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="0,0,0,12"
            AutomationProperties.Name="{Binding Strings[Wizard.StepperAutomationName]}"
            ItemTemplate="{StaticResource CompactStepTemplate}"
            ItemsSource="{Binding WizardSteps}"
            Visibility="Collapsed">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <Border
            Grid.Row="1"
            Grid.Column="2"
            Style="{StaticResource WizardContentCardStyle}">
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ContentControl x:Name="StepContent"
                    Content="{Binding}">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="StepContentTransform" />
                    </ContentControl.RenderTransform>
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter
                                Property="ContentTemplate"
                                Value="{StaticResource TargetStepTemplate}" />
                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsOperatingSystemStep}"
                                    Value="True">
                                    <Setter
                                        Property="ContentTemplate"
                                        Value="{StaticResource OperatingSystemCatalogStepTemplate}" />
                                </DataTrigger>
                                <DataTrigger
                                    Binding="{Binding IsDriversStep}"
                                    Value="True">
                                    <Setter
                                        Property="ContentTemplate"
                                        Value="{StaticResource DriverPackStepTemplate}" />
                                </DataTrigger>
                                <DataTrigger
                                    Binding="{Binding IsAutopilotStep}"
                                    Value="True">
                                    <Setter
                                        Property="ContentTemplate"
                                        Value="{StaticResource AutopilotStepTemplate}" />
                                </DataTrigger>
                                <DataTrigger
                                    Binding="{Binding IsSummaryStep}"
                                    Value="True">
                                    <Setter
                                        Property="ContentTemplate"
                                        Value="{StaticResource SummaryStepTemplate}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </ScrollViewer>
        </Border>

        <Grid
            Grid.Row="2"
            Grid.Column="2"
            Margin="0,12,0,0">
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    MinWidth="120"
                    Margin="0,0,8,0"
                    Command="{Binding PreviousWizardStepCommand}"
                    Content="{Binding Strings[Common.Previous]}" />
                <Button
                    MinWidth="140"
                    Margin="0,0,8,0"
                    Command="{Binding NextWizardStepCommand}"
                    Content="{Binding NextButtonText}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsSummaryStep}"
                                    Value="True">
                                    <Setter
                                        Property="Visibility"
                                        Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button
                    MinWidth="160"
                    Command="{Binding StartDeploymentCommand}"
                    Content="{Binding Strings[Common.Deploy]}"
                    Style="{DynamicResource AccentButtonStyle}"
                    Visibility="{Binding IsSummaryStep, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
