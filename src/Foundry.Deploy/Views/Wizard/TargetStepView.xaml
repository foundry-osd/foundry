<UserControl x:Class="Foundry.Deploy.Views.Wizard.TargetStepView" x:Name="ViewRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Foundry.Deploy.Controls"
    xmlns:rules="clr-namespace:Foundry.Deploy.Validation">
    <StackPanel DataContext="{Binding Preparation}">
        <controls:WizardPageHeader x:Name="PageHeader"
            Title="{Binding DataContext.Strings[TargetDevice.Title], ElementName=ViewRoot}"
            Description="{Binding DataContext.Strings[TargetDevice.Description], ElementName=ViewRoot}"
            Glyph="&#xE772;" />

        <TextBlock x:Name="DeploymentSettingsTitle"
            Margin="0,0,0,12"
            Style="{StaticResource SubtitleTextBlockStyle}"
            Text="{Binding DataContext.Strings[TargetDevice.DeploymentSettings], ElementName=ViewRoot}" />
        <WrapPanel ItemWidth="340">
            <StackPanel Margin="0,0,24,16">
                <TextBlock
                    Margin="0,0,0,8"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{Binding DataContext.Strings[Preparation.ComputerName], ElementName=ViewRoot}" />
                <TextBox x:Name="TargetComputerNameTextBox"
                    AutomationProperties.Name="{Binding DataContext.Strings[Preparation.ComputerName], ElementName=ViewRoot}"
                    IsReadOnly="{Binding IsTargetComputerNameReadOnly}"
                    MaxLength="{x:Static rules:ComputerNameRules.MaxLength}"
                    PreviewTextInput="TargetComputerNameTextBox_PreviewTextInput"
                    Text="{Binding TargetComputerName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    Margin="0,4,0,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{Binding DataContext.Strings[Preparation.ComputerNameHint], ElementName=ViewRoot}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,4,0,0"
                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{Binding TargetComputerNameValidationMessage}"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasTargetComputerNameValidationError, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>

            <StackPanel Margin="0,0,0,16">
                <TextBlock
                    Margin="0,0,0,8"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{Binding DataContext.Strings[Preparation.TargetDisk], ElementName=ViewRoot}" />
                <ComboBox
                    AutomationProperties.Name="{Binding DataContext.Strings[Preparation.TargetDisk], ElementName=ViewRoot}"
                    DisplayMemberPath="DisplayLabel"
                    ItemsSource="{Binding TargetDisks}"
                    SelectedItem="{Binding SelectedTargetDisk}" />
                <TextBlock
                    Margin="0,4,0,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{Binding TargetDiskSelectionHint}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </WrapPanel>

        <Border x:Name="DiskEraseNotice"
            Margin="0,0,0,24"
            Padding="12"
            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
            BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                    Text="&#xE7BA;" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="{Binding DataContext.Strings[TargetDevice.DiskEraseNotice], ElementName=ViewRoot}"
                    TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Separator Margin="0,0,0,24" />
        <TextBlock x:Name="DeviceInventoryTitle"
            Margin="0,0,0,12"
            Style="{StaticResource SubtitleTextBlockStyle}"
            Text="{Binding DataContext.Strings[TargetDevice.DeviceInventory], ElementName=ViewRoot}" />
        <WrapPanel ItemWidth="220">
            <StackPanel Margin="0,0,24,16">
                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{Binding DataContext.Strings[TargetDevice.Device], ElementName=ViewRoot}" />
                <TextBlock
                    Margin="0,4,0,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding HardwareDeviceText}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Margin="0,0,24,16">
                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{Binding DataContext.Strings[TargetDevice.Architecture], ElementName=ViewRoot}" />
                <TextBlock
                    Margin="0,4,0,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding HardwareArchitectureText}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Margin="0,0,24,16">
                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{Binding DataContext.Strings[TargetDevice.Tpm], ElementName=ViewRoot}" />
                <TextBlock
                    Margin="0,4,0,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding HardwareTpmText}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Margin="0,0,24,16">
                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{Binding DataContext.Strings[TargetDevice.PowerSource], ElementName=ViewRoot}" />
                <TextBlock
                    Margin="0,4,0,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding HardwarePowerText}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Margin="0,0,24,16">
                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{Binding DataContext.Strings[TargetDevice.FirmwareStatus], ElementName=ViewRoot}" />
                <TextBlock
                    Margin="0,4,0,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding HardwareFirmwareText}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </WrapPanel>

        <Separator Margin="0,8,0,24" />
        <TextBlock
            Margin="0,0,0,12"
            Style="{StaticResource SubtitleTextBlockStyle}"
            Text="{Binding DataContext.Strings[TargetDevice.Firmware], ElementName=ViewRoot}" />
        <CheckBox
            AutomationProperties.Name="{Binding DataContext.Strings[Preparation.FirmwareUpdates], ElementName=ViewRoot}"
            IsChecked="{Binding ApplyFirmwareUpdates}"
            IsEnabled="{Binding IsFirmwareUpdatesOptionEnabled}">
            <TextBlock
                Text="{Binding DataContext.Strings[Preparation.FirmwareUpdates], ElementName=ViewRoot}"
                TextWrapping="Wrap" />
        </CheckBox>
        <TextBlock
            Margin="24,8,0,0"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{Binding DataContext.Strings[TargetDevice.FirmwareUnavailableVirtualMachine], ElementName=ViewRoot}">
            <TextBlock.Style>
                <Style
                    BasedOn="{StaticResource CaptionTextBlockStyle}"
                    TargetType="TextBlock">
                    <Setter
                        Property="Visibility"
                        Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger
                            Binding="{Binding IsFirmwareUpdatesOptionEnabled}"
                            Value="True">
                            <Setter
                                Property="Visibility"
                                Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
