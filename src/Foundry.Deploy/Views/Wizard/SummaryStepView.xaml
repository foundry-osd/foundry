<UserControl x:Class="Foundry.Deploy.Views.Wizard.SummaryStepView" x:Name="ViewRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Foundry.Deploy.Controls"
    xmlns:viewModels="clr-namespace:Foundry.Deploy.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:WizardPageHeader
            Title="{Binding Strings[Summary.Title]}"
            Description="{Binding Strings[Summary.Description]}"
            Glyph="&#xE9D5;" />
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            Style="{StaticResource ScrollViewerContentGutterStyle}"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding SummaryCategories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewModels:DeploymentSummaryCategoryViewModel}">
                        <Expander
                            Margin="0,0,0,8"
                            AutomationProperties.Name="{Binding Title}"
                            Focusable="{Binding CanExpand}"
                            IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                            <Expander.Header>
                                <Grid MinHeight="42">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                        FontSize="16"
                                        Text="{Binding Glyph}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter
                                                    Property="Foreground"
                                                    Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding Status}"
                                                        Value="{x:Static viewModels:DeploymentSummaryStatus.Configured}">
                                                        <Setter
                                                            Property="Foreground"
                                                            Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger
                                                        Binding="{Binding Status}"
                                                        Value="{x:Static viewModels:DeploymentSummaryStatus.Caution}">
                                                        <Setter
                                                            Property="Foreground"
                                                            Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{Binding Title}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Margin="16,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Summary}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Button
                                        Grid.Column="3"
                                        Margin="8,0,12,0"
                                        Padding="12,4"
                                        Command="{Binding DataContext.EditSummaryStepCommand, ElementName=ViewRoot}"
                                        CommandParameter="{Binding EditStepId}"
                                        Content="{Binding DataContext.Strings[Common.Edit], ElementName=ViewRoot}"
                                        Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <AutomationProperties.Name>
                                            <MultiBinding StringFormat="{}{0}: {1}">
                                                <Binding
                                                    ElementName="ViewRoot"
                                                    Path="DataContext.Strings[Common.Edit]" />
                                                <Binding Path="Title" />
                                            </MultiBinding>
                                        </AutomationProperties.Name>
                                    </Button>
                                </Grid>
                            </Expander.Header>
                            <ItemsControl
                                Margin="28,12,12,16"
                                ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:DeploymentSummaryRowViewModel}">
                                        <Grid>
                                            <Grid Margin="0,4">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter
                                                            Property="Visibility"
                                                            Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger
                                                                Binding="{Binding Kind}"
                                                                Value="{x:Static viewModels:DeploymentSummaryRowKind.Section}">
                                                                <Setter
                                                                    Property="Visibility"
                                                                    Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger
                                                                Binding="{Binding Kind}"
                                                                Value="{x:Static viewModels:DeploymentSummaryRowKind.Separator}">
                                                                <Setter
                                                                    Property="Visibility"
                                                                    Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding Label}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Text="{Binding Value}"
                                                    TextWrapping="Wrap" />
                                            </Grid>
                                            <TextBlock
                                                Margin="0,0,0,8"
                                                Text="{Binding Label}"
                                                TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style
                                                        BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                                                        TargetType="TextBlock">
                                                        <Setter
                                                            Property="Visibility"
                                                            Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger
                                                                Binding="{Binding Kind}"
                                                                Value="{x:Static viewModels:DeploymentSummaryRowKind.Section}">
                                                                <Setter
                                                                    Property="Visibility"
                                                                    Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Separator Margin="0,8,0,16">
                                                <Separator.Style>
                                                    <Style TargetType="Separator">
                                                        <Setter
                                                            Property="Visibility"
                                                            Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger
                                                                Binding="{Binding Kind}"
                                                                Value="{x:Static viewModels:DeploymentSummaryRowKind.Separator}">
                                                                <Setter
                                                                    Property="Visibility"
                                                                    Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Separator.Style>
                                            </Separator>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
