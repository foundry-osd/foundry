<UserControl x:Class="Foundry.Deploy.Views.Wizard.DomainJoinStepView" x:Name="ViewRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Foundry.Deploy.Controls">
    <Grid DataContext="{Binding DomainJoinStep}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:WizardPageHeader
            Title="{Binding DataContext.Strings[DomainJoin.Title], ElementName=ViewRoot}"
            Description="{Binding DataContext.Strings[DomainJoin.Description], ElementName=ViewRoot}"
            Glyph="&#xE774;" />

        <ScrollViewer x:Name="PageContentScrollViewer"
            Grid.Row="1"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            Style="{StaticResource ScrollViewerContentGutterStyle}"
            VerticalScrollBarVisibility="Auto">
            <Grid MinHeight="{Binding ActualHeight, ElementName=PageContentScrollViewer}">
                <StackPanel
                    MaxWidth="600"
                    Margin="0,0,0,32"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
                    <TextBlock
                        Margin="0,0,0,8"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{Binding DataContext.Strings[DomainJoin.Domain], ElementName=ViewRoot}" />
                    <ComboBox
                        AutomationProperties.Name="{Binding DataContext.Strings[DomainJoin.Domain], ElementName=ViewRoot}"
                        DisplayMemberPath="DomainName"
                        ItemsSource="{Binding Domains}"
                        SelectedItem="{Binding SelectedDomain}"
                        Visibility="{Binding IsDomainListVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBox x:Name="DomainInput"
                        AutomationProperties.Name="{Binding DataContext.Strings[DomainJoin.Domain], ElementName=ViewRoot}"
                        IsReadOnly="{Binding IsDomainReadOnly}"
                        MaxLength="253"
                        Text="{Binding DomainName, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{Binding IsDomainTextVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                        Text="{Binding DataContext.Strings[DomainJoin.DomainInvalid], ElementName=ViewRoot}"
                        TextWrapping="Wrap"
                        Visibility="{Binding IsDomainInvalid, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <StackPanel Visibility="{Binding RequiresCredentials, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            Margin="0,16,0,8"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{Binding DataContext.Strings[DomainJoin.Account], ElementName=ViewRoot}" />
                        <TextBox
                            AutomationProperties.Name="{Binding DataContext.Strings[DomainJoin.Account], ElementName=ViewRoot}"
                            MaxLength="512"
                            Text="{Binding AccountName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                            Text="{Binding DataContext.Strings[DomainJoin.AccountInvalid], ElementName=ViewRoot}"
                            TextWrapping="Wrap"
                            Visibility="{Binding IsAccountInvalid, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock
                            Margin="0,16,0,8"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{Binding DataContext.Strings[DomainJoin.Password], ElementName=ViewRoot}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="PasswordInput"
                                AutomationProperties.Name="{Binding DataContext.Strings[DomainJoin.Password], ElementName=ViewRoot}"
                                MaxLength="2560"
                                PasswordChanged="PasswordInput_OnPasswordChanged" />
                            <TextBox x:Name="PasswordRevealInput"
                                AutomationProperties.Name="{Binding DataContext.Strings[DomainJoin.Password], ElementName=ViewRoot}"
                                MaxLength="2560"
                                TextChanged="PasswordRevealInput_OnTextChanged"
                                Visibility="Collapsed" />
                            <Button x:Name="PasswordRevealButton"
                                Grid.Column="1"
                                MinWidth="40"
                                Margin="8,0,0,0"
                                Padding="10,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                AutomationProperties.Name="{Binding DataContext.Strings[DeploymentAccess.TogglePasswordVisibility], ElementName=ViewRoot}"
                                Click="PasswordRevealButton_OnClick"
                                ToolTip="{Binding DataContext.Strings[DeploymentAccess.TogglePasswordVisibility], ElementName=ViewRoot}">
                                <TextBlock
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    FontSize="14"
                                    Text="&#xF78D;" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsOuListVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            Margin="0,16,0,8"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{Binding DataContext.Strings[DomainJoin.Destination], ElementName=ViewRoot}" />
                        <ComboBox
                            AutomationProperties.Name="{Binding DataContext.Strings[DomainJoin.Destination], ElementName=ViewRoot}"
                            ItemsSource="{Binding OrganizationalUnits}"
                            SelectedItem="{Binding SelectedOrganizationalUnit}"
                            TextSearch.TextPath="DisplayName">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" />
                                        <TextBlock
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding DistinguishedName}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsTypedOuVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            Margin="0,16,0,8"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{Binding DataContext.Strings[DomainJoin.OptionalDestinationDn], ElementName=ViewRoot}" />
                        <TextBox
                            AutomationProperties.Name="{Binding DataContext.Strings[DomainJoin.OptionalDestinationDn], ElementName=ViewRoot}"
                            MaxLength="4096"
                            Text="{Binding TypedOuDistinguishedName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding DataContext.Strings[DomainJoin.OptionalDestinationHint], ElementName=ViewRoot}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                            Text="{Binding DataContext.Strings[DomainJoin.DestinationInvalid], ElementName=ViewRoot}"
                            TextWrapping="Wrap"
                            Visibility="{Binding IsTypedOuInvalid, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
