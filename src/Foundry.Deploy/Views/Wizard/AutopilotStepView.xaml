<UserControl x:Class="Foundry.Deploy.Views.Wizard.AutopilotStepView" x:Name="ViewRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Foundry.Deploy.Controls">
    <Grid DataContext="{Binding Preparation}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:WizardPageHeader x:Name="PageHeader"
            Title="{Binding DataContext.Strings[Autopilot.Title], ElementName=ViewRoot}"
            Description="{Binding DataContext.Strings[Autopilot.Description], ElementName=ViewRoot}"
            Glyph="&#xE753;" />

        <ScrollViewer x:Name="PageContentScrollViewer"
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            Style="{StaticResource ScrollViewerContentGutterStyle}"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <StackPanel Visibility="{Binding IsJsonProfileControlsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock
                        Margin="0,0,0,8"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{Binding DataContext.Strings[Preparation.AutopilotProfile], ElementName=ViewRoot}" />
                    <ComboBox
                        AutomationProperties.Name="{Binding DataContext.Strings[Preparation.AutopilotProfile], ElementName=ViewRoot}"
                        DisplayMemberPath="DisplayName"
                        IsEnabled="{Binding IsAutopilotProfileSelectionEnabled}"
                        ItemsSource="{Binding AutopilotProfiles}"
                        SelectedItem="{Binding SelectedAutopilotProfile}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                        Text="{Binding AutopilotProfileHint}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasAutopilotProfileHint, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsHardwareHashUploadControlsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{Binding DataContext.Strings[Preparation.AutopilotHardwareHashUploadStatus], ElementName=ViewRoot}" />
                    <TextBlock
                        Margin="0,8,0,16"
                        Text="{Binding AutopilotHardwareHashUploadStatusText}"
                        TextWrapping="Wrap" />
                    <StackPanel Visibility="{Binding IsHardwareHashGroupTagControlsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            Margin="0,0,0,8"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{Binding DataContext.Strings[Preparation.AutopilotHardwareHashGroupTagChoice], ElementName=ViewRoot}" />
                        <ComboBox
                            AutomationProperties.Name="{Binding DataContext.Strings[Preparation.AutopilotHardwareHashGroupTagChoice], ElementName=ViewRoot}"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding HardwareHashGroupTagOptions}"
                            SelectedItem="{Binding SelectedHardwareHashGroupTag}" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                        Text="{Binding AutopilotHardwareHashUploadMessage}"
                        TextWrapping="Wrap"
                        Visibility="{Binding IsHardwareHashUploadMessageVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <Border
                    Padding="12"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="6"
                    Visibility="{Binding IsInteractiveHardwareHashUploadStatusVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="&#xE946;" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="{Binding AutopilotInteractiveHardwareHashUploadStatusText}"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Expander
                    Margin="0,24,0,0"
                    AutomationProperties.Name="{Binding DataContext.Strings[Autopilot.ConfigurationDetails], ElementName=ViewRoot}"
                    Header="{Binding DataContext.Strings[Autopilot.ConfigurationDetails], ElementName=ViewRoot}"
                    IsExpanded="False"
                    Visibility="{Binding IsHardwareHashUploadControlsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding DataContext.Strings[Preparation.AutopilotHardwareHashTenantId], ElementName=ViewRoot}" />
                        <TextBlock
                            Grid.Column="2"
                            Text="{Binding AutopilotHardwareHashTenantIdText}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Row="1"
                            Margin="0,8,0,0"
                            FontWeight="SemiBold"
                            Text="{Binding DataContext.Strings[Preparation.AutopilotHardwareHashCertificateExpiration], ElementName=ViewRoot}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="2"
                            Margin="0,8,0,0"
                            Text="{Binding AutopilotHardwareHashCertificateExpirationText}"
                            TextWrapping="Wrap" />
                    </Grid>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
