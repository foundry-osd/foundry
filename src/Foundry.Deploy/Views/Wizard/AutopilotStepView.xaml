<UserControl x:Class="Foundry.Deploy.Views.Wizard.AutopilotStepView" x:Name="ViewRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Foundry.Deploy.Controls">
    <Grid DataContext="{Binding Preparation}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:WizardPageHeader x:Name="PageHeader"
            Title="{Binding DataContext.Strings[Autopilot.Title], ElementName=ViewRoot}"
            Description="{Binding DataContext.Strings[Autopilot.Description], ElementName=ViewRoot}"
            Glyph="&#xE753;" />

        <ScrollViewer x:Name="PageContentScrollViewer"
            Grid.Row="1"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            Style="{StaticResource ScrollViewerContentGutterStyle}"
            VerticalScrollBarVisibility="Auto">
            <Grid x:Name="AutopilotContentViewport"
                MinHeight="{Binding ActualHeight, ElementName=PageContentScrollViewer}">
                <StackPanel x:Name="AutopilotContent"
                    MaxWidth="600"
                    Margin="0,0,0,32"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter
                                Property="Visibility"
                                Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsJsonProfileControlsVisible}"
                                    Value="True">
                                    <Setter
                                        Property="Visibility"
                                        Value="Visible" />
                                </DataTrigger>
                                <DataTrigger
                                    Binding="{Binding IsHardwareHashUploadControlsVisible}"
                                    Value="True">
                                    <Setter
                                        Property="Visibility"
                                        Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Border
                        Padding="16"
                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                FontSize="24">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter
                                            Property="Text"
                                            Value="&#xE8A5;" />
                                        <Style.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsHardwareHashUploadControlsVisible}"
                                                Value="True">
                                                <Setter
                                                    Property="Text"
                                                    Value="&#xE753;" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Grid.Column="2">
                                <TextBlock
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    Text="{Binding AutopilotModeText}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{Binding DataContext.Strings[Autopilot.JsonProfileMethodDescription], ElementName=ViewRoot}"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding IsJsonProfileControlsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{Binding DataContext.Strings[Autopilot.HardwareHashUploadMethodDescription], ElementName=ViewRoot}"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding IsHardwareHashUploadControlsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel
                        Margin="0,24,0,0"
                        Visibility="{Binding IsJsonProfileControlsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            Margin="0,0,0,8"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{Binding DataContext.Strings[Preparation.AutopilotProfile], ElementName=ViewRoot}" />
                        <ComboBox
                            AutomationProperties.Name="{Binding DataContext.Strings[Preparation.AutopilotProfile], ElementName=ViewRoot}"
                            DisplayMemberPath="DisplayName"
                            IsEnabled="{Binding IsAutopilotProfileSelectionEnabled}"
                            ItemsSource="{Binding AutopilotProfiles}"
                            SelectedItem="{Binding SelectedAutopilotProfile}" />
                        <Border
                            Margin="0,12,0,0"
                            Padding="12"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="6"
                            Visibility="{Binding HasAutopilotProfileHint, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                    FontSize="16"
                                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                    Text="&#xE7BA;" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                    Text="{Binding AutopilotProfileHint}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel
                        Margin="0,24,0,0"
                        Visibility="{Binding IsHardwareHashUploadControlsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border
                            Padding="16,12"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="HardwareHashUploadStatusGlyph"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                    FontSize="16">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter
                                                Property="Foreground"
                                                Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                            <Setter
                                                Property="Text"
                                                Value="&#xE73E;" />
                                            <Style.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding IsHardwareHashUploadMessageVisible}"
                                                    Value="True">
                                                    <Setter
                                                        Property="Foreground"
                                                        Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                    <Setter
                                                        Property="Text"
                                                        Value="&#xE7BA;" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Grid.Column="2">
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{Binding AutopilotHardwareHashUploadStatusText}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                        Text="{Binding AutopilotHardwareHashUploadMessage}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding IsHardwareHashUploadMessageVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel
                            Margin="0,16,0,0"
                            Visibility="{Binding IsHardwareHashGroupTagControlsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock
                                Margin="0,0,0,8"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{Binding DataContext.Strings[Preparation.AutopilotHardwareHashGroupTagChoice], ElementName=ViewRoot}" />
                            <ComboBox
                                AutomationProperties.Name="{Binding DataContext.Strings[Preparation.AutopilotHardwareHashGroupTagChoice], ElementName=ViewRoot}"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding HardwareHashGroupTagOptions}"
                                SelectedItem="{Binding SelectedHardwareHashGroupTag}" />
                        </StackPanel>
                        <Expander
                            Margin="0,24,0,0"
                            AutomationProperties.Name="{Binding DataContext.Strings[Autopilot.ConfigurationDetails], ElementName=ViewRoot}"
                            Header="{Binding DataContext.Strings[Autopilot.ConfigurationDetails], ElementName=ViewRoot}"
                            IsExpanded="False">
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{Binding DataContext.Strings[Preparation.AutopilotHardwareHashTenantId], ElementName=ViewRoot}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding AutopilotHardwareHashTenantIdText}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Grid.Row="1"
                                    Margin="0,8,0,0"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{Binding DataContext.Strings[Preparation.AutopilotHardwareHashCertificateExpiration], ElementName=ViewRoot}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Margin="0,8,0,0"
                                    Text="{Binding AutopilotHardwareHashCertificateExpirationText}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Expander>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
