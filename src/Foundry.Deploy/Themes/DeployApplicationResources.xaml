<!--
    Foundry Deploy application resources. The Foundry.WinPE host merges them into Application.Resources after the Fluent
    dictionary (first, so ThemeService can swap it) and the shared Foundry.Wpf styles, which these styles build on.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Foundry.Deploy.Converters">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Foundry.Deploy;component/Themes/DeployStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <converters:OsCatalogFilterDisplayConverter x:Key="OsCatalogFilterDisplayConverter" />
</ResourceDictionary>
